<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Sf2.Remake.Engine.Tests</RootNamespace>
    <AssemblyName>Sf2.Remake.Engine.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sf2.Remake.Domain\Sf2.Remake.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sf2.Remake.Application\Sf2.Remake.Application.csproj" />
    <ProjectReference Include="..\..\src\Sf2.Remake.Content\Sf2.Remake.Content.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\content\authored\*.json" Link="authored\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\PrivateInputFactAttribute.cs" Link="PrivateInputFactAttribute.cs" />
    <Content Include="..\..\..\tests\fixtures\h2\map3-castle-battle-unlock-static-v1.json" Link="fixtures\castle-tower.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\reference\inputs\map*-start.json" Link="controlled\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\reference\inputs\map3-opening-party.json" Link="controlled\map3-opening-party.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\reference\inputs\battle01-actions.json" Link="controlled\battle01-actions.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\reference\inputs\battle01-player-ready.json" Link="controlled\battle01-player-ready.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\tests\fixtures\h3\entity-movement-matrix-v1.json" Link="fixtures\entity-motion.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\tests\fixtures\h3\map3-battle01-player-ready-v1.json" Link="fixtures\player-ready.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\tests\fixtures\h3\map3-admitted-start-v1.json" Link="fixtures\opening-r1.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\tests\fixtures\h3\map3-battle01-natural-route-v1.json" Link="fixtures\opening-r2.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\tests\fixtures\h3\map3-messenger-acceptance-v1.json" Link="fixtures\opening-r2a.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
