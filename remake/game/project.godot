; Engine configuration file.
; Public-synthetic Map 3 smoke only; no original assets are present.

config_version=5

[application]

config/name="SF2 Map 3 Public Synthetic Smoke"
run/main_scene="res://Main.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Sf2.Remake.Godot"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.055, 1)
