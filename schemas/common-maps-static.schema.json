{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shining Force II common maps static inventory",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "scope", "summary", "indexedRecordIds", "indexedSourcePaths", "internalDirectCallTargets", "externalDirectCallTargets", "mapFacts", "files"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "sf2-common-maps-static-v1" },
    "upstream": { "type": "object" }, "scope": { "const": "code/common/maps" },
    "summary": { "type": "object", "required": ["fileCount", "sourceLineCount", "statementCount", "globalLabelCount", "localLabelCount", "directCallSiteCount", "indirectCallSiteCount", "uniqueDirectTargetCount", "internalDirectTargetCount", "externalDirectTargetCount", "indexedRecordCount", "indexedFileCount"], "properties": { "fileCount": { "const": 7 }, "indexedRecordCount": { "const": 7 }, "indexedFileCount": { "const": 7 } } },
    "indexedRecordIds": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true },
    "indexedSourcePaths": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true },
    "internalDirectCallTargets": { "type": "array", "uniqueItems": true },
    "externalDirectCallTargets": { "type": "array", "uniqueItems": true },
    "mapFacts": { "type": "object", "minProperties": 6, "maxProperties": 6 },
    "files": { "type": "array", "minItems": 7, "maxItems": 7 }
  }
}
