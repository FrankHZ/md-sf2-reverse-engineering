{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/h3-stat-gain-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "function", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "core"],
      "properties": { "name": { "const": "BizHawk" }, "version": { "type": "string" }, "core": { "const": "Genesis Plus GX" } }
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["entryAddress", "noneReturnAddress", "growthReturnAddress", "pityAddress", "rngEntryAddress", "rngObserveAddress", "seedAddress"],
      "properties": {
        "entryAddress": { "type": "integer", "minimum": 0 }, "noneReturnAddress": { "type": "integer", "minimum": 0 },
        "growthReturnAddress": { "type": "integer", "minimum": 0 }, "pityAddress": { "type": "integer", "minimum": 0 },
        "rngEntryAddress": { "type": "integer", "minimum": 0 }, "rngObserveAddress": { "type": "integer", "minimum": 0 },
        "seedAddress": { "type": "integer", "minimum": 0 }
      }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false, "required": ["current", "curve", "start", "projected", "level"],
      "properties": {
        "current": { "type": "integer", "minimum": 0, "maximum": 65535 }, "curve": { "type": "integer", "minimum": 0, "maximum": 255 },
        "start": { "type": "integer", "minimum": 0, "maximum": 65535 }, "projected": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "level": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "rng": {
      "type": "object", "additionalProperties": false, "required": ["seed", "expectedSeed", "expectedValue"],
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 65535 }, "expectedSeed": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "expectedValue": { "type": "integer", "minimum": 0, "maximum": 127 }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "input", "rng", "expectedPath", "expectedPity", "expectedGain"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "input": { "$ref": "#/$defs/input" },
        "rng": { "type": "array", "minItems": 0, "maxItems": 2, "items": { "$ref": "#/$defs/rng" } },
        "expectedPath": { "enum": ["none", "growth"] }, "expectedPity": { "type": "boolean" },
        "expectedGain": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    }
  }
}
