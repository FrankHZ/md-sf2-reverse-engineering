{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shining Force II battle-loop static source inventory",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "scope", "summary", "indexedRecordIds", "indexedSourcePaths", "internalDirectCallTargets", "externalDirectCallTargets", "lifecycleFacts", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-battle-loop-static-v1" },
    "upstream": { "type": "object" },
    "scope": { "const": "code/gameflow/battle/battleloop" },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["fileCount", "sourceLineCount", "statementCount", "globalLabelCount", "localLabelCount", "directCallSiteCount", "indirectCallSiteCount", "uniqueDirectTargetCount", "internalDirectTargetCount", "externalDirectTargetCount", "indexedRecordCount", "indexedFileCount"],
      "properties": {
        "fileCount": { "const": 18 },
        "sourceLineCount": { "type": "integer", "minimum": 1 },
        "statementCount": { "type": "integer", "minimum": 1 },
        "globalLabelCount": { "type": "integer", "minimum": 18 },
        "localLabelCount": { "type": "integer", "minimum": 0 },
        "directCallSiteCount": { "type": "integer", "minimum": 1 },
        "indirectCallSiteCount": { "type": "integer", "minimum": 0 },
        "uniqueDirectTargetCount": { "type": "integer", "minimum": 1 },
        "internalDirectTargetCount": { "type": "integer", "minimum": 0 },
        "externalDirectTargetCount": { "type": "integer", "minimum": 0 },
        "indexedRecordCount": { "const": 18 },
        "indexedFileCount": { "const": 18 }
      }
    },
    "indexedRecordIds": { "type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": { "type": "string" } },
    "indexedSourcePaths": { "type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": { "type": "string" } },
    "internalDirectCallTargets": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "externalDirectCallTargets": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "lifecycleFacts": { "type": "object", "minProperties": 8, "maxProperties": 8 },
    "files": {
      "type": "array", "minItems": 18, "maxItems": 18,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "sourceLineCount", "statementCount", "globalLabels", "localLabelCount", "directCalls", "indirectCallSiteCount"],
        "properties": {
          "path": { "type": "string" }, "sha256": { "pattern": "^[0-9A-F]{64}$" },
          "sourceLineCount": { "type": "integer" }, "statementCount": { "type": "integer" },
          "globalLabels": { "type": "array", "items": { "type": "string" } },
          "localLabelCount": { "type": "integer" }, "directCalls": { "type": "array" },
          "indirectCallSiteCount": { "type": "integer" }
        }
      }
    }
  }
}
