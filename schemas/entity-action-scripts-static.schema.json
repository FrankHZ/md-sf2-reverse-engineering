{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/entity-action-scripts-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "table", "summary", "romRanges", "commandCounts", "referenceFacts", "corpora", "entryReferences", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-entity-action-scripts-static-v1" },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "table": { "type": "object", "minProperties": 3, "maxProperties": 3, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "summary": { "type": "object", "minProperties": 16, "maxProperties": 16, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "romRanges": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "minProperties": 5, "maxProperties": 5 } },
    "commandCounts": { "type": "object", "minProperties": 34, "maxProperties": 34, "additionalProperties": { "type": "integer", "minimum": 1 } },
    "referenceFacts": { "type": "object", "minProperties": 3, "maxProperties": 3 },
    "corpora": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/corpus" } },
    "entryReferences": { "type": "array", "minItems": 61, "maxItems": 61, "items": { "$ref": "#/$defs/entryReference" } },
    "runtimeQuestions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
  },
  "$defs": {
    "label": {
      "type": "object", "additionalProperties": false, "required": ["name", "address", "line"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["line", "ownerLabel", "macro", "arguments", "opcode", "encodedBytes"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "ownerLabel": { "type": "string" },
        "macro": { "type": "string", "pattern": "^ac_" },
        "arguments": { "type": "string" },
        "opcode": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "encodedBytes": { "type": "integer", "minimum": 2 }
      }
    },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourcePath", "start", "endExclusive", "sha256", "summary", "commandCounts", "controlFlow", "labels", "commands"],
      "properties": {
        "id": { "type": "string" },
        "sourcePath": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "endExclusive": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "summary": { "type": "object", "minProperties": 10, "maxProperties": 10 },
        "commandCounts": { "type": "object" },
        "controlFlow": { "type": "object", "minProperties": 2, "maxProperties": 2 },
        "labels": { "type": "array", "items": { "$ref": "#/$defs/label" } },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    },
    "entryReference": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "ownerPath", "internalReferenceCount", "externalReferenceCount", "externalSourceFileCount", "externalReferences"],
      "properties": {
        "label": { "type": "string", "pattern": "^eas_" },
        "ownerPath": { "type": "string" },
        "internalReferenceCount": { "type": "integer", "minimum": 0 },
        "externalReferenceCount": { "type": "integer", "minimum": 0 },
        "externalSourceFileCount": { "type": "integer", "minimum": 0 },
        "externalReferences": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "line"],
            "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    }
  }
}
