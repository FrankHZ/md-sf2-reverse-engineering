{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/entity-action-scripts-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "upstream", "romSha256", "function", "table", "summary", "romRanges",
    "commandCounts", "referenceFacts", "distributedSummary",
    "distributedSourceFileCounts", "distributedCommandCounts", "distributedControlFlowFacts",
    "distributedReferenceFacts", "handlerSummary", "handlerFacts", "standaloneRomRanges",
    "corpora", "entryReferences",
    "distributedFiles", "inlinePrograms", "standalonePrograms", "distributedEntryReferences",
    "handlerDispatchTable", "handlerMacroBindings", "handlerOpcodeBindings", "handlers",
    "runtimeQuestions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-entity-action-scripts-static-v1" },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["rjt_EntityScriptCommands"],
      "properties": {
        "rjt_EntityScriptCommands": { "type": "integer", "minimum": 0 }
      }
    },
    "table": {
      "type": "object", "minProperties": 20, "maxProperties": 20,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "summary": {
      "type": "object", "minProperties": 16, "maxProperties": 16,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "romRanges": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/romRange" }
    },
    "commandCounts": {
      "type": "object", "minProperties": 34, "maxProperties": 34,
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "referenceFacts": { "type": "object", "minProperties": 3, "maxProperties": 3 },
    "distributedSummary": {
      "type": "object", "minProperties": 19, "maxProperties": 19,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "distributedSourceFileCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["battles", "code", "maps", "scripting-data"],
      "properties": {
        "battles": { "type": "integer", "minimum": 0 },
        "code": { "type": "integer", "minimum": 0 },
        "maps": { "type": "integer", "minimum": 0 },
        "scripting-data": { "type": "integer", "minimum": 0 }
      }
    },
    "distributedCommandCounts": {
      "type": "object", "minProperties": 34, "maxProperties": 34,
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "distributedControlFlowFacts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "absoluteJumpTargets", "relativeBranchTargets", "unresolvedTargets",
        "allTargetsResolved", "allInlineProgramsTerminateWithAcEnd"
      ],
      "properties": {
        "absoluteJumpTargets": {
          "type": "object", "minProperties": 1, "maxProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "relativeBranchTargets": {
          "type": "object", "minProperties": 5, "maxProperties": 5,
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "unresolvedTargets": { "type": "array", "maxItems": 0 },
        "allTargetsResolved": { "const": true },
        "allInlineProgramsTerminateWithAcEnd": { "const": true }
      }
    },
    "distributedReferenceFacts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "unreferencedEntryLabels", "referencedEntryCount", "referenceCount",
        "crossFileReferenceCount", "referenceSourceFileCount", "referenceScope"
      ],
      "properties": {
        "unreferencedEntryLabels": { "type": "array", "maxItems": 0 },
        "referencedEntryCount": { "type": "integer", "minimum": 0 },
        "referenceCount": { "type": "integer", "minimum": 0 },
        "crossFileReferenceCount": { "type": "integer", "minimum": 0 },
        "referenceSourceFileCount": { "type": "integer", "minimum": 0 },
        "referenceScope": { "type": "string" }
      }
    },
    "handlerSummary": {
      "type": "object", "minProperties": 25, "maxProperties": 25,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "handlerFacts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "fillerTarget", "fillerIndices", "handlerOnlyOpcodes", "inlineTerminatorMacro",
        "inlineTerminatorWord", "unusedRuntimeMacros", "allRuntimeMacrosMapToHandlers",
        "allNonfillerHandlersOwned", "allHandlerAccessesClassified", "allHandlersGrouped",
        "allHandlerFlowActionsClassified", "allDeclaredParameterBytesAccounted",
        "partiallyConsumedMacros", "handlerFamilyCounts"
      ],
      "properties": {
        "fillerTarget": { "const": "esc_goToNextEntity" },
        "fillerIndices": {
          "type": "array", "minItems": 37, "maxItems": 37,
          "items": { "type": "integer", "minimum": 0, "maximum": 79 }
        },
        "handlerOnlyOpcodes": {
          "type": "object", "minProperties": 3, "maxProperties": 3,
          "additionalProperties": { "type": "string", "pattern": "^esc" }
        },
        "inlineTerminatorMacro": { "const": "ac_end" },
        "inlineTerminatorWord": { "const": 32896 },
        "unusedRuntimeMacros": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": { "type": "string", "pattern": "^ac_" }
        },
        "allRuntimeMacrosMapToHandlers": { "const": true },
        "allNonfillerHandlersOwned": { "const": true },
        "allHandlerAccessesClassified": { "const": true },
        "allHandlersGrouped": { "const": true },
        "allHandlerFlowActionsClassified": { "const": true },
        "allDeclaredParameterBytesAccounted": { "const": true },
        "partiallyConsumedMacros": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "string", "pattern": "^ac_" }
        },
        "handlerFamilyCounts": {
          "type": "object", "minProperties": 8, "maxProperties": 8,
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "standaloneRomRanges": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": { "$ref": "#/$defs/romRange" }
    },
    "corpora": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/corpus" }
    },
    "entryReferences": {
      "type": "array", "minItems": 61, "maxItems": 61,
      "items": { "$ref": "#/$defs/entryReference" }
    },
    "distributedFiles": {
      "type": "array", "minItems": 75, "maxItems": 75,
      "items": { "$ref": "#/$defs/distributedFile" }
    },
    "inlinePrograms": {
      "type": "array", "minItems": 361, "maxItems": 361,
      "items": { "$ref": "#/$defs/inlineProgram" }
    },
    "standalonePrograms": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": { "$ref": "#/$defs/standaloneProgram" }
    },
    "distributedEntryReferences": {
      "type": "array", "minItems": 17, "maxItems": 17,
      "items": { "$ref": "#/$defs/entryReference" }
    },
    "handlerDispatchTable": {
      "type": "array", "minItems": 80, "maxItems": 80,
      "items": { "type": "string", "pattern": "^esc" }
    },
    "handlerMacroBindings": {
      "type": "array", "minItems": 44, "maxItems": 44,
      "items": { "$ref": "#/$defs/handlerMacroBinding" }
    },
    "handlerOpcodeBindings": {
      "type": "array", "minItems": 40, "maxItems": 40,
      "items": { "$ref": "#/$defs/handlerOpcodeBinding" }
    },
    "handlers": {
      "type": "array", "minItems": 43, "maxItems": 43,
      "items": { "$ref": "#/$defs/handler" }
    },
    "runtimeQuestions": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "label": {
      "type": "object", "additionalProperties": false, "required": ["name", "address", "line"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["line", "ownerLabel", "macro", "arguments", "opcode", "encodedBytes"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "ownerLabel": { "type": "string" },
        "macro": { "type": "string", "pattern": "^ac_" },
        "arguments": { "type": "string" },
        "opcode": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "encodedBytes": { "type": "integer", "minimum": 2 }
      }
    },
    "romRange": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourcePath", "start", "endExclusive", "sha256"],
      "properties": {
        "id": { "type": "string" },
        "sourcePath": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "endExclusive": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "controlFlow": {
      "type": "object", "additionalProperties": false,
      "required": ["relativeBranchTargets", "absoluteJumpTargets"],
      "properties": {
        "relativeBranchTargets": { "type": "array", "items": { "type": "string" } },
        "absoluteJumpTargets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "sourcePath", "start", "endExclusive", "sha256", "summary", "commandCounts",
        "controlFlow", "labels", "commands"
      ],
      "properties": {
        "id": { "type": "string" },
        "sourcePath": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "endExclusive": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "summary": { "type": "object", "minProperties": 10, "maxProperties": 10 },
        "commandCounts": { "type": "object" },
        "controlFlow": { "$ref": "#/$defs/controlFlow" },
        "labels": { "type": "array", "items": { "$ref": "#/$defs/label" } },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    },
    "distributedFile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sourcePath", "area", "commandCount", "inlineProgramCount", "standaloneProgramCount",
        "namedEntryLabelCount", "sha256"
      ],
      "properties": {
        "sourcePath": { "type": "string" },
        "area": { "enum": ["maps", "battles", "scripting-data", "code"] },
        "commandCount": { "type": "integer", "minimum": 1 },
        "inlineProgramCount": { "type": "integer", "minimum": 0 },
        "standaloneProgramCount": { "type": "integer", "minimum": 0 },
        "namedEntryLabelCount": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "inlineProgram": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "sourcePath", "startLine", "endLine", "wrapper", "waitForCompletion",
        "entityExpression", "summary", "commandCounts", "controlFlow", "commands"
      ],
      "properties": {
        "id": { "type": "string" },
        "sourcePath": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "wrapper": { "enum": ["customActscript", "customActscriptWait"] },
        "waitForCompletion": { "type": "boolean" },
        "entityExpression": { "type": "string", "minLength": 1 },
        "summary": { "type": "object", "minProperties": 5, "maxProperties": 5 },
        "commandCounts": { "type": "object" },
        "controlFlow": { "$ref": "#/$defs/controlFlow" },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/command" } }
      }
    },
    "standaloneProgram": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "sourcePath", "startLine", "endLine", "start", "endExclusive", "sha256",
        "summary", "commandCounts", "controlFlow", "labels", "commands"
      ],
      "properties": {
        "id": { "type": "string" },
        "sourcePath": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "endExclusive": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "summary": { "type": "object", "minProperties": 8, "maxProperties": 8 },
        "commandCounts": { "type": "object" },
        "controlFlow": { "$ref": "#/$defs/controlFlow" },
        "labels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/label" } },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/command" } }
      }
    },
    "handlerMacroBinding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "macro", "opcode", "encodedBytes", "parameterBytes", "handler",
        "declaredParameters", "allDeclaredParameterBytesRead", "isInlineTerminator",
        "sourceCommandCount"
      ],
      "properties": {
        "macro": { "type": "string", "pattern": "^ac_" },
        "opcode": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "encodedBytes": { "type": "integer", "minimum": 2 },
        "parameterBytes": { "type": "integer", "minimum": 0 },
        "declaredParameters": {
          "type": "array", "items": { "$ref": "#/$defs/declaredParameter" }
        },
        "allDeclaredParameterBytesRead": { "type": "boolean" },
        "handler": { "type": ["string", "null"] },
        "isInlineTerminator": { "type": "boolean" },
        "sourceCommandCount": { "type": "integer", "minimum": 0 }
      }
    },
    "handlerOpcodeBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["opcode", "handler", "encodedBytes", "macros", "sourceCommandCount"],
      "properties": {
        "opcode": { "type": "integer", "minimum": 0, "maximum": 79 },
        "handler": { "type": "string", "pattern": "^esc" },
        "encodedBytes": { "type": "integer", "minimum": 2 },
        "macros": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "pattern": "^ac_" }
        },
        "sourceCommandCount": { "type": "integer", "minimum": 0 }
      }
    },
    "declaredParameter": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ordinal", "offset", "widthBytes", "expression", "role", "readOffsets",
        "ignoredOffsets"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 2 },
        "widthBytes": { "enum": [1, 2, 4] },
        "expression": { "type": "string" },
        "role": { "type": "string" },
        "readOffsets": {
          "type": "array", "items": { "type": "integer", "minimum": 2 }
        },
        "ignoredOffsets": {
          "type": "array", "items": { "type": "integer", "minimum": 2 }
        }
      }
    },
    "handler": {
      "type": "object", "additionalProperties": false,
      "required": [
        "name", "opcode", "family", "address", "sourcePath", "startLine", "endLine",
        "statementCount",
        "entityFields", "entityFieldAccesses", "globalState", "globalStateAccesses",
        "scriptParameterOffsets", "scriptReads", "bitAccesses", "scriptPointerActions",
        "directCalls", "exitRoutes"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^esc" },
        "opcode": { "type": "integer", "minimum": 0, "maximum": 79 },
        "family": {
          "enum": [
            "audio", "control-flow", "direct-control", "entity-property", "map-effect",
            "motion-state", "movement", "wait"
          ]
        },
        "address": { "type": "integer", "minimum": 0 },
        "sourcePath": { "const": "code/common/scripting/entity/entityscriptengine_2.asm" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "statementCount": { "type": "integer", "minimum": 1 },
        "entityFields": { "type": "array", "items": { "type": "string" } },
        "entityFieldAccesses": {
          "type": "array", "items": { "$ref": "#/$defs/access" }
        },
        "globalState": { "type": "array", "items": { "type": "string" } },
        "globalStateAccesses": {
          "type": "array", "items": { "$ref": "#/$defs/access" }
        },
        "scriptParameterOffsets": {
          "type": "array", "items": { "type": "integer", "minimum": 0 }
        },
        "scriptReads": {
          "type": "array", "items": { "$ref": "#/$defs/scriptRead" }
        },
        "bitAccesses": {
          "type": "array", "items": { "$ref": "#/$defs/bitAccess" }
        },
        "scriptPointerActions": {
          "type": "array", "items": { "$ref": "#/$defs/scriptPointerAction" }
        },
        "directCalls": { "type": "array", "items": { "type": "string" } },
        "exitRoutes": { "type": "array", "items": { "type": "string", "pattern": "^esc_" } }
      }
    },
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "read", "write", "addressed", "operations"],
      "properties": {
        "name": { "type": "string" },
        "read": { "type": "boolean" },
        "write": { "type": "boolean" },
        "addressed": { "type": "boolean" },
        "operations": {
          "type": "array", "minItems": 1, "items": { "type": "string" }
        }
      }
    },
    "scriptRead": {
      "type": "object", "additionalProperties": false,
      "required": ["offset", "widthBytes", "operations"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "widthBytes": { "enum": [1, 2, 4] },
        "operations": {
          "type": "array", "minItems": 1, "items": { "type": "string" }
        }
      }
    },
    "bitAccess": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "bit", "tested", "set", "cleared", "toggled"],
      "properties": {
        "field": { "type": "string", "pattern": "^ENTITYDEF_OFFSET_" },
        "bit": { "type": "string" },
        "tested": { "type": "boolean" },
        "set": { "type": "boolean" },
        "cleared": { "type": "boolean" },
        "toggled": { "type": "boolean" }
      }
    },
    "scriptPointerAction": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "bytes"],
          "properties": {
            "kind": { "const": "advance" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "parameterOffset", "widthBytes"],
          "properties": {
            "kind": { "enum": ["relative-branch", "absolute-jump"] },
            "parameterOffset": { "type": "integer", "minimum": 0 },
            "widthBytes": { "enum": [2, 4] }
          }
        }
      ]
    },
    "entryReference": {
      "type": "object", "additionalProperties": false,
      "required": [
        "label", "ownerPath", "internalReferenceCount", "externalReferenceCount",
        "externalSourceFileCount", "externalReferences"
      ],
      "properties": {
        "label": { "type": "string", "pattern": "^eas_" },
        "ownerPath": { "type": "string" },
        "internalReferenceCount": { "type": "integer", "minimum": 0 },
        "externalReferenceCount": { "type": "integer", "minimum": 0 },
        "externalSourceFileCount": { "type": "integer", "minimum": 0 },
        "externalReferences": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "line"],
            "properties": {
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
