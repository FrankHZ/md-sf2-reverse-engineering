{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/entity-action-scripts-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "table", "summary", "romRange", "commandCounts", "controlFlowFacts", "labels", "commands", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-entity-action-scripts-static-v1" },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "table": { "type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "summary": { "type": "object", "minProperties": 14, "maxProperties": 14, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "romRange": { "type": "object", "minProperties": 4, "maxProperties": 4 },
    "commandCounts": { "type": "object", "minProperties": 28, "maxProperties": 28, "additionalProperties": { "type": "integer", "minimum": 1 } },
    "controlFlowFacts": { "type": "object", "minProperties": 4, "maxProperties": 4 },
    "labels": { "type": "array", "minItems": 49, "maxItems": 49, "items": { "$ref": "#/$defs/label" } },
    "commands": { "type": "array", "minItems": 444, "maxItems": 444, "items": { "$ref": "#/$defs/command" } },
    "runtimeQuestions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
  },
  "$defs": {
    "label": {
      "type": "object", "additionalProperties": false, "required": ["name", "address", "line"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["line", "ownerLabel", "macro", "arguments", "opcode", "encodedBytes"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "ownerLabel": { "type": "string" },
        "macro": { "type": "string", "pattern": "^ac_" },
        "arguments": { "type": "string" },
        "opcode": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "encodedBytes": { "type": "integer", "minimum": 2 }
      }
    }
  }
}
