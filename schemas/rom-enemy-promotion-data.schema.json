{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/rom-enemy-promotion-data.schema.json",
  "title": "Shining Force II promotion and enemy ROM-byte extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provenance", "layoutId", "promotions", "enemyNames", "enemyDefinitions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["romManifestId", "romSha256"],
      "properties": {
        "romManifestId": { "const": "sf2-us-retail" },
        "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "layoutId": { "const": "sf2-us-enemy-promotion-layout-v1" },
    "promotions": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/promotionSection" } },
    "enemyNames": { "type": "array", "minItems": 103, "maxItems": 103, "items": { "$ref": "#/$defs/enemyName" } },
    "enemyDefinitions": { "type": "array", "minItems": 103, "maxItems": 103, "items": { "$ref": "#/$defs/enemyDefinition" } }
  },
  "$defs": {
    "promotionSection": {
      "type": "object", "additionalProperties": false, "required": ["id", "offset", "count", "values"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 4 }, "offset": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1, "maximum": 12 },
        "values": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    },
    "enemyName": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "offset", "encodedLength", "payloadHex", "displayName", "trailingNull"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 102 }, "offset": { "type": "integer", "minimum": 0 },
        "encodedLength": { "type": "integer", "minimum": 1, "maximum": 255 },
        "payloadHex": { "type": "string", "pattern": "^[0-9A-F]+$" }, "displayName": { "type": "string", "minLength": 1 },
        "trailingNull": { "type": "boolean" }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false, "required": ["raw", "itemId", "equipped"],
      "properties": {
        "raw": { "type": "integer", "minimum": 0, "maximum": 65535 }, "itemId": { "type": "integer", "minimum": 0, "maximum": 127 },
        "equipped": { "type": "boolean" }
      }
    },
    "spell": {
      "type": "object", "additionalProperties": false, "required": ["raw", "spellId", "level"],
      "properties": {
        "raw": { "type": "integer", "minimum": 0, "maximum": 255 }, "spellId": { "type": "integer", "minimum": 0, "maximum": 63 },
        "level": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "decodedEnemy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "unknownByte", "spellPower", "level", "maxHp", "maxMp", "baseAttack", "baseDefense", "baseAgility",
        "baseMovement", "resistance", "prowess", "items", "spells", "initialStatus", "movementTypeRaw",
        "movementType", "aiBitfield", "reservedBytesZero"
      ],
      "properties": {
        "unknownByte": { "type": "integer", "minimum": 0, "maximum": 255 }, "spellPower": { "type": "integer", "minimum": 0, "maximum": 255 },
        "level": { "type": "integer", "minimum": 0, "maximum": 255 }, "maxHp": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "maxMp": { "type": "integer", "minimum": 0, "maximum": 255 }, "baseAttack": { "type": "integer", "minimum": 0, "maximum": 255 },
        "baseDefense": { "type": "integer", "minimum": 0, "maximum": 255 }, "baseAgility": { "type": "integer", "minimum": 0, "maximum": 255 },
        "baseMovement": { "type": "integer", "minimum": 0, "maximum": 255 }, "resistance": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "prowess": { "type": "integer", "minimum": 0, "maximum": 255 },
        "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/item" } },
        "spells": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/spell" } },
        "initialStatus": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "movementTypeRaw": { "type": "integer", "minimum": 0, "maximum": 255 }, "movementType": { "type": "integer", "minimum": 0, "maximum": 15 },
        "aiBitfield": { "type": "integer", "minimum": 0, "maximum": 65535 }, "reservedBytesZero": { "const": true }
      }
    },
    "enemyDefinition": {
      "type": "object", "additionalProperties": false, "required": ["id", "offset", "rawHex", "decoded"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 102 }, "offset": { "type": "integer", "minimum": 0 },
        "rawHex": { "type": "string", "pattern": "^[0-9A-F]{112}$" }, "decoded": { "$ref": "#/$defs/decodedEnemy" }
      }
    }
  }
}
