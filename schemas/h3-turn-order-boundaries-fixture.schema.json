{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/h3-turn-order-boundaries-fixture.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "function", "battleId", "scenario", "seed", "mutations", "expectedEntries"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "sf2-turn-order-boundaries-v1" },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "core"],
      "properties": { "name": { "const": "BizHawk" }, "version": { "const": "2.11.1" }, "core": { "const": "Genesis Plus GX" } }
    },
    "function": {
      "type": "object", "additionalProperties": false, "required": ["entryAddress", "observeAddress", "seedAddress", "turnOrderAddress"],
      "properties": {
        "entryAddress": { "const": 152900 }, "observeAddress": { "const": 152990 },
        "seedAddress": { "const": 16768676 }, "turnOrderAddress": { "const": 16774938 }
      }
    },
    "battleId": { "const": 1 }, "scenario": { "const": "boundaries" }, "seed": { "const": 0 },
    "mutations": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["combatant", "field", "value"],
        "properties": {
          "combatant": { "enum": [0, 1, 2, 128] }, "field": { "enum": ["currentAgi", "currentHp", "x"] },
          "value": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "expectedEntries": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["combatant", "score"],
        "properties": { "combatant": { "type": "integer", "minimum": 0, "maximum": 255 }, "score": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    }
  }
}
