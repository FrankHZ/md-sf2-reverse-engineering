{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SF2 Z80 music-bank static fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "upstreamCommit", "table", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-sound-data-static-v1" },
    "romSha256": {
      "const": "9ADF662D09881F58EC37D174AB01E87A7FCFB24700B5F84B26C0CD4F351509E9"
    },
    "upstreamCommit": { "const": "c834c652b6862bc5679fd7f69a38a7093206efc6" },
    "table": {
      "type": "object", "additionalProperties": false, "required": ["songRomOffsets"],
      "properties": {
        "songRomOffsets": {
          "type": "object", "minProperties": 37, "maxProperties": 37,
          "patternProperties": { "^music[0-9]{2}$": { "type": "integer", "minimum": 2031616, "maximum": 2097151 } },
          "additionalProperties": false
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "commandModel", "strictIndexExclusion", "runtimeQuestions"],
      "properties": {
        "facts": { "type": "object" },
        "commandModel": { "type": "object", "required": ["summary", "unusedMacros", "invocationCounts", "channelRoles", "driver", "bankSelection"] },
        "strictIndexExclusion": { "type": "string", "minLength": 1 },
        "runtimeQuestions": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true
        }
      }
    }
  }
}
