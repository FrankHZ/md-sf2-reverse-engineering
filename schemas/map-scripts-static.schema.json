    "standaloneOwnedInitScriptTargets": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true },
    "runtimeQuestions": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true },
    "files": { "type": "array", "minItems": 47, "maxItems": 47 },
    "labelAddresses": { "type": "object", "minProperties": 178, "maxProperties": 178 },
    "references": { "type": "array", "minItems": 178, "maxItems": 178 },
    "programs": {
      "type": "array", "minItems": 178, "maxItems": 178,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "address", "path", "kind", "operations"],
        "properties": {
          "id": { "type": "string" },
          "address": { "type": "integer", "minimum": 0 },
          "path": { "type": "string" },
          "kind": { "type": "string" },
