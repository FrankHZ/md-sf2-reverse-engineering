    "upstream": { "type": "object" },
    "scope": { "type": "string" },
    "summary": { "type": "object", "minProperties": 20, "maxProperties": 20, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "representativeSymbols": { "type": "object", "minProperties": 47, "maxProperties": 47 },
    "representativeAddresses": { "type": "object", "minProperties": 47, "maxProperties": 47, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "labelKindCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "commandCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
