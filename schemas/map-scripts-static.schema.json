{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/map-scripts-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "scope", "summary", "representativeSymbols", "representativeAddresses", "labelKindCounts", "commandCounts", "mostFrequentCommands", "standaloneOwnedInitScriptTargets", "runtimeQuestions", "files", "labelAddresses", "references", "programs"],
  "properties": {
