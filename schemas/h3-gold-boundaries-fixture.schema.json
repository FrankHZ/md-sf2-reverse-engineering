{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SF2 gold boundary fixture",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "battleId", "observationBoundary", "function", "ram", "harness", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-gold-boundaries-v1" },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "core"],
      "properties": { "name": { "const": "BizHawk" }, "version": { "type": "string" }, "core": { "const": "Genesis Plus GX" } }
    },
    "battleId": { "const": 1 },
    "observationBoundary": { "type": "string", "minLength": 1 },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["giveExpAndGoldEntryAddress", "increaseGoldEntryAddress", "increaseGoldReturnAddress"],
      "properties": {
        "giveExpAndGoldEntryAddress": { "const": 43000 },
        "increaseGoldEntryAddress": { "const": 35226 },
        "increaseGoldReturnAddress": { "const": 35250 }
      }
    },
    "ram": {
      "type": "object", "additionalProperties": false,
      "required": ["battleSceneGoldAddress", "currentGoldAddress", "seedAddress"],
      "properties": {
        "battleSceneGoldAddress": { "const": 16758314 },
        "currentGoldAddress": { "const": 16774656 },
        "seedAddress": { "const": 16768676 }
      }
    },
    "harness": {
      "type": "object", "additionalProperties": false,
      "required": ["function", "ram"],
      "properties": {
        "function": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 0 } },
        "ram": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "cases": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "initialGold", "addedGold", "carry", "finalGold"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "initialGold": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "addedGold": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "carry": { "type": "boolean" },
          "finalGold": { "type": "integer", "minimum": 0, "maximum": 9999999 }
        }
      }
    }
  }
}
