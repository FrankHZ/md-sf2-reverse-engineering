{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shining Force II Z80 music-bank source and ROM-parity inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "upstream", "rom", "scope", "summary", "entryPaths",
    "includeEdges", "songPaths", "facts", "songFiles", "commandModel", "strictIndexExclusion", "runtimeQuestions", "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-sound-data-static-v1" },
    "upstream": { "type": "object" },
    "rom": { "type": "object" },
    "scope": { "const": "data/sound" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileCount", "sourceLineCount", "statementCount", "globalLabelCount",
        "bankEntryFileCount", "sharedDefinitionFileCount", "songFileCount",
        "transitiveIncludeFileCount", "strictH1IndexedFileCount",
        "z80BankBoundSongFileCount", "songPayloadBytes"
      ],
      "properties": {
        "fileCount": { "const": 41 },
        "sourceLineCount": { "type": "integer", "minimum": 1 },
        "statementCount": { "type": "integer", "minimum": 1 },
        "globalLabelCount": { "type": "integer", "minimum": 1 },
        "bankEntryFileCount": { "const": 2 },
        "sharedDefinitionFileCount": { "const": 2 },
        "songFileCount": { "const": 37 },
        "transitiveIncludeFileCount": { "const": 39 },
        "strictH1IndexedFileCount": { "const": 0 },
        "z80BankBoundSongFileCount": { "const": 37 },
        "songPayloadBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "entryPaths": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true },
    "includeEdges": { "type": "array", "minItems": 41, "maxItems": 41 },
    "songPaths": { "type": "array", "minItems": 37, "maxItems": 37, "uniqueItems": true },
    "facts": { "type": "object" },
    "songFiles": {
      "type": "array", "minItems": 37, "maxItems": 37,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sourcePath", "bank", "musicIndex", "entrySymbol", "entryZ80Address", "entryRomOffset", "fileStartZ80Address", "fileEndZ80Address", "fileRomOffset", "sizeBytes", "sourceSha256", "payloadSha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^music[0-9]{2}$" },
          "sourcePath": { "type": "string", "pattern": "^data/sound/musicbank[01]/music[0-9]{2}\\.asm$" },
          "bank": { "enum": ["bank0", "bank1"] },
          "musicIndex": { "type": "integer", "minimum": 1, "maximum": 64 },
          "entrySymbol": { "type": "string", "pattern": "^Music_[0-9]+$" },
          "entryZ80Address": { "type": "integer", "minimum": 32832, "maximum": 65535 },
          "entryRomOffset": { "type": "integer", "minimum": 2031616, "maximum": 2097151 },
          "fileStartZ80Address": { "type": "integer", "minimum": 32832, "maximum": 65535 },
          "fileEndZ80Address": { "type": "integer", "minimum": 32833, "maximum": 65536 },
          "fileRomOffset": { "type": "integer", "minimum": 2031616, "maximum": 2097151 },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sourceSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
          "payloadSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
        }
      }
    },
    "commandModel": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "macroDefinitions", "invocationCounts", "unusedMacros", "channelRoles", "musicHeaders", "frequencyModel", "instrumentModel", "sampleModel", "songs", "driver", "bankSelection"],
      "properties": {
        "summary": { "type": "object" },
        "macroDefinitions": { "type": "array", "minItems": 1, "uniqueItems": true },
        "invocationCounts": { "type": "object" },
        "unusedMacros": { "type": "array", "uniqueItems": true },
        "channelRoles": {
          "type": "object", "additionalProperties": false,
          "required": ["slotRoles", "pointerCounts", "uniqueLabelCounts", "roleSetCounts", "macroRoleUses", "compatibility"],
          "properties": {
            "slotRoles": { "type": "array", "minItems": 10, "maxItems": 10 },
            "pointerCounts": { "type": "object" },
            "uniqueLabelCounts": { "type": "object" },
            "roleSetCounts": { "type": "array", "minItems": 1 },
            "macroRoleUses": { "type": "object" },
            "compatibility": {
              "type": "object", "additionalProperties": false,
              "required": ["allowedRolesByMacro", "violationCount", "violations"],
              "properties": {
                "allowedRolesByMacro": { "type": "object", "minProperties": 29, "maxProperties": 29 },
                "violationCount": { "const": 0 },
                "violations": { "type": "array", "maxItems": 0 }
              }
            }
          }
        },
        "musicHeaders": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "timerBValueCounts", "entries"],
          "properties": {
            "summary": { "type": "object" },
            "timerBValueCounts": { "type": "array", "minItems": 19, "maxItems": 19 },
            "entries": { "type": "array", "minItems": 39, "maxItems": 39 }
          }
        },
        "frequencyModel": {
          "type": "object", "additionalProperties": false,
          "required": ["enumSourcePath", "enumSourceSha256", "noteEnumCount", "macroInvocationCounts", "ym", "psg", "driverRules"],
          "properties": {
            "enumSourcePath": { "const": "data/sound/musicenums.asm" },
            "enumSourceSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
            "noteEnumCount": { "const": 108 },
            "macroInvocationCounts": { "type": "object" },
            "ym": { "type": "object" },
            "psg": { "type": "object" },
            "driverRules": { "type": "object" }
          }
        },
        "sampleModel": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "musicInvocationCounts", "entries"],
          "properties": {
            "summary": { "type": "object" },
            "musicInvocationCounts": { "type": "array", "minItems": 6, "maxItems": 6 },
            "entries": { "type": "array", "minItems": 17, "maxItems": 17 }
          }
        },
        "instrumentModel": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "ym", "psg"],
          "properties": {
            "summary": { "type": "object" },
            "ym": { "type": "object" },
            "psg": { "type": "object" }
          }
        },
        "songs": { "type": "array", "minItems": 37, "maxItems": 37 },
        "driver": { "type": "object" },
        "bankSelection": {
          "type": "object", "additionalProperties": false,
          "required": ["enumSourcePath", "enumSourceSha256", "summary", "bankRules", "zeroCommandBehavior", "nonzeroHeaderBehavior", "aliasTargets", "slots"],
          "properties": {
            "enumSourcePath": { "const": "sf2enums.asm" },
            "enumSourceSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
            "summary": { "type": "object" },
            "bankRules": { "type": "array", "minItems": 2, "maxItems": 2 },
            "zeroCommandBehavior": { "const": "ignored-by-main-loop" },
            "nonzeroHeaderBehavior": { "const": "redirect-to-load-sfx" },
            "aliasTargets": { "type": "array", "minItems": 2, "maxItems": 2 },
            "slots": { "type": "array", "minItems": 64, "maxItems": 64 }
          }
        }
      }
    },
    "strictIndexExclusion": { "type": "string", "minLength": 1 },
    "runtimeQuestions": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true
    },
    "files": { "type": "array", "minItems": 41, "maxItems": 41 }
  }
}
