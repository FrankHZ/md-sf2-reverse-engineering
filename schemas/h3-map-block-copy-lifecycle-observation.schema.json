{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sf2:h3:map-block-copy-lifecycle-observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "core", "id", "mapTest", "recordOrder", "records"],
  "properties": {
    "system": {"type": "string", "minLength": 1},
    "core": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "mapTest": {"type": "integer", "minimum": 0},
    "recordOrder": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "records": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/definitions/record"}}
  },
  "definitions": {
    "address": {"type": "integer", "minimum": 0, "maximum": 16777215},
    "word": {"type": "integer", "minimum": 0, "maximum": 65535},
    "byte": {"type": "integer", "minimum": 0, "maximum": 255},
    "addressValue": {
      "type": "object", "additionalProperties": false, "required": ["address", "value"],
      "properties": {"address": {"$ref": "#/definitions/address"}, "value": {"$ref": "#/definitions/word"}}
    },
    "helper": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["callSiteAddress", "targetAddress", "returnAddress"], "properties": {"callSiteAddress": {"$ref": "#/definitions/address"}, "targetAddress": {"$ref": "#/definitions/address"}, "returnAddress": {"$ref": "#/definitions/address"}}}
      ]
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "updateEntityDataEntryObserved", "helperEvent", "dispatcherTailAddressObserved", "updateToggleByteAfter", "busyWordAfter", "layoutReadbacks", "savedBufferSentinelAfter"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "updateEntityDataEntryObserved": {"type": "boolean"}, "helperEvent": {"$ref": "#/definitions/helper"},
        "dispatcherTailAddressObserved": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/address"}]}, "updateToggleByteAfter": {"$ref": "#/definitions/byte"}, "busyWordAfter": {"$ref": "#/definitions/word"},
        "layoutReadbacks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/addressValue"}}, "savedBufferSentinelAfter": {"$ref": "#/definitions/addressValue"}
      }
    }
  }
}
