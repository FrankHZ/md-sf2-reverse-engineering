{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sf2:schema:h2:map-data-static",
  "title": "Shining Force II complete map ASM static inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "upstream", "scope", "summary", "directLayoutPaths",
    "includeEdges", "strictReach", "indexedRecordIds", "indexedSourcePaths",
    "indexedRecordsBySourcePath", "representativeSymbols", "representativeAddresses",
    "facts", "runtimeQuestions", "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-map-data-static-v1" },
    "upstream": { "$ref": "#/definitions/upstream" },
    "scope": { "const": "data/maps" },
    "summary": { "$ref": "#/definitions/summary" },
    "directLayoutPaths": {
      "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
      "items": { "$ref": "#/definitions/sourcePath" }
    },
    "includeEdges": {
      "type": "array", "minItems": 1382, "maxItems": 1382,
      "items": { "$ref": "#/definitions/includeEdge" }
    },
    "strictReach": { "$ref": "#/definitions/strictReach" },
    "indexedRecordIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/definitions/recordId" }
    },
    "indexedSourcePaths": {
      "type": "array", "minItems": 727, "maxItems": 727, "uniqueItems": true,
      "items": { "$ref": "#/definitions/sourcePath" }
    },
    "indexedRecordsBySourcePath": {
      "type": "array", "minItems": 727, "maxItems": 727,
      "items": { "$ref": "#/definitions/indexedRecordsBySourcePath" }
    },
    "representativeSymbols": { "$ref": "#/definitions/representativeSymbols" },
    "representativeAddresses": { "$ref": "#/definitions/representativeAddresses" },
    "facts": { "$ref": "#/definitions/facts" },
    "runtimeQuestions": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "files": {
      "type": "array", "minItems": 1390, "maxItems": 1390,
      "items": { "$ref": "#/definitions/sourceFile" }
    }
  },
  "definitions": {
    "recordId": {
      "type": "string", "pattern": "^[a-z0-9.-]+$"
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^data/maps(?:/[A-Za-z0-9_.-]+)*\\.asm$"
    },
    "symbol": {
      "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "fileCount", "sourceLineCount", "statementCount", "globalLabelCount",
        "directLayoutFileCount", "transitiveIncludeFileCount", "internallyLabeledFileCount",
        "includeSiteOnlyFileCount", "unlabeledContainerFileCount", "representativeAddressCount",
        "indexedRecordCount", "indexedFileCount"
      ],
      "properties": {
        "fileCount": { "const": 1390 },
        "sourceLineCount": { "type": "integer", "minimum": 1 },
        "statementCount": { "type": "integer", "minimum": 1 },
        "globalLabelCount": { "type": "integer", "minimum": 1 },
        "directLayoutFileCount": { "const": 8 },
        "transitiveIncludeFileCount": { "const": 1382 },
        "internallyLabeledFileCount": { "const": 727 },
        "includeSiteOnlyFileCount": { "const": 662 },
        "unlabeledContainerFileCount": { "const": 1 },
        "representativeAddressCount": { "const": 727 },
        "indexedRecordCount": { "type": "integer", "minimum": 0 },
        "indexedFileCount": { "type": "integer", "minimum": 0 }
      }
    },
    "includeEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "label", "targetPath"],
      "properties": {
        "sourcePath": { "$ref": "#/definitions/sourcePath" },
        "label": { "type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "targetPath": { "$ref": "#/definitions/sourcePath" }
      }
    },
    "strictReach": {
      "type": "object", "additionalProperties": false,
      "required": [
        "internallyLabeledPaths", "includeSiteOnlyPaths", "unlabeledContainerPaths"
      ],
      "properties": {
        "internallyLabeledPaths": {
          "type": "array", "minItems": 727, "maxItems": 727, "uniqueItems": true,
          "items": { "$ref": "#/definitions/sourcePath" }
        },
        "includeSiteOnlyPaths": {
          "type": "array", "minItems": 662, "maxItems": 662, "uniqueItems": true,
          "items": { "$ref": "#/definitions/sourcePath" }
        },
        "unlabeledContainerPaths": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/definitions/sourcePath" }
        }
      }
    },
    "indexedRecordsBySourcePath": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "recordIds"],
      "properties": {
        "sourcePath": { "$ref": "#/definitions/sourcePath" },
        "recordIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/definitions/recordId" }
        }
      }
    },
    "representativeSymbols": {
      "type": "object", "minProperties": 727, "maxProperties": 727,
      "patternProperties": {
        "^data/maps(?:/[A-Za-z0-9_.-]+)*\\.asm$": { "$ref": "#/definitions/symbol" }
      },
      "additionalProperties": false
    },
    "representativeAddresses": {
      "type": "object", "minProperties": 727, "maxProperties": 727,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "mapSlotCount", "mapDirectoryCount", "mapContentFileCount", "mapSetupFileCount",
        "includeGraph", "entryBinaryPayloadCount", "mapSetupRouting", "globalTables",
        "mapContentParsed", "mapBinaryPayloadsDecoded", "canonicalMapImportBuilt",
        "mapSetupSemanticsParsed", "mapEventTablesParsed", "mapDescriptionTablesParsed",
        "mapInitFunctionsParsed", "standaloneMapScriptsParsed"
      ],
      "properties": {
        "mapSlotCount": { "const": 79 },
        "mapDirectoryCount": { "const": 79 },
        "mapContentFileCount": { "const": 662 },
        "mapSetupFileCount": { "const": 720 },
        "includeGraph": {
          "type": "object", "additionalProperties": false,
          "required": ["edgeCount", "uniqueTargetCount", "labeledEdgeCount", "unlabeledEdgeCount"],
          "properties": {
            "edgeCount": { "const": 1382 },
            "uniqueTargetCount": { "const": 1382 },
            "labeledEdgeCount": { "const": 662 },
            "unlabeledEdgeCount": { "const": 720 }
          }
        },
        "entryBinaryPayloadCount": { "const": 154 },
        "mapSetupRouting": {
          "type": "object", "additionalProperties": false,
          "required": ["mapRows", "flagRows", "mapEndRows"],
          "properties": {
            "mapRows": { "const": 64 },
            "flagRows": { "const": 66 },
            "mapEndRows": { "const": 64 }
          }
        },
        "globalTables": {
          "type": "object", "additionalProperties": false,
          "required": [
            "debugModeMapSlots", "flagSwitchedMapRows", "overworldMapRows",
            "raftResetRows", "savePointRows"
          ],
          "properties": {
            "debugModeMapSlots": { "const": 57 },
            "flagSwitchedMapRows": { "const": 3 },
            "overworldMapRows": { "const": 13 },
            "raftResetRows": { "const": 4 },
            "savePointRows": { "const": 23 }
          }
        },
        "mapContentParsed": { "type": "boolean" },
        "mapBinaryPayloadsDecoded": { "type": "boolean" },
        "canonicalMapImportBuilt": { "type": "boolean" },
        "mapSetupSemanticsParsed": { "type": "boolean" },
        "mapEventTablesParsed": { "type": "boolean" },
        "mapDescriptionTablesParsed": { "type": "boolean" },
        "mapInitFunctionsParsed": { "type": "boolean" },
        "standaloneMapScriptsParsed": { "type": "boolean" }
      }
    },
    "sourceFile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "sha256", "sourceLineCount", "statementCount", "globalLabels",
        "localLabelCount", "directCalls", "indirectCallSiteCount"
      ],
      "properties": {
        "path": { "$ref": "#/definitions/sourcePath" },
        "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "sourceLineCount": { "type": "integer", "minimum": 1 },
        "statementCount": { "type": "integer", "minimum": 0 },
        "globalLabels": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/definitions/symbol" }
        },
        "localLabelCount": { "type": "integer", "minimum": 0 },
        "directCalls": {
          "type": "array", "items": { "$ref": "#/definitions/directCall" }
        },
        "indirectCallSiteCount": { "type": "integer", "minimum": 0 }
      }
    },
    "directCall": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "siteCount"],
      "properties": {
        "target": { "$ref": "#/definitions/symbol" },
        "siteCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
