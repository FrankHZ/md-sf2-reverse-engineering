{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/compression-consumers-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "function", "summary", "targetCounts", "ownerCounts", "ownerFixtures", "callSites", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-compression-consumers-static-v1" },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": { "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "function": { "type": "object", "minProperties": 3, "maxProperties": 3, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "summary": { "type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "targetCounts": { "type": "object", "minProperties": 3, "maxProperties": 3, "additionalProperties": { "type": "integer", "minimum": 1 } },
    "ownerCounts": { "type": "object", "minProperties": 12, "maxProperties": 12, "additionalProperties": { "type": "integer", "minimum": 1 } },
    "ownerFixtures": { "type": "object", "minProperties": 12, "maxProperties": 12, "additionalProperties": { "type": "string" } },
    "callSites": {
      "type": "array", "minItems": 46, "maxItems": 46,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourcePath", "line", "contextLabel", "target", "owner", "ownerFixture"],
        "properties": {
          "sourcePath": { "type": "string" }, "line": { "type": "integer", "minimum": 1 },
          "contextLabel": { "type": "string" },
          "target": { "enum": ["LoadStackCompressedData", "LoadBasicCompressedData", "ApplyImmediateVramDmaOnCompressedTiles"] },
          "owner": { "type": "string" }, "ownerFixture": { "type": "string" }
        }
      }
    },
    "runtimeQuestions": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string" } }
  }
}
