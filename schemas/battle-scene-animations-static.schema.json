  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "sf2-battle-scene-animations-static-v1" },
    "upstream": { "type": "object" }, "scope": { "const": "code/gameflow/battle/battlescenes/animation" },
    "summary": { "type": "object", "required": ["fileCount", "sourceLineCount", "statementCount", "globalLabelCount", "localLabelCount", "directCallSiteCount", "indirectCallSiteCount", "uniqueDirectTargetCount", "internalDirectTargetCount", "externalDirectTargetCount", "indexedRecordCount", "indexedFileCount"], "properties": { "fileCount": { "const": 55 }, "indexedRecordCount": { "const": 55 }, "indexedFileCount": { "const": 55 } } },
    "indexedRecordIds": { "type": "array", "minItems": 55, "maxItems": 55, "uniqueItems": true },
    "indexedSourcePaths": { "type": "array", "minItems": 55, "maxItems": 55, "uniqueItems": true },
    "representativeSymbols": { "type": "object", "minProperties": 55, "maxProperties": 55 },
