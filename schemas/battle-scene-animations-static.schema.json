    "internalDirectCallTargets": { "type": "array", "uniqueItems": true },
    "externalDirectCallTargets": { "type": "array", "uniqueItems": true },
    "dispatchFacts": { "type": "object", "required": ["setupFileCount", "updateFileCount", "setupDispatchCount", "updateDispatchCount", "uniqueSetupTargetCount", "uniqueUpdateTargetCount", "rootOwnedUpdateTargets", "sharedSetupFiles", "reusedUpdateTargets", "allChildFilesDispatched", "pairs"] },
