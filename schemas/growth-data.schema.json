{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/growth-data.schema.json",
  "title": "Shining Force II ally growth and spell learning data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provenance", "growthScale", "growthProjectionLevel", "pointerSlots", "curves", "allies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provenance": { "type": "object", "required": ["repository", "commit", "sources"] },
    "growthScale": { "const": 256 },
    "growthProjectionLevel": { "const": 30 },
    "pointerSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "namedAllies", "slots30And31ReuseAlly"],
      "properties": {
        "count": { "const": 32 },
        "namedAllies": { "const": 30 },
        "slots30And31ReuseAlly": { "const": 29 }
      }
    },
    "curves": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "code", "levels"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 5 },
          "code": { "enum": ["LINEAR", "LATE", "EARLY", "MIDDLE", "EARLYANDLATE"] },
          "levels": {
            "type": "array", "minItems": 29, "maxItems": 29,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["level", "total256", "gain256"],
              "properties": {
                "level": { "type": "integer", "minimum": 2, "maximum": 30 },
                "total256": { "type": "integer", "minimum": 0, "maximum": 256 },
                "gain256": { "type": "integer", "minimum": 0, "maximum": 256 }
              }
            }
          }
        }
      }
    },
    "allies": {
      "type": "array", "minItems": 30, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "code", "classes"],
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 29 },
          "code": { "type": "string", "minLength": 1 },
          "classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/classRecord" } }
        }
      }
    }
  },
  "$defs": {
    "growth": {
      "type": "object", "additionalProperties": false, "required": ["start", "projected", "curve"],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 255 },
        "projected": { "type": "integer", "minimum": 0, "maximum": 255 },
        "curve": { "enum": ["NONE", "LINEAR", "LATE", "EARLY", "MIDDLE", "EARLYANDLATE"] }
      }
    },
    "spell": {
      "type": "object", "additionalProperties": false, "required": ["learnLevel", "spell", "spellLevel", "expression"],
      "properties": {
        "learnLevel": { "type": "integer", "minimum": 1, "maximum": 255 },
        "spell": { "type": "string", "minLength": 1 },
        "spellLevel": { "type": "integer", "minimum": 1, "maximum": 4 },
        "expression": { "type": "string", "minLength": 1 }
      }
    },
    "classRecord": {
      "type": "object", "additionalProperties": false, "required": ["class", "stats", "spellListMode", "spells"],
      "properties": {
        "class": { "type": "string", "minLength": 1 },
        "stats": {
          "type": "object", "additionalProperties": false, "required": ["hp", "mp", "attack", "defense", "agility"],
          "properties": {
            "hp": { "$ref": "#/$defs/growth" }, "mp": { "$ref": "#/$defs/growth" },
            "attack": { "$ref": "#/$defs/growth" }, "defense": { "$ref": "#/$defs/growth" },
            "agility": { "$ref": "#/$defs/growth" }
          }
        },
        "spellListMode": { "enum": ["explicit", "inherit-first"] },
        "spells": { "type": "array", "items": { "$ref": "#/$defs/spell" } }
      }
    }
  }
}
