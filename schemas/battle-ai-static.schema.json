{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/battle-ai-static.schema.json",
  "title": "Shining Force II battle AI static source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "scope", "summary", "actionFilters", "attackPriority", "healing", "indexedRecordIds", "indexedSourcePaths", "internalDirectCallTargets", "externalDirectCallTargets", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-battle-ai-static-v1" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "const": "https://github.com/ShiningForceCentral/SF2DISASM.git" },
        "commit": { "const": "c834c652b6862bc5679fd7f69a38a7093206efc6" }
      }
    },
    "scope": { "const": "code/gameflow/battle/ai" },
    "summary": { "$ref": "#/definitions/summary" },
    "actionFilters": { "$ref": "#/definitions/actionFilters" },
    "attackPriority": { "$ref": "#/definitions/attackPriority" },
    "healing": { "$ref": "#/definitions/healing" },
    "indexedRecordIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "indexedSourcePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^code/gameflow/battle/ai/.+\\.asm$" }
    },
    "internalDirectCallTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "externalDirectCallTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/file" }
    }
  },
  "definitions": {
    "nonnegative": { "type": "integer", "minimum": 0 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "sourceLineCount", "statementCount", "globalLabelCount", "localLabelCount", "directCallSiteCount", "indirectCallSiteCount", "uniqueDirectTargetCount", "internalDirectTargetCount", "externalDirectTargetCount", "indexedRecordCount", "indexedFileCount"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 1 },
        "sourceLineCount": { "type": "integer", "minimum": 1 },
        "statementCount": { "type": "integer", "minimum": 1 },
        "globalLabelCount": { "type": "integer", "minimum": 1 },
        "localLabelCount": { "$ref": "#/definitions/nonnegative" },
        "directCallSiteCount": { "$ref": "#/definitions/nonnegative" },
        "indirectCallSiteCount": { "$ref": "#/definitions/nonnegative" },
        "uniqueDirectTargetCount": { "$ref": "#/definitions/nonnegative" },
        "internalDirectTargetCount": { "$ref": "#/definitions/nonnegative" },
        "externalDirectTargetCount": { "$ref": "#/definitions/nonnegative" },
        "indexedRecordCount": { "$ref": "#/definitions/nonnegative" },
        "indexedFileCount": { "$ref": "#/definitions/nonnegative" }
      }
    },
    "namedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "value": { "type": "integer", "minimum": 0 }
      }
    },
    "spellFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "requiredSpellType", "rejectedCandidatePolicy", "confusionFilter"],
      "properties": {
        "function": { "type": "string" },
        "requiredSpellType": { "enum": ["heal", "support"] },
        "rejectedCandidatePolicy": { "const": "continue-to-next-slot" },
        "confusionFilter": { "const": false }
      }
    },
    "actionFilters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotCounts", "sentinels", "spellTypes", "attackSpell", "healingSpell", "supportSpell", "attackItem", "healingItem"],
      "properties": {
        "slotCounts": {
          "type": "object", "additionalProperties": false,
          "required": ["spells", "items"],
          "properties": { "spells": { "const": 4 }, "items": { "const": 4 } }
        },
        "sentinels": {
          "type": "object", "additionalProperties": false,
          "required": ["spellNothing", "itemNothing"],
          "properties": { "spellNothing": { "const": 63 }, "itemNothing": { "const": 127 } }
        },
        "spellTypes": {
          "type": "object", "additionalProperties": false,
          "required": ["attack", "heal", "support"],
          "properties": { "attack": { "const": 0 }, "heal": { "const": 1 }, "support": { "const": 2 } }
        },
        "attackSpell": {
          "type": "object", "additionalProperties": false,
          "required": ["function", "alliesAlwaysUseConfusedFilter", "confusedEnemyUsesFilter", "confusedAllowlist", "requiredSpellType", "rejectedCandidatePolicy", "returnsHighestUsableLevel"],
          "properties": {
            "function": { "const": "GetNextUsableAttackSpell" },
            "alliesAlwaysUseConfusedFilter": { "const": true },
            "confusedEnemyUsesFilter": { "const": true },
            "confusedAllowlist": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/definitions/namedValue" } },
            "requiredSpellType": { "const": "attack" },
            "rejectedCandidatePolicy": { "const": "continue-to-next-slot" },
            "returnsHighestUsableLevel": { "const": true }
          }
        },
        "healingSpell": { "$ref": "#/definitions/spellFilter" },
        "supportSpell": { "$ref": "#/definitions/spellFilter" },
        "attackItem": {
          "type": "object", "additionalProperties": false,
          "required": ["function", "alliesAlwaysUseConfusedFilter", "confusedEnemyUsesFilter", "confusedAllowlist", "requiredSpellType", "equippedItemBypassesAiUseFlag", "unequippedItemRequiresAiUseFlag", "unusableCandidatePolicy", "rejectedCandidatePolicy"],
          "properties": {
            "function": { "const": "GetNextUsableAttackItem" },
            "alliesAlwaysUseConfusedFilter": { "const": true },
            "confusedEnemyUsesFilter": { "const": true },
            "confusedAllowlist": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/definitions/namedValue" } },
            "requiredSpellType": { "const": "attack" },
            "equippedItemBypassesAiUseFlag": { "const": true },
            "unequippedItemRequiresAiUseFlag": { "const": true },
            "unusableCandidatePolicy": { "const": "continue-to-next-slot" },
            "rejectedCandidatePolicy": { "const": "stop-with-item-nothing" }
          }
        },
        "healingItem": {
          "type": "object", "additionalProperties": false,
          "required": ["function", "requiredSpellType", "healingRainItem", "healingRainBypassesAiUseFlag", "otherItemsRequireAiUseFlag", "rejectedCandidatePolicy", "confusionFilter"],
          "properties": {
            "function": { "const": "GetNextUsableHealingItem" },
            "requiredSpellType": { "const": "heal" },
            "healingRainItem": { "$ref": "#/definitions/namedValue" },
            "healingRainBypassesAiUseFlag": { "const": true },
            "otherItemsRequireAiUseFlag": { "const": true },
            "rejectedCandidatePolicy": { "const": "continue-to-next-slot" },
            "confusionFilter": { "const": false }
          }
        }
      }
    },
    "attackPriority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePaths", "scriptSelector", "regularPotentialDamage", "spellPotentialDamage", "remainingHpMinimum", "thresholds", "priorityScripts", "classAdjustment"],
      "properties": {
        "sourcePaths": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:code|data)/.+\\.asm$" }
        },
        "scriptSelector": {
          "type": "object", "additionalProperties": false,
          "required": ["difficultyRows", "activationColumns", "scriptsByDifficultyAndActivation", "allyActivationColumn", "enemyRegularActivationMask", "enemySpellActivationMask"],
          "properties": {
            "difficultyRows": { "const": 4 },
            "activationColumns": { "const": 4 },
            "scriptsByDifficultyAndActivation": {
              "type": "array", "minItems": 4, "maxItems": 4,
              "items": {
                "type": "array", "minItems": 4, "maxItems": 4,
                "items": { "type": "integer", "minimum": 1, "maximum": 4 }
              }
            },
            "allyActivationColumn": { "const": 2 },
            "enemyRegularActivationMask": { "const": 15 },
            "enemySpellActivationMask": { "const": 3 }
          }
        },
        "regularPotentialDamage": {
          "type": "object", "additionalProperties": false,
          "required": ["minimumBeforeLandEffect", "landEffectMultipliers256", "rounding"],
          "properties": {
            "minimumBeforeLandEffect": { "const": 1 },
            "landEffectMultipliers256": { "const": [256, 230, 205] },
            "rounding": { "const": "floor-after-multiply" }
          }
        },
        "spellPotentialDamage": {
          "type": "object", "additionalProperties": false,
          "required": ["base", "minorResistance", "majorResistance", "weakness", "resistanceValues", "areaScore"],
          "properties": {
            "base": { "const": "spell-power" },
            "minorResistance": { "const": "power-minus-floor-quarter" },
            "majorResistance": { "const": "floor-half" },
            "weakness": { "const": "power-plus-floor-quarter" },
            "resistanceValues": {
              "type": "object", "additionalProperties": false,
              "required": ["minor", "major", "weakness"],
              "properties": { "minor": { "const": 1 }, "major": { "const": 2 }, "weakness": { "const": 3 } }
            },
            "areaScore": { "const": "sum-target-priorities" }
          }
        },
        "remainingHpMinimum": { "const": 0 },
        "thresholds": {
          "type": "object", "additionalProperties": false,
          "required": ["script2Damage", "script2And4LowHp"],
          "properties": {
            "script2Damage": { "const": "remaining-less-than-or-equal-current-third" },
            "script2And4LowHp": { "const": "remaining-less-than-or-equal-max-fifth" }
          }
        },
        "priorityScripts": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "usesClassAdjustment"],
            "properties": {
              "id": { "type": "integer", "minimum": 1, "maximum": 4 },
              "base": { "type": "integer", "minimum": 0 },
              "lethalBonus": { "type": "integer", "minimum": 0 },
              "lastTargetBonus": { "type": "integer", "minimum": 0 },
              "damageThresholdBonus": { "type": "integer", "minimum": 0 },
              "lowHpBonus": { "type": "integer", "minimum": 0 },
              "rngRange": { "type": "integer", "minimum": 1 },
              "lethalityBranchOutcomes": { "type": "integer", "minimum": 0 },
              "movementBranchOutcomes": { "type": "integer", "minimum": 0 },
              "lethalityBase": { "type": "integer", "minimum": 0 },
              "movementPriorityFormula": { "type": "string", "minLength": 1 },
              "usesClassAdjustment": { "type": "boolean" }
            }
          }
        },
        "classAdjustment": {
          "type": "object", "additionalProperties": false,
          "required": ["alliesOnly", "skippedWhenConfused", "previousTargetSarahUsesMageTable", "sarahIndex", "movetypePointerTargets", "tables", "minimum", "maximum"],
          "properties": {
            "alliesOnly": { "const": true },
            "skippedWhenConfused": { "const": true },
            "previousTargetSarahUsesMageTable": { "const": true },
            "sarahIndex": { "const": 1 },
            "movetypePointerTargets": {
              "type": "array", "minItems": 16, "maxItems": 16,
              "items": { "type": "string", "pattern": "^table_PriorityAdjustments_(?:Regular|Mage|Archer|Flying)$" }
            },
            "tables": {
              "type": "object", "additionalProperties": false,
              "required": ["table_PriorityAdjustments_Regular", "table_PriorityAdjustments_Mage", "table_PriorityAdjustments_Archer", "table_PriorityAdjustments_Flying"],
              "properties": {
                "table_PriorityAdjustments_Regular": { "$ref": "#/definitions/classAdjustmentTable" },
                "table_PriorityAdjustments_Mage": { "$ref": "#/definitions/classAdjustmentTable" },
                "table_PriorityAdjustments_Archer": { "$ref": "#/definitions/classAdjustmentTable" },
                "table_PriorityAdjustments_Flying": { "$ref": "#/definitions/classAdjustmentTable" }
              }
            },
            "minimum": { "const": 0 },
            "maximum": { "const": 4 }
          }
        }
      }
    },
    "healing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePaths", "command", "eligibility", "spellLevel", "targetPriority"],
      "properties": {
        "sourcePaths": {
          "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:code|data)/.+\\.asm$" }
        },
        "command": {
          "type": "object", "additionalProperties": false,
          "required": ["function", "confusedCasterExits", "targetSide", "healingRainCheckedFirst", "healingRainCondition", "healingRainTarget", "acceptedSpellBases", "minimumMpBeforeTargeting", "itemFallbackAfterSpellFailure", "itemTakesPrecedenceAtActionLoad", "targetOrder"],
          "properties": {
            "function": { "const": "aiCommand_Heal" },
            "confusedCasterExits": { "const": true },
            "targetSide": { "const": "caster-side" },
            "healingRainCheckedFirst": { "const": true },
            "healingRainCondition": { "const": "first-enemy-current-hp-less-than-or-equal-half-max" },
            "healingRainTarget": { "const": "caster" },
            "acceptedSpellBases": { "const": [0, 1] },
            "minimumMpBeforeTargeting": { "const": { "heal": 3, "aura": 7 } },
            "itemFallbackAfterSpellFailure": { "const": true },
            "itemTakesPrecedenceAtActionLoad": { "const": true },
            "targetOrder": { "const": "descending-byte-priority-then-first-reachable" }
          }
        },
        "eligibility": {
          "type": "object", "additionalProperties": false,
          "required": ["requiresHealing", "requiresHealingIncludesTwoThirds", "halfHp", "halfHpIncludesEquality", "helperUnreachableAlternateEntries"],
          "properties": {
            "requiresHealing": { "const": "current-hp-times-three-less-than-or-equal-max-hp-times-two" },
            "requiresHealingIncludesTwoThirds": { "const": true },
            "halfHp": { "const": "current-hp-times-two-less-than-or-equal-max-hp" },
            "halfHpIncludesEquality": { "const": true },
            "helperUnreachableAlternateEntries": { "const": 2 }
          }
        },
        "spellLevel": {
          "type": "object", "additionalProperties": false,
          "required": ["missingHpThresholds", "selection", "fallbackLevel", "returnsZeroBasedLevel", "neverReturnsLevel2FromHelper", "mpCheck", "level2Override"],
          "properties": {
            "missingHpThresholds": { "const": { "noCastMaximum": 2, "level1Maximum": 14, "level3Maximum": 28 } },
            "selection": {
              "type": "array", "minItems": 4, "maxItems": 4,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["missingHp", "level"],
                "properties": {
                  "missingHp": { "type": "string", "minLength": 1 },
                  "level": { "type": "integer", "minimum": -1, "maximum": 3 },
                  "requiresKnownLevel": { "type": "integer", "minimum": 3, "maximum": 4 }
                }
              }
            },
            "fallbackLevel": { "const": 0 },
            "returnsZeroBasedLevel": { "const": true },
            "neverReturnsLevel2FromHelper": { "const": true },
            "mpCheck": {
              "type": "object", "additionalProperties": false,
              "required": ["candidateShiftBits", "requiredShiftBits", "packedBaseSpellEntryIsNotMasked", "decrementsUntilAffordable"],
              "properties": {
                "candidateShiftBits": { "const": 5 },
                "requiredShiftBits": { "const": 6 },
                "packedBaseSpellEntryIsNotMasked": { "const": true },
                "decrementsUntilAffordable": { "const": true }
              }
            },
            "level2Override": {
              "type": "object", "additionalProperties": false,
              "required": ["selectedLevelBeforeOverride", "targetMustDifferFromCaster", "minimumCasterMp", "minimumKnownLevel", "resultLevel"],
              "properties": {
                "selectedLevelBeforeOverride": { "const": 0 },
                "targetMustDifferFromCaster": { "const": true },
                "minimumCasterMp": { "const": 11 },
                "minimumKnownLevel": { "const": 3 },
                "resultLevel": { "const": 1 }
              }
            }
          }
        },
        "targetPriority": {
          "type": "object", "additionalProperties": false,
          "required": ["criticalCommandset", "leaderCommandset", "maximum", "criticalAndLeaderUseMaximum", "movetypeTable", "unmatchedPriority", "aoePerTargetBase", "aoeScore", "storedAsByte"],
          "properties": {
            "criticalCommandset": { "const": 13 },
            "leaderCommandset": { "const": 14 },
            "maximum": { "const": 13 },
            "criticalAndLeaderUseMaximum": { "const": true },
            "movetypeTable": {
              "type": "array", "minItems": 12, "maxItems": 12,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "value", "priority"],
                "properties": {
                  "name": { "type": "string", "pattern": "^MOVETYPE_[A-Z_]+$" },
                  "value": { "type": "integer", "minimum": 1, "maximum": 12 },
                  "priority": { "type": "integer", "minimum": 1, "maximum": 12 }
                }
              }
            },
            "unmatchedPriority": { "const": 0 },
            "aoePerTargetBase": { "const": 4 },
            "aoeScore": { "const": "sum-movetype-priority-plus-four-per-target" },
            "storedAsByte": { "const": true }
          }
        }
      }
    },
    "classAdjustmentTable": {
      "type": "array", "minItems": 32, "maxItems": 32,
      "items": { "type": "integer", "minimum": 0, "maximum": 4 }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "siteCount"],
      "properties": {
        "target": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "siteCount": { "type": "integer", "minimum": 1 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sourceLineCount", "statementCount", "globalLabels", "localLabelCount", "directCalls", "indirectCallSiteCount"],
      "properties": {
        "path": { "type": "string", "pattern": "^code/gameflow/battle/ai/.+\\.asm$" },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "sourceLineCount": { "type": "integer", "minimum": 1 },
        "statementCount": { "$ref": "#/definitions/nonnegative" },
        "globalLabels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "localLabelCount": { "$ref": "#/definitions/nonnegative" },
        "directCalls": {
          "type": "array",
          "items": { "$ref": "#/definitions/call" }
        },
        "indirectCallSiteCount": { "$ref": "#/definitions/nonnegative" }
      }
    }
  }
}
