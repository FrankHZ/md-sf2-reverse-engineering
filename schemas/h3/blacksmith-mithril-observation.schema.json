    "rngCall": {"type": "object", "additionalProperties": false, "required": ["role", "callPc", "targetPc", "returnPc", "rangeWord", "result", "randomSeedAfter"], "properties": {"role": {"enum": ["fallback-row-roll", "weapon-row-roll"]}, "callPc": {"$ref": "#/definitions/pc"}, "targetPc": {"$ref": "#/definitions/pc"}, "returnPc": {"$ref": "#/definitions/pc"}, "rangeWord": {"type": "integer", "minimum": 1, "maximum": 65535}, "result": {"type": "integer", "minimum": 0, "maximum": 65535}, "randomSeedAfter": {"type": "integer", "minimum": 0, "maximum": 65535}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["id", "classGroupIndex", "weaponRowIndex", "choiceIndex", "itemIndex", "orderWriteIndex", "ordersAfter", "randomSeedAfter", "rngCalls", "functionReturnSeen", "preservedD0", "preservedD7"], "properties": {"id": {"enum": ["ordinary-group0-early-slot0", "ordinary-group2-final-slot1", "brn-fallback-zero-row2-slot2", "rdbn-fallback-nonzero-row0-slot3", "all-occupied-no-order-write"]}, "classGroupIndex": {"type": "integer", "minimum": 0, "maximum": 8}, "weaponRowIndex": {"type": "integer", "minimum": 0, "maximum": 7}, "choiceIndex": {"type": "integer", "minimum": 0, "maximum": 3}, "itemIndex": {"type": "integer", "minimum": 0, "maximum": 255}, "orderWriteIndex": {"type": ["integer", "null"], "minimum": 0}, "ordersAfter": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 65535}}, "randomSeedAfter": {"type": "integer", "minimum": 0, "maximum": 65535}, "rngCalls": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/definitions/rngCall"}}, "functionReturnSeen": {"const": true}, "preservedD0": {"type": "integer", "minimum": 0, "maximum": 65535}, "preservedD7": {"type": "integer", "minimum": 0, "maximum": 65535}}},
    "observationPayload": {"type": "object", "additionalProperties": false, "required": ["system", "core", "id", "caseOrder", "records", "callbacksCleared", "seedAndOrdersRestored"], "properties": {"system": {"const": "GEN"}, "core": {"const": "Genesis Plus GX"}, "id": {"const": "sf2-blacksmith-mithril-runtime-v1"}, "caseOrder": {"const": ["ordinary-group0-early-slot0", "ordinary-group2-final-slot1", "brn-fallback-zero-row2-slot2", "rdbn-fallback-nonzero-row0-slot3", "all-occupied-no-order-write"]}, "records": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/definitions/record"}}, "callbacksCleared": {"const": 0}, "seedAndOrdersRestored": {"const": true}}}
