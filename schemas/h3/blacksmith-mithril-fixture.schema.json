{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sf2:h3:blacksmith-mithril-fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "evidenceDate", "provenance", "sourceContext", "observationBoundary", "caseOrder", "cases", "acceptedObservation", "runtimeQuestions"],
  "properties": {
    "schemaVersion": {"const": 1}, "id": {"const": "sf2-blacksmith-mithril-runtime-v1"}, "romSha256": {"const": "9ADF662D09881F58EC37D174AB01E87A7FCFB24700B5F84B26C0CD4F351509E9"}, "emulator": {"$ref": "#/definitions/emulator"}, "evidenceDate": {"const": "2026-08-08"}, "provenance": {"$ref": "#/definitions/provenance"}, "sourceContext": {"$ref": "#/definitions/sourceContext"}, "observationBoundary": {"type": "string", "minLength": 1}, "caseOrder": {"const": ["ordinary-group0-early-slot0", "ordinary-group2-final-slot1", "brn-fallback-zero-row2-slot2", "rdbn-fallback-nonzero-row0-slot3", "all-occupied-no-order-write"]}, "cases": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/definitions/case"}}, "acceptedObservation": {"$ref": "urn:sf2:h3:blacksmith-mithril-observation#/definitions/observationPayload"}, "runtimeQuestions": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "definitions": {
    "emulator": {"type": "object", "additionalProperties": false, "required": ["name", "version", "core"], "properties": {"name": {"const": "BizHawk"}, "version": {"const": "2.11.1"}, "core": {"const": "Genesis Plus GX"}}},
    "owner": {"type": "object", "additionalProperties": false, "required": ["fixture", "fixtureId"], "properties": {"fixture": {"type": "string", "minLength": 1}, "fixtureId": {"type": "string", "minLength": 1}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["upstreamRepository", "upstreamBranch", "upstreamCommit", "owners"], "properties": {"upstreamRepository": {"type": "string", "minLength": 1}, "upstreamBranch": {"type": "string", "minLength": 1}, "upstreamCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "owners": {"type": "object", "additionalProperties": false, "required": ["commonMenus", "itemAuxiliary", "rng"], "properties": {"commonMenus": {"$ref": "#/definitions/owner"}, "itemAuxiliary": {"$ref": "#/definitions/owner"}, "rng": {"$ref": "#/definitions/owner"}}}}},
    "sourceContext": {"type": "object", "additionalProperties": false, "required": ["pickSourcePath", "tableSourcePath", "h1ListingPath", "functionEntryAddress"], "properties": {"pickSourcePath": {"const": "code/common/menus/blacksmith/pickmithrilweapon.asm"}, "tableSourcePath": {"const": "data/stats/items/mithrilweapons.asm"}, "h1ListingPath": {"const": "build/sf2build-h1.lst"}, "functionEntryAddress": {"const": 138966}}},
    "sentinels": {"type": "object", "additionalProperties": false, "required": ["d0", "d7"], "properties": {"d0": {"type": "integer", "minimum": 0, "maximum": 65535}, "d7": {"type": "integer", "minimum": 0, "maximum": 65535}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["id", "clientClass", "randomSeedBefore", "ordersBefore", "registerSentinels"], "properties": {"id": {"enum": ["ordinary-group0-early-slot0", "ordinary-group2-final-slot1", "brn-fallback-zero-row2-slot2", "rdbn-fallback-nonzero-row0-slot3", "all-occupied-no-order-write"]}, "clientClass": {"type": "integer", "minimum": 0, "maximum": 255}, "randomSeedBefore": {"type": "integer", "minimum": 0, "maximum": 65535}, "ordersBefore": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 65535}}, "registerSentinels": {"$ref": "#/definitions/sentinels"}}}
  }
}
