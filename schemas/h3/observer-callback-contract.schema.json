      "required": ["active", "attemptIndex", "equipmentTypeCallCount", "equippabilityCallCount", "expectedTerminal", "frameBudget", "frameCount", "heldItemsCallCount", "memberListCallCount", "mode", "pendingService", "selectedMember", "terminal"],
