      "properties": {
        "active": {"type": "boolean"},
        "mode": {"enum": ["none", "helper", "transaction", "fulfillment", "precommit", "precommit-cleanup"]},
        "addItemReturnSeen": {"type": "boolean"},
        "orderReadSeen": {"type": "boolean"},
        "orderClearedSeen": {"type": "boolean"},
        "fulfilledOrdersIncrementSeen": {"type": "boolean"},
        "equippabilityCarrySet": {"type": ["boolean", "null"]},
        "originalReturnAddress": {"$ref": "#/definitions/nullablePc"}
      }
    },
    "blacksmithMithrilPrecommitPendingService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callPc", "returnPc", "role", "targetPc"],
