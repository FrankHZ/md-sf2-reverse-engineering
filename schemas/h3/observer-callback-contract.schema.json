        "returnPc": {"$ref": "#/definitions/pc"},
        "role": {"enum": ["member-list", "held-items", "equipment-type", "equippability"]},
        "targetPc": {"$ref": "#/definitions/pc"}
      }
    },
    "blacksmithMithrilPrecommitState": {
