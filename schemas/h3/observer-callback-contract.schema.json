        "equippabilityCallCount": {"type": "integer", "minimum": 0},
        "expectedTerminal": {"enum": ["none", "add-item", "recipient-cancel-pre-presentation", "full-inventory-pre-presentation", "non-equippable-pre-presentation"]},
        "frameBudget": {"type": "integer", "minimum": 0},
