      "required": ["active", "caseIndex", "functionReturnSeen", "orderWriteSeen", "pendingRngCall", "rolesAtPc", "transaction", "fulfillment", "precommit"],
      "properties": {
        "active": {"type": "boolean"},
        "caseIndex": {"type": "integer", "minimum": 0},
        "functionReturnSeen": {"type": "boolean"},
        "orderWriteSeen": {"type": "boolean"},
        "pendingRngCall": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/blacksmithMithrilPendingRngCall"}]},
        "rolesAtPc": {"type": "array", "uniqueItems": true, "items": {"enum": ["bootstrap-check-sram", "case-entry", "function-entry", "fallback-row-roll", "weapon-row-roll", "rng-entry", "rng-return", "row-resolved", "item-selected", "order-write", "function-rts", "case-result", "transaction-case-entry", "place-entry", "decrease-gold-call", "decrease-gold-instruction-target", "decrease-gold-effective-target", "decrease-gold-effective-return", "pending-orders-incremented", "drop-item-call", "drop-item-instruction-target", "drop-item-effective-target", "drop-item-tail-update-target", "drop-item-effective-return", "pick-mithril-call", "pick-mithril-effective-target", "transaction-fallback-row-roll", "transaction-weapon-row-roll", "transaction-rng-entry", "transaction-rng-return", "transaction-row-resolved", "transaction-item-selected", "transaction-order-write", "pick-mithril-effective-return", "clear-flag-call", "clear-flag-instruction-target", "clear-flag-effective-target", "clear-flag-pre-presentation-return", "transaction-case-result", "fulfillment-case-entry", "fulfillment-add-item-call", "fulfillment-add-item-instruction-target", "fulfillment-add-item-effective-target", "fulfillment-add-item-effective-return", "fulfillment-order-read", "fulfillment-order-cleared", "fulfillment-orders-incremented", "fulfillment-equippability-call", "fulfillment-equippability-instruction-target", "fulfillment-equippability-effective-target", "fulfillment-equippability-effective-return", "fulfillment-case-result", "precommit-case-entry", "precommit-selection-loop-entry", "precommit-member-list-controlled-service-call-shim", "precommit-held-items-controlled-service-call-shim", "precommit-equipment-type-controlled-service-call-shim", "precommit-equippability-controlled-service-call-shim", "precommit-generated-service-stub", "precommit-member-list-original-return", "precommit-held-items-original-return", "precommit-equipment-type-original-return", "precommit-equippability-original-return", "precommit-member-cancel-compare", "precommit-member-cancel-branch", "precommit-capacity-compare", "precommit-capacity-branch", "precommit-equipment-type-compare", "precommit-tool-admission-branch", "precommit-equippability-branch", "precommit-recipient-cancel-terminal-boundary-shim", "precommit-full-inventory-terminal-boundary-shim", "precommit-add-item-boundary", "precommit-cleanup-add-item-call", "precommit-cleanup-add-item-instruction-target", "precommit-cleanup-add-item-effective-target", "precommit-cleanup-add-item-effective-return", "precommit-cleanup-order-read", "precommit-cleanup-order-cleared", "precommit-cleanup-orders-incremented", "precommit-cleanup-equippability-call", "precommit-cleanup-equippability-instruction-target", "precommit-cleanup-equippability-effective-target", "precommit-cleanup-equippability-effective-return", "precommit-non-equippable-terminal-boundary-shim", "precommit-generated-result-stub", "precommit-case-result"]}},
        "transaction": {"$ref": "#/definitions/blacksmithMithrilTransactionState"},
        "fulfillment": {"$ref": "#/definitions/blacksmithMithrilFulfillmentState"},
        "precommit": {"$ref": "#/definitions/blacksmithMithrilPrecommitState"}
