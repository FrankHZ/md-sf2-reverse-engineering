    "blacksmithMithrilFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actualPc", "actualStackReturn", "actualStackTop", "callbacksRemaining", "caseId", "error", "expectedCallPc", "expectedEventPc", "expectedReturnPc", "expectedStackReturn", "expectedStackTop", "expectedTargetPc", "outputRemoved", "owner", "pendingCallback", "phase", "role", "sessionStateRestored"],
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "registration"}}},
          "then": {
            "properties": {
              "actualPc": {"type": "null"},
              "caseId": {"type": "null"},
              "expectedCallPc": {"type": "null"},
              "expectedEventPc": {"type": "null"},
              "expectedReturnPc": {"type": "null"},
              "expectedTargetPc": {"type": "null"},
              "pendingCallback": {"properties": {"active": {"const": false}, "caseIndex": {"const": 0}, "functionReturnSeen": {"const": false}, "orderWriteSeen": {"const": false}, "pendingRngCall": {"type": "null"}, "transaction": {"properties": {"active": {"const": false}, "mode": {"const": "none"}}}, "fulfillment": {"properties": {"active": {"const": false}, "mode": {"const": "none"}}}}}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "bootstrap-return-redirect"}}},
          "then": {
            "properties": {
              "caseId": {"type": "null"},
              "pendingCallback": {"properties": {"active": {"const": false}, "caseIndex": {"const": 0}, "functionReturnSeen": {"const": false}, "orderWriteSeen": {"const": false}, "pendingRngCall": {"type": "null"}, "transaction": {"properties": {"active": {"const": false}, "mode": {"const": "none"}}}, "fulfillment": {"properties": {"active": {"const": false}, "mode": {"const": "none"}}}}}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "case-entry"}}},
          "then": {
            "properties": {
              "caseId": {"$ref": "#/definitions/nonEmptyString"},
              "pendingCallback": {"properties": {"active": {"const": false}, "caseIndex": {"type": "integer", "minimum": 1}}}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "transaction-case-entry"}}},
          "then": {
            "properties": {
              "caseId": {"$ref": "#/definitions/nonEmptyString"},
              "pendingCallback": {"properties": {"active": {"const": false}, "caseIndex": {"type": "integer", "minimum": 1}, "transaction": {"properties": {"active": {"const": false}, "mode": {"const": "none"}}}}}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "fulfillment-case-entry"}}},
          "then": {
            "properties": {
              "caseId": {"$ref": "#/definitions/nonEmptyString"},
              "pendingCallback": {"properties": {"active": {"const": false}, "caseIndex": {"type": "integer", "minimum": 1}, "fulfillment": {"properties": {"active": {"const": false}, "mode": {"const": "none"}}}}}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "precommit-case-entry"}}},
