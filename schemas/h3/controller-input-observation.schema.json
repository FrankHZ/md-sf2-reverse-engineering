{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sf2:h3:controller-input-observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "core", "id", "caseOrder", "records", "callbacksCleared"],
  "properties": {
    "system": {"const": "GEN"},
    "core": {"const": "Genesis Plus GX"},
    "id": {"const": "sf2-controller-input-runtime-v1"},
    "caseOrder": {"const": ["sample-neutral", "sample-p1-up-b", "sample-p2-c-start", "sample-two-port-combined", "sample-release", "repeat-new-press", "repeat-release-repress", "repeat-held-threshold-cadence", "wait-player-input-immediate", "wait-player-input-delayed", "wait-player1-new-input-neutral-press", "wait-player1-new-input-release-repress", "wait-one-second-early-input", "wait-one-second-timeout", "wait-three-seconds-early-input", "wait-three-seconds-timeout"]},
    "records": {"type": "array", "minItems": 16, "maxItems": 16, "items": [{"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "sample-neutral"}, "result": {"$ref": "#/definitions/sampleResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "sample-p1-up-b"}, "result": {"$ref": "#/definitions/sampleResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "sample-p2-c-start"}, "result": {"$ref": "#/definitions/sampleResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "sample-two-port-combined"}, "result": {"$ref": "#/definitions/sampleResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "sample-release"}, "result": {"$ref": "#/definitions/sampleResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "repeat-new-press"}, "result": {"$ref": "#/definitions/repeatResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "repeat-release-repress"}, "result": {"$ref": "#/definitions/repeatResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "repeat-held-threshold-cadence"}, "result": {"$ref": "#/definitions/repeatResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "wait-player-input-immediate"}, "result": {"$ref": "#/definitions/waitResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "wait-player-input-delayed"}, "result": {"$ref": "#/definitions/waitResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "wait-player1-new-input-neutral-press"}, "result": {"$ref": "#/definitions/waitResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "wait-player1-new-input-release-repress"}, "result": {"$ref": "#/definitions/waitResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "wait-one-second-early-input"}, "result": {"$ref": "#/definitions/waitResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "wait-one-second-timeout"}, "result": {"$ref": "#/definitions/waitResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "wait-three-seconds-early-input"}, "result": {"$ref": "#/definitions/waitResult"}}}]}, {"allOf": [{"$ref": "#/definitions/record"}, {"properties": {"id": {"const": "wait-three-seconds-timeout"}, "result": {"$ref": "#/definitions/waitResult"}}}]}], "additionalItems": false},
    "callbacksCleared": {"const": 0}
  },
  "definitions": {
    "rawStateBytes": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "repeatFrame": {"type": "object", "additionalProperties": false, "required": ["rawStateBytes", "currentPlayerInput", "lastPlayerInput", "inputRepeatDelayer"], "properties": {"rawStateBytes": {"$ref": "#/definitions/rawStateBytes"}, "currentPlayerInput": {"type": "integer", "minimum": 0, "maximum": 255}, "lastPlayerInput": {"type": "integer", "minimum": 0, "maximum": 255}, "inputRepeatDelayer": {"type": "integer", "minimum": 0, "maximum": 255}}},
    "sampleResult": {"type": "object", "additionalProperties": false, "required": ["rawStateBytes"], "properties": {"rawStateBytes": {"$ref": "#/definitions/rawStateBytes"}}},
    "repeatResult": {"type": "object", "additionalProperties": false, "required": ["frames"], "properties": {"frames": {"type": "array", "minItems": 1, "maxItems": 31, "items": {"$ref": "#/definitions/repeatFrame"}}}},
    "waitResult": {"type": "object", "additionalProperties": false, "required": ["helperEntryCount", "helperReturnCount", "waitForVIntEntryCount", "waitForVIntReturnCount", "vIntEntryCount", "vIntInputStageCount", "frames"], "properties": {"helperEntryCount": {"type": "integer", "minimum": 1, "maximum": 3}, "helperReturnCount": {"type": "integer", "minimum": 1, "maximum": 1}, "waitForVIntEntryCount": {"type": "integer", "minimum": 0, "maximum": 180}, "waitForVIntReturnCount": {"type": "integer", "minimum": 0, "maximum": 180}, "vIntEntryCount": {"type": "integer", "minimum": 0, "maximum": 180}, "vIntInputStageCount": {"type": "integer", "minimum": 0, "maximum": 180}, "frames": {"type": "array", "maxItems": 180, "items": {"$ref": "#/definitions/repeatFrame"}}, "d5After": {"type": "integer", "minimum": 0, "maximum": 4294967295}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["id", "result"], "properties": {"id": {"enum": ["sample-neutral", "sample-p1-up-b", "sample-p2-c-start", "sample-two-port-combined", "sample-release", "repeat-new-press", "repeat-release-repress", "repeat-held-threshold-cadence", "wait-player-input-immediate", "wait-player-input-delayed", "wait-player1-new-input-neutral-press", "wait-player1-new-input-release-repress", "wait-one-second-early-input", "wait-one-second-timeout", "wait-three-seconds-early-input", "wait-three-seconds-timeout"]}, "result": {"oneOf": [{"$ref": "#/definitions/sampleResult"}, {"$ref": "#/definitions/repeatResult"}, {"$ref": "#/definitions/waitResult"}]}}}
  }
}
