{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sf2.example/schemas/h3/map3-battle01-player-ready-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "system", "romSha256", "emulator", "caseOrder", "cases", "privateProvenance", "static", "expectedObservation"],
  "properties": {
    "id": {"const": "sf2-map3-battle01-player-ready-runtime-v1"},
    "system": {"const": "sf2-map3-battle01-player-ready-runtime-v1"},
    "romSha256": {"const": "9ADF662D09881F58EC37D174AB01E87A7FCFB24700B5F84B26C0CD4F351509E9"},
    "emulator": {"type": "object", "additionalProperties": false, "required": ["name", "version", "core"], "properties": {"name": {"const": "BizHawk"}, "version": {"const": "2.11.1"}, "core": {"const": "Genesis Plus GX"}}},
    "caseOrder": {"const": ["bridged-r2b-to-first-battle01-player-ready"]},
    "cases": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/case"}},
    "privateProvenance": {"$ref": "#/$defs/provenance"},
    "static": {"$ref": "#/$defs/static"},
    "expectedObservation": {"$ref": "map3-battle01-player-ready-observation.schema.json"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "address": {"type": "integer", "minimum": 0, "maximum": 16777215},
    "case": {"type": "object", "additionalProperties": false, "required": ["caseId", "injectedInitialMenuReturn", "injectedDifficultyMenuReturn", "promptDefaultReturn", "frameBudget"], "properties": {"caseId": {"const": "bridged-r2b-to-first-battle01-player-ready"}, "injectedInitialMenuReturn": {"const": 1}, "injectedDifficultyMenuReturn": {"const": 0}, "promptDefaultReturn": {"const": 0}, "frameBudget": {"const": 90000}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["romSha256", "upstreamRepository", "upstreamCommit", "runtime", "bridgeBoundary", "privateBoundary"], "properties": {"romSha256": {"const": "9ADF662D09881F58EC37D174AB01E87A7FCFB24700B5F84B26C0CD4F351509E9"}, "upstreamRepository": {"const": "https://github.com/ShiningForceCentral/SF2DISASM.git"}, "upstreamCommit": {"const": "c834c652b6862bc5679fd7f69a38a7093206efc6"}, "runtime": {"const": "BizHawk 2.11.1 / Genesis Plus GX"}, "bridgeBoundary": {"const": "explicit non-natural R2a follower-ready to R2b terminal state; original route resumes after seed"}, "privateBoundary": {"const": "private-local-no-ROM-save-state-trace-or-capture-payload"}}},
    "retainedItem": {"type": "object", "additionalProperties": false, "required": ["fixtureId", "fixtureSha256"], "properties": {"fixtureId": {"type": "string", "minLength": 1}, "fixtureSha256": {"$ref": "#/$defs/hash"}}},
    "point": {"type": "object", "additionalProperties": false, "required": ["map", "x", "y"], "properties": {"map": {"type": "integer", "minimum": 0, "maximum": 255}, "x": {"type": "integer", "minimum": 0, "maximum": 255}, "y": {"type": "integer", "minimum": 0, "maximum": 255}, "facing": {"type": "integer", "minimum": 0, "maximum": 3}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["waypoint", "input", "from", "to"], "properties": {"waypoint": {"type": "string", "minLength": 1}, "input": {"enum": ["Up", "Right", "Down", "Left"]}, "from": {"$ref": "#/$defs/point"}, "to": {"$ref": "#/$defs/point"}}},
    "warp": {"type": "object", "additionalProperties": false, "required": ["id", "from", "to"], "properties": {"id": {"type": "string", "minLength": 1}, "from": {"$ref": "#/$defs/point"}, "to": {"$ref": "#/$defs/point"}}},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["id", "address", "width", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "address": {"$ref": "#/$defs/address"}, "width": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "static": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retained", "bridge", "inputPlan", "warps", "admission", "participatingCombatants", "turnOrderEntries", "functions", "ram", "romAnchors", "sourceHashes", "sourceProjectionSha256"],
      "properties": {
        "retained": {"type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": {"$ref": "#/$defs/retainedItem"}},
        "bridge": {"type": "object", "additionalProperties": true, "required": ["kind", "naturalR2bContinuity", "eventType", "eventParam1", "map", "player", "guard", "setFlags", "clearFlags", "randomSeed", "randomSeedCopy", "frameCounter", "secondsCounter", "secondsCounterFrames"], "properties": {"kind": {"const": "explicit-controlled-harness-bridge"}, "naturalR2bContinuity": {"const": false}, "eventType": {"const": 1}, "eventParam1": {"const": 0}, "map": {"const": 21}}},
        "inputPlan": {"type": "array", "minItems": 46, "maxItems": 46, "items": {"$ref": "#/$defs/input"}},
        "warps": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/warp"}},
        "admission": {"type": "object", "additionalProperties": false, "required": ["map", "battle", "area", "unlockedFlag", "completedFlag", "introFlag", "regionFlagStart", "regionFlagEnd"], "properties": {"map": {"const": 57}, "battle": {"const": 1}, "area": {"const": [0, 0, 16, 20]}, "unlockedFlag": {"const": 401}, "completedFlag": {"const": 501}, "introFlag": {"const": 451}, "regionFlagStart": {"const": 90}, "regionFlagEnd": {"const": 105}}},
        "participatingCombatants": {"const": [0, 1, 2, 128, 129, 130, 131, 132, 133]},
        "turnOrderEntries": {"const": 64},
        "functions": {"type": "object", "minProperties": 20, "additionalProperties": {"$ref": "#/$defs/address"}},
        "ram": {"type": "object", "minProperties": 40, "additionalProperties": {"type": "integer"}},
        "romAnchors": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/anchor"}},
        "sourceHashes": {"type": "object", "minProperties": 12, "maxProperties": 12, "additionalProperties": {"$ref": "#/$defs/hash"}},
        "sourceProjectionSha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
