{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sf2:h3:map3-original-player-locomotion-animation-fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "system", "romSha256", "emulator", "caseOrder", "cases", "harness", "privateProvenance", "static", "expectedObservation", "sourceContext"],
  "properties": {
    "id": {"const": "sf2-map3-original-player-locomotion-animation-runtime-v1"},
    "system": {"const": "controlled-map3-original-player-locomotion-animation"},
    "romSha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "emulator": {"$ref": "#/definitions/emulator"},
    "caseOrder": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "cases": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/definitions/case"}},
    "harness": {"$ref": "#/definitions/harness"},
    "privateProvenance": {"$ref": "#/definitions/privateProvenance"},
    "static": {"$ref": "#/definitions/static"},
    "expectedObservation": {"$ref": "#/definitions/observation"},
    "sourceContext": {"$ref": "#/definitions/sourceContext"}
  },
  "definitions": {
    "emulator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "core"],
      "properties": {"name": {"const": "BizHawk"}, "version": {"const": "2.11.1"}, "core": {"const": "Genesis Plus GX"}}
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "direction", "joypadName", "facing"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "direction": {"enum": ["UP", "LEFT", "RIGHT", "DOWN"]},
        "joypadName": {"enum": ["Up", "Left", "Right", "Down"]},
        "facing": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "harness": {
      "type": "object", "additionalProperties": false,
      "required": ["maxFrames", "privateCapturePolicy"],
      "properties": {"maxFrames": {"type": "integer", "minimum": 1}, "privateCapturePolicy": {"type": "string", "minLength": 1}}
    },
    "privateProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["romSha256", "upstreamCommit"],
      "properties": {"romSha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "upstreamCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "directionRule": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "facing", "sourceSlot", "horizontalMirror"],
      "properties": {
        "direction": {"enum": ["UP", "LEFT", "RIGHT", "DOWN"]},
        "facing": {"type": "integer", "minimum": 0, "maximum": 3},
        "sourceSlot": {"type": "integer", "minimum": 0, "maximum": 2},
        "horizontalMirror": {"type": "boolean"}
      }
    },
    "framePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "selectedHalf", "classification", "sourceRoots", "observedStandingOrIdleFrame", "observedVisibleAtFirstWaitForEvent"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "selectedHalf": {"type": "integer", "minimum": 0, "maximum": 1},
        "classification": {"type": "string", "minLength": 1},
        "sourceRoots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "observedStandingOrIdleFrame": {"type": "boolean"},
        "observedVisibleAtFirstWaitForEvent": {"type": "boolean"}
      }
    },
    "static": {
      "type": "object", "additionalProperties": false,
      "required": ["facts", "staticFacingJoin", "admittedStartFixtureId", "entityMovementFixtureId"],
      "properties": {
        "facts": {
          "type": "object", "additionalProperties": false,
          "required": ["mapTileSize", "halfThreshold", "counterResetAbove", "movementCounterVelocityShift", "spriteCounterIncrement", "updateOrder"],
          "properties": {
            "mapTileSize": {"const": 384}, "halfThreshold": {"const": 15}, "counterResetAbove": {"const": 30},
            "movementCounterVelocityShift": {"const": 5}, "spriteCounterIncrement": {"const": 1},
            "updateOrder": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}}
          }
        },
        "staticFacingJoin": {
          "type": "object", "additionalProperties": false,
          "required": ["fixture", "fixtureId", "directionRules", "supersededPolicyOnly"],
          "properties": {
            "fixture": {"type": "string", "minLength": 1},
            "fixtureId": {"const": "sf2-map3-original-player-reference-frame-static-v1"},
            "directionRules": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/definitions/directionRule"}},
            "supersededPolicyOnly": {"$ref": "#/definitions/framePolicy"}
          }
        },
        "admittedStartFixtureId": {"const": "sf2-map3-admitted-start-runtime-v1"},
        "entityMovementFixtureId": {"const": "sf2-entity-movement-runtime-v1"}
      }
    },
    "entityState": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "xVelocity", "yVelocity", "xTravel", "yTravel", "xDest", "yDest", "facing", "animCounter"],
      "properties": {
        "x": {"type": "integer", "minimum": 0, "maximum": 65535}, "y": {"type": "integer", "minimum": 0, "maximum": 65535},
        "xVelocity": {"type": "integer", "minimum": -32768, "maximum": 32767}, "yVelocity": {"type": "integer", "minimum": -32768, "maximum": 32767},
        "xTravel": {"type": "integer", "minimum": 0, "maximum": 65535}, "yTravel": {"type": "integer", "minimum": 0, "maximum": 65535},
        "xDest": {"type": "integer", "minimum": 0, "maximum": 65535}, "yDest": {"type": "integer", "minimum": 0, "maximum": 65535},
        "facing": {"type": "integer", "minimum": 0, "maximum": 3}, "animCounter": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "spriteObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["selectedHalf", "counterAtSelection", "counterAfter"],
      "properties": {"selectedHalf": {"type": "integer", "minimum": 0, "maximum": 1}, "counterAtSelection": {"type": "integer", "minimum": 0, "maximum": 255}, "counterAfter": {"type": "integer", "minimum": 0, "maximum": 255}}
    },
    "inputAttempt": {
      "type": "object", "additionalProperties": false,
      "required": ["before", "playerInput", "after"],
      "properties": {"before": {"$ref": "#/definitions/entityState"}, "playerInput": {"type": "integer", "minimum": 0, "maximum": 255}, "after": {"$ref": "#/definitions/entityState"}}
    },
    "tick": {
      "type": "object", "additionalProperties": false,
      "required": ["tick", "beforeEntities", "afterMovement", "inputAttempt", "sprite"],
      "properties": {
        "tick": {"type": "integer", "minimum": 1},
        "beforeEntities": {"$ref": "#/definitions/entityState"},
        "afterMovement": {"$ref": "#/definitions/entityState"},
        "inputAttempt": {"anyOf": [{"$ref": "#/definitions/inputAttempt"}, {"type": "null"}]},
        "sprite": {"$ref": "#/definitions/spriteObservation"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "direction", "seed", "ticks", "inputObserved", "inputTick", "motionInstalled", "outcome", "settled", "staticSelection"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1}, "direction": {"enum": ["UP", "LEFT", "RIGHT", "DOWN"]},
        "seed": {"$ref": "#/definitions/entityState"}, "ticks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/tick"}},
        "inputObserved": {"const": true}, "inputTick": {"type": "integer", "minimum": 1}, "motionInstalled": {"type": "boolean"},
        "outcome": {"enum": ["moved-one-tile", "blocked-no-movement"]}, "settled": {"$ref": "#/definitions/entityState"},
        "staticSelection": {"$ref": "#/definitions/directionRule"}
      }
    },
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary", "entity", "sprite"],
      "properties": {"boundary": {"const": "first-original-WaitForEvent-entry"}, "entity": {"$ref": "#/definitions/entityState"}, "sprite": {"$ref": "#/definitions/spriteObservation"}}
    },
    "restoration": {
      "type": "object", "additionalProperties": false,
      "required": ["scopeArmed", "bootstrapStateRestored", "playerEntity", "mapAndBattleState", "generatedRam", "sessionCartPatches", "callbacksCleared", "outputRemoved", "sessionRomDeleted"],
      "properties": {
        "scopeArmed": {"type": "boolean"}, "bootstrapStateRestored": {"type": "boolean"}, "playerEntity": {"type": "boolean"},
        "mapAndBattleState": {"type": "boolean"}, "generatedRam": {"type": "boolean"}, "sessionCartPatches": {"type": "boolean"},
        "callbacksCleared": {"type": "boolean"}, "outputRemoved": {"type": "boolean"}, "sessionRomDeleted": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "caseOrder", "admission", "records", "callbacksCleared", "restoration"],
      "properties": {
        "system": {"const": "sf2-map3-original-player-locomotion-animation-runtime-v1"},
        "caseOrder": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "admission": {"$ref": "#/definitions/admission"},
        "records": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/definitions/record"}},
        "callbacksCleared": {"const": true}, "restoration": {"$ref": "#/definitions/restoration"}
      }
    },
    "sourceContext": {
      "type": "object", "additionalProperties": false,
      "required": ["functions", "ram"],
      "properties": {
        "functions": {
          "type": "object", "additionalProperties": false,
          "required": ["waitForEvent", "vintUpdateEntities", "updateEntityData", "updateEntityDataReturn", "controlCharacter", "nextEntity", "vintUpdateSprites", "spriteHalf0", "spriteHalf1", "spriteCounterAfter"],
          "properties": {
            "waitForEvent": {"type": "integer", "minimum": 0}, "vintUpdateEntities": {"type": "integer", "minimum": 0},
            "updateEntityData": {"type": "integer", "minimum": 0}, "updateEntityDataReturn": {"type": "integer", "minimum": 0},
            "controlCharacter": {"type": "integer", "minimum": 0}, "nextEntity": {"type": "integer", "minimum": 0},
            "vintUpdateSprites": {"type": "integer", "minimum": 0}, "spriteHalf0": {"type": "integer", "minimum": 0},
            "spriteHalf1": {"type": "integer", "minimum": 0}, "spriteCounterAfter": {"type": "integer", "minimum": 0}
          }
        },
        "ram": {"type": "object", "additionalProperties": false, "required": ["ENTITY_DATA"], "properties": {"ENTITY_DATA": {"type": "integer", "minimum": 0}}}
      }
    }
  }
}
