{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "address": {"type": "integer", "minimum": 0},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "fixtureSha256"],
      "properties": {
        "fixtureId": {"type": "string", "minLength": 1},
        "fixtureSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "address", "endAddressExclusive", "byteLength"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "address": {"$ref": "#/$defs/address"},
        "endAddressExclusive": {"$ref": "#/$defs/address"},
        "byteLength": {"type": "integer", "minimum": 1}
      }
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callAddress", "returnAddress", "instructionTarget", "effectiveTarget", "siteCount"],
      "properties": {
        "callAddress": {"$ref": "#/$defs/address"},
        "returnAddress": {"$ref": "#/$defs/address"},
        "instructionTarget": {"const": "UseItemOnField"},
        "effectiveTarget": {"const": "UseItemOnField"},
        "siteCount": {"const": 1}
      }
    },
    "dispatchOrder": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "effect"],
        "properties": {
          "itemId": {"type": "integer", "minimum": 0, "maximum": 127},
          "effect": {"type": "string", "enum": ["curePoison", "curePoisonAndParalysis", "increaseAtt", "increaseDef", "increaseAgi", "increaseMov", "increaseHp", "increaseMp", "levelUp"]}
        }
      },
      "const": [
        {"itemId": 3, "effect": "curePoison"},
        {"itemId": 5, "effect": "curePoisonAndParalysis"},
        {"itemId": 9, "effect": "increaseAtt"},
        {"itemId": 10, "effect": "increaseDef"},
        {"itemId": 11, "effect": "increaseAgi"},
        {"itemId": 12, "effect": "increaseMov"},
        {"itemId": 13, "effect": "increaseHp"},
        {"itemId": 14, "effect": "increaseMp"},
        {"itemId": 15, "effect": "levelUp"}
      ]
    },
    "randomEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "textIds", "baseTarget", "currentTarget", "callOrder"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "textIds": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer"}},
        "baseTarget": {"type": "string", "minLength": 1},
        "currentTarget": {"type": "string", "minLength": 1},
        "callOrder": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "upstream", "romSha256", "sourceContext", "retainedOwners", "fieldItemEffects", "unknowns", "summary"],
      "properties": {
        "schemaVersion": {"const": 1},
        "id": {"const": "sf2-field-item-effects-static-v1"},
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit"],
          "properties": {
            "repository": {"const": "https://github.com/ShiningForceCentral/SF2DISASM.git"},
            "commit": {"const": "c834c652b6862bc5679fd7f69a38a7093206efc6"}
          }
        },
        "romSha256": {"const": "9ADF662D09881F58EC37D174AB01E87A7FCFB24700B5F84B26C0CD4F351509E9"},
        "sourceContext": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceIdentities", "h1RomAnchors", "layoutCanonicalIncludes", "excludedAlternates", "callerInventory"],
          "properties": {
            "sourceIdentities": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/sourceIdentity"}},
            "h1RomAnchors": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/anchor"}},
            "layoutCanonicalIncludes": {"const": ["code\\common\\menus\\item\\isitemusableonfield.asm", "data\\stats\\items\\usableoutsidebattleitems.asm", "code\\common\\menus\\item\\fielditemeffects.asm"]},
            "excludedAlternates": {"const": ["code/common/stats/items/fielditemeffects.asm"]},
            "callerInventory": {
              "type": "object",
              "additionalProperties": false,
              "required": ["instructionTarget", "effectiveTarget", "instructionTargetSiteCount", "effectiveTargetSiteCount"],
              "properties": {
                "instructionTarget": {"const": "UseItemOnField"},
                "effectiveTarget": {"const": "UseItemOnField"},
                "instructionTargetSiteCount": {"const": 2},
                "effectiveTargetSiteCount": {"const": 2}
              }
            }
          }
        },
        "retainedOwners": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commonMenus", "fieldMenuControl", "coreStatsData", "itemAuxiliary", "techInterfaces", "commonStats", "rng", "levelUp", "updateCombatantStats"],
          "properties": {
            "commonMenus": {"$ref": "#/$defs/owner"},
            "fieldMenuControl": {"$ref": "#/$defs/owner"},
            "coreStatsData": {"$ref": "#/$defs/owner"},
            "itemAuxiliary": {"$ref": "#/$defs/owner"},
            "techInterfaces": {"$ref": "#/$defs/owner"},
            "commonStats": {"$ref": "#/$defs/owner"},
            "rng": {"$ref": "#/$defs/owner"},
            "levelUp": {"$ref": "#/$defs/owner"},
            "updateCombatantStats": {"$ref": "#/$defs/owner"}
          }
        },
        "fieldItemEffects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["callers", "usability", "dispatch", "randomGain", "effects"],
          "properties": {
            "callers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fieldMenu", "caravan"],
              "properties": {"fieldMenu": {"$ref": "#/$defs/caller"}, "caravan": {"$ref": "#/$defs/caller"}}
            },
            "usability": {
              "type": "object",
              "additionalProperties": false,
              "required": ["functionAddress", "tableAddress", "itemIds", "sentinel", "inputRegister", "resultRegister", "matchResult", "notFoundResult", "preservedRegisters"],
              "properties": {
                "functionAddress": {"const": 141770}, "tableAddress": {"const": 141794},
                "itemIds": {"const": [3, 5, 9, 10, 11, 12, 13, 14, 15]}, "sentinel": {"const": 255},
                "inputRegister": {"const": "d1"}, "resultRegister": {"const": "d2"},
                "matchResult": {"const": 0}, "notFoundResult": {"const": -1}, "preservedRegisters": {"const": ["d1"]}
              }
            },
            "dispatch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["functionAddress", "tableAddress", "itemEntryMask", "sentinel", "notFoundBranch", "preservedRegisters"],
              "properties": {
                "functionAddress": {"const": 141804}, "tableAddress": {"const": 141858},
                "itemEntryMask": {"const": 127}, "sentinel": {"const": -1}, "notFoundBranch": {"const": "beq"},
                "preservedRegisters": {"const": ["d0", "d1", "d6", "d7", "a0"]}
              }
            },
            "randomGain": {
              "type": "object",
              "additionalProperties": false,
              "required": ["generatorAddress", "boundRegister", "bound", "resultRegister", "postIncrement", "gainRange"],
              "properties": {
                "generatorAddress": {"const": 5632}, "boundRegister": {"const": "d6"}, "bound": {"const": 3},
                "resultRegister": {"const": "d7"}, "postIncrement": {"const": 2}, "gainRange": {"const": [2, 4]}
              }
            },
            "effects": {
              "type": "object",
              "additionalProperties": false,
              "required": ["curePoison", "curePoisonAndParalysis", "increaseAtt", "increaseDef", "increaseAgi", "increaseMov", "increaseHp", "increaseMp", "levelUp", "dispatchOrder"],
              "properties": {
                "curePoison": {
                  "type": "object", "additionalProperties": false,
                  "required": ["address", "statusBit", "statusMask", "clearOperation", "clearBranch", "callOrder", "getStatusEffectsAddress", "textIds"],
                  "properties": {"address": {"const": 141902}, "statusBit": {"const": 1}, "statusMask": {"const": 2}, "clearOperation": {"const": "bclr"}, "clearBranch": {"const": "beq"}, "callOrder": {"const": ["GetStatusEffects", "SetStatusEffects"]}, "getStatusEffectsAddress": {"const": 33830}, "textIds": {"const": [149, 148]}}
                },
                "curePoisonAndParalysis": {
                  "type": "object", "additionalProperties": false,
                  "required": ["address", "statusBits", "statusMasks", "clearOperation", "effectPresentBranch", "callOrder", "updateCombatantStatsAddress", "textIds"],
                  "properties": {"address": {"const": 141936}, "statusBits": {"const": [1, 0]}, "statusMasks": {"const": [2, 1]}, "clearOperation": {"const": "bclr"}, "effectPresentBranch": {"const": "bne"}, "callOrder": {"const": ["GetStatusEffects", "SetStatusEffects", "UpdateCombatantStats"]}, "updateCombatantStatsAddress": {"const": 35278}, "textIds": {"const": [149, 156, 148]}}
                },
                "increaseAtt": {"allOf": [{"$ref": "#/$defs/randomEffect"}, {"properties": {"address": {"const": 141998}, "textIds": {"const": [150]}, "baseTarget": {"const": "IncreaseBaseAtt"}, "currentTarget": {"const": "IncreaseCurrentAtt"}, "callOrder": {"const": ["GenerateRandomNumber", "IncreaseBaseAtt", "IncreaseCurrentAtt"]}}}]},
                "increaseDef": {"allOf": [{"$ref": "#/$defs/randomEffect"}, {"properties": {"address": {"const": 142038}, "textIds": {"const": [151]}, "baseTarget": {"const": "IncreaseBaseDef"}, "currentTarget": {"const": "IncreaseCurrentDef"}, "callOrder": {"const": ["GenerateRandomNumber", "IncreaseBaseDef", "IncreaseCurrentDef"]}}}]},
                "increaseAgi": {"allOf": [{"$ref": "#/$defs/randomEffect"}, {"properties": {"address": {"const": 142078}, "textIds": {"const": [152]}, "baseTarget": {"const": "IncreaseBaseAgi"}, "currentTarget": {"const": "IncreaseCurrentAgi"}, "callOrder": {"const": ["GenerateRandomNumber", "IncreaseBaseAgi", "IncreaseCurrentAgi"]}}}]},
                "increaseHp": {"allOf": [{"$ref": "#/$defs/randomEffect"}, {"properties": {"address": {"const": 142178}, "textIds": {"const": [154]}, "baseTarget": {"const": "IncreaseMaxHp"}, "currentTarget": {"const": "IncreaseCurrentHp"}, "callOrder": {"const": ["GenerateRandomNumber", "IncreaseMaxHp", "IncreaseCurrentHp"]}}}]},
                "increaseMov": {
                  "type": "object", "additionalProperties": false,
                  "required": ["address", "baseTarget", "incrementsByBase", "callOrder", "textIds"],
                  "properties": {"address": {"const": 142118}, "baseTarget": {"const": "GetBaseMov"}, "incrementsByBase": {"const": [{"base": 9, "gain": 0}, {"base": 8, "gain": 1}, {"base": "default", "gain": 2}]}, "callOrder": {"const": ["GetBaseMov", "IncreaseBaseMov", "IncreaseCurrentMov"]}, "textIds": {"const": [153]}}
                },
                "increaseMp": {
                  "type": "object", "additionalProperties": false,
                  "required": ["address", "maxMpTarget", "zeroMaxMpBranch", "noUseTextId", "callOrder", "textIds"],
                  "properties": {"address": {"const": 142218}, "maxMpTarget": {"const": "GetMaxMp"}, "zeroMaxMpBranch": {"const": "beq"}, "noUseTextId": {"const": 148}, "callOrder": {"const": ["GetMaxMp", "GenerateRandomNumber", "IncreaseMaxMp", "IncreaseCurrentMp"]}, "textIds": {"const": [148, 155]}}
                },
                "levelUp": {
                  "type": "object", "additionalProperties": false,
                  "required": ["address", "setCurrentExpValue", "levelUpAddress", "argumentsAddress", "levelResultSentinel", "levelResultBranch", "zeroStatGainBranch", "spellSentinel", "spellSentinelBranch", "spellLevelBranch", "textIds"],
                  "properties": {"address": {"const": 142274}, "setCurrentExpValue": {"const": 0}, "levelUpAddress": {"const": 38020}, "argumentsAddress": {"const": 16756610}, "levelResultSentinel": {"const": -1}, "levelResultBranch": {"const": "bne"}, "zeroStatGainBranch": {"const": "beq"}, "spellSentinel": {"const": -1}, "spellSentinelBranch": {"const": "beq"}, "spellLevelBranch": {"const": "bne"}, "textIds": {"const": [148, 244, 266, 267, 268, 269, 270, 271, 272, 3523]}}
                },
                "dispatchOrder": {"$ref": "#/$defs/dispatchOrder"}
              }
            }
          }
        },
        "unknowns": {
          "type": "object", "additionalProperties": false,
          "required": ["natural-story-field-item-use-reachability", "caller-entry-state", "selected-item-member-slot", "actual-dispatch-target", "actual-status-clear-result", "actual-random-gain", "actual-movement-cap-result", "actual-zero-mp-rejection", "actual-level-up-result-and-spell-message-branch", "caller-item-removal-and-return", "persistence-across-map-save-story", "input-text-window-audio-vint-rendering"],
          "properties": {
            "natural-story-field-item-use-reachability": {"const": "Unknown"}, "caller-entry-state": {"const": "Unknown"}, "selected-item-member-slot": {"const": "Unknown"}, "actual-dispatch-target": {"const": "Unknown"}, "actual-status-clear-result": {"const": "Unknown"}, "actual-random-gain": {"const": "Unknown"}, "actual-movement-cap-result": {"const": "Unknown"}, "actual-zero-mp-rejection": {"const": "Unknown"}, "actual-level-up-result-and-spell-message-branch": {"const": "Unknown"}, "caller-item-removal-and-return": {"const": "Unknown"}, "persistence-across-map-save-story": {"const": "Unknown"}, "input-text-window-audio-vint-rendering": {"const": "Unknown"}
          }
        },
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceFiles", "h1RomAnchors", "callers", "unknowns"],
          "properties": {"sourceFiles": {"const": 8}, "h1RomAnchors": {"const": 14}, "callers": {"const": 2}, "unknowns": {"const": 12}}
        }
      }
    }
  },
  "$ref": "#/$defs/fixture"
}
