{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sf2-research.example/schemas/h2/common-stats-output.schema.json",
  "title": "Shining Force II common stats static inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "upstream",
    "scope",
    "summary",
    "indexedRecordIds",
    "indexedSourcePaths",
    "internalDirectCallTargets",
    "externalDirectCallTargets",
    "statsFacts",
    "alternateSources",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "sf2-common-stats-static-v1"
    },
    "upstream": {
      "type": "object"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "required": [
        "fileCount",
        "sourceLineCount",
        "statementCount",
        "globalLabelCount",
        "localLabelCount",
        "directCallSiteCount",
        "indirectCallSiteCount",
        "uniqueDirectTargetCount",
        "internalDirectTargetCount",
        "externalDirectTargetCount",
        "indexedRecordCount",
        "indexedFileCount",
        "excludedAlternateFileCount"
      ],
      "properties": {
        "fileCount": {
          "type": "integer",
          "minimum": 0
        },
        "indexedRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "indexedFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "excludedAlternateFileCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "indexedRecordIds": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "uniqueItems": true
    },
    "indexedSourcePaths": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true
    },
    "internalDirectCallTargets": {
      "type": "array",
      "uniqueItems": true
    },
    "externalDirectCallTargets": {
      "type": "array",
      "uniqueItems": true
    },
    "statsFacts": {
      "type": "object",
      "minProperties": 11,
      "maxProperties": 11,
      "required": [
        "combatantGetterContract",
        "combatantMutationContract",
        "combatantClampContract",
        "combatantDistanceContract"
      ],
      "properties": {
        "combatantGetterContract": {
          "$ref": "https://sf2-research.example/schemas/h2/common-stats-getters.schema.json"
        },
        "combatantMutationContract": {
          "$ref": "https://sf2-research.example/schemas/h2/common-stats-mutations.schema.json"
        },
        "combatantClampContract": {
          "$ref": "https://sf2-research.example/schemas/h2/common-stats-clamps.schema.json"
        },
        "combatantDistanceContract": {
          "$ref": "https://sf2-research.example/schemas/h2/common-stats-distance.schema.json"
        }
      }
    },
    "alternateSources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "files": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20
    }
  }
}
