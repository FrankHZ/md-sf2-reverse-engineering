      "type": "object", "additionalProperties": false, "required": ["angelWing", "angelWingId", "overworldMapRange", "angelWingCallOrder", "fieldUsabilityTarget", "IsItemUsableOnField", "usableFieldItemsAddress", "mapItemEventTarget", "RunMapSetupItemEvent", "targetUseTarget", "UseItemOnField", "branchOrder", "textIds"],
      "properties": {"angelWing": {"const": "ITEM_ANGEL_WING"}, "angelWingId": {"const": 4}, "overworldMapRange": {"const": [66, 78]}, "angelWingCallOrder": {"const": ["RemoveItemBySlot", "Egress"]}, "fieldUsabilityTarget": {"const": "IsItemUsableOnField"}, "IsItemUsableOnField": {"const": 141770}, "usableFieldItemsAddress": {"const": 141794}, "mapItemEventTarget": {"const": "RunMapSetupItemEvent"}, "RunMapSetupItemEvent": {"const": 292230}, "targetUseTarget": {"const": "UseItemOnField"}, "UseItemOnField": {"const": 141804}, "branchOrder": {"const": ["angelWing", "fieldUsability", "mapItemEvent", "targetUse"]}, "textIds": {"const": [73, 422]}}
