      "properties": {"FieldMenu": {"const": 135806}, "PopulateGenericListWithCurrentForceMembers": {"const": 137708}, "ExecuteDiamondMenu": {"const": 66038}, "MembersMain": {"const": 77798}, "MembersItem": {"const": 77828}, "MembersMagic": {"const": 77872}, "BuildMemberScreen": {"const": 72746}, "AltYesNoPrompt": {"const": 86668}, "IsItemUsableOnField": {"const": 141770}, "UseItemOnField": {"const": 141804}, "RunMapSetupItemEvent": {"const": 292230}, "GetSavepointForMap": {"const": 30188}, "CheckArea": {"const": 145506}, "UpdateForce": {"const": 39168}}
