{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sf2-research.example/schemas/h2/field-menu-control-static-fixture.schema.json",
  "title": "SF2 FieldMenu static control fixture",
  "$ref": "#/$defs/fixture",
  "$defs": {
    "sourceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "address", "width", "sha256"],
      "properties": {
        "id": {"type": "string"}, "address": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "endAddressExclusive": {"type": "integer", "minimum": 0}
      }
    },
    "retainedOwner": {
      "type": "object", "additionalProperties": false,
      "required": ["fixtureId", "fixtureSha256"],
      "properties": {
        "fixtureId": {"type": "string", "pattern": "^sf2-[a-z0-9-]+-v1$"},
        "fixtureSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "selectorMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["member", "magic", "item"],
      "properties": {"member": {"const": 0}, "magic": {"const": 1}, "item": {"const": 2}}
    },
    "itemSelectorMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["use", "give", "equip", "drop"],
      "properties": {"use": {"const": 0}, "give": {"const": 1}, "equip": {"const": 2}, "drop": {"const": "fallthrough"}}
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "id", "upstream", "romSha256", "system", "summary", "retainedOwners", "sourceContext", "fieldMenuSpine", "unknowns"],
      "properties": {
        "schemaVersion": {"const": 1},
        "id": {"const": "sf2-field-menu-control-static-v1"},
        "upstream": {
          "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
          "properties": {"repository": {"const": "https://github.com/ShiningForceCentral/SF2DISASM.git"}, "commit": {"const": "c834c652b6862bc5679fd7f69a38a7093206efc6"}}
        },
        "romSha256": {"const": "9ADF662D09881F58EC37D174AB01E87A7FCFB24700B5F84B26C0CD4F351509E9"},
        "system": {"const": "sf2-field-menu-control-static-v1"},
        "summary": {
          "type": "object", "additionalProperties": false, "required": ["sourceFiles", "h1RomAnchors", "unknowns"],
          "properties": {"sourceFiles": {"const": 9}, "h1RomAnchors": {"const": 23}, "unknowns": {"const": 18}}
        },
        "retainedOwners": {
          "type": "object", "additionalProperties": false,
          "required": ["commonMenus", "gameflowCore", "coreStatsData", "itemAuxiliary", "mapSetup", "techInterfaces", "commonStats"],
          "properties": {
            "commonMenus": {"$ref": "#/$defs/retainedOwner"}, "gameflowCore": {"$ref": "#/$defs/retainedOwner"},
            "coreStatsData": {"$ref": "#/$defs/retainedOwner"}, "itemAuxiliary": {"$ref": "#/$defs/retainedOwner"},
            "mapSetup": {"$ref": "#/$defs/retainedOwner"}, "techInterfaces": {"$ref": "#/$defs/retainedOwner"},
            "commonStats": {"$ref": "#/$defs/retainedOwner"}
          }
        },
        "sourceContext": {
          "type": "object", "additionalProperties": false, "required": ["sourceIdentities", "h1RomAnchors", "mainactionsShape"],
          "properties": {
            "sourceIdentities": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/sourceIdentity"}},
            "h1RomAnchors": {"type": "array", "minItems": 23, "maxItems": 23, "items": {"$ref": "#/$defs/anchor"}},
            "mainactionsShape": {
              "type": "object", "additionalProperties": false,
              "required": ["physicalLines", "nonEmptyLines", "statements", "globalLabels", "localLabels", "directCalls", "directCallTargets"],
              "properties": {"physicalLines": {"const": 696}, "nonEmptyLines": {"const": 679}, "statements": {"const": 481}, "globalLabels": {"const": 12}, "localLabels": {"const": 46}, "directCalls": {"const": 69}, "directCallTargets": {"const": 33}}
            }
          }
        },
        "fieldMenuSpine": {"$ref": "#/$defs/fieldMenuSpine"},
        "unknowns": {"$ref": "#/$defs/unknowns"}
      }
    },
    "fieldMenuSpine": {
      "type": "object", "additionalProperties": false,
      "required": ["functionAddresses", "jumpInterfaces", "entryAndCallers", "mainDispatch", "memberAction", "magicAction", "itemAction", "searchAction", "forceListHelper", "excludedUnusedTail"],
