      "type": "object", "additionalProperties": false, "required": ["branchOrder", "inventoryCapacity", "cursedGuardTargets", "exchangeCallOrder", "textIds"],
      "properties": {"branchOrder": {"const": ["selection", "equipmentType", "cursedGuards", "recipient", "give", "exchange"]}, "inventoryCapacity": {"const": 4}, "cursedGuardTargets": {"const": ["GetEquippedWeapon", "GetEquippedRing", "IsItemCursed"]}, "exchangeCallOrder": {"const": ["UnequipItemBySlotIfNotCursed", "DropItemBySlot", "AddItem", "RemoveItemBySlot", "AddItem"]}, "textIds": {"const": [55, 54, 74, 65, 66]}}
