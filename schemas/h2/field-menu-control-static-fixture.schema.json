    "forceListHelper": {
      "type": "object", "additionalProperties": false, "required": ["UpdateForce", "callOrder", "counter", "copyOrder"],
      "properties": {"UpdateForce": {"const": 39168}, "callOrder": {"const": ["UpdateForce", "TARGETS_LIST_LENGTH", "copyBytes", "DBF"]}, "counter": {"const": "TARGETS_LIST_LENGTH-1"}, "copyOrder": {"const": "TARGETS_LIST-to-GENERIC_LIST"}}
    },
    "excludedUnusedTail": {
      "type": "object", "additionalProperties": false, "required": ["tableAddress", "tableByteCount", "helperAddress", "helperByteCount"],
      "properties": {"tableAddress": {"const": 137750}, "tableByteCount": {"const": 6}, "helperAddress": {"const": 137756}, "helperByteCount": {"const": 30}}
    },
    "unknowns": {
      "type": "object", "additionalProperties": false,
      "required": ["natural-story-field-menu-reachability", "caller-entry-state", "actual-main-choice", "actual-member-selection-and-return", "actual-magic-selection-and-target", "actual-detox-status-outcome", "actual-egress-map-and-event-outcome", "actual-item-submenu-choice", "actual-item-use-selection-target-and-result", "actual-map-item-event-consumption", "actual-item-give-or-exchange", "actual-item-equip-result", "actual-item-drop-confirmation-and-result", "actual-search-area-result", "input-repeat-cancel-and-cadence", "window-cursor-portrait-text-sound-presentation", "persistence-across-map-save-story", "caller-return-state-and-vint-reactivation"],
      "properties": {
        "natural-story-field-menu-reachability": {"const": "Unknown"}, "caller-entry-state": {"const": "Unknown"}, "actual-main-choice": {"const": "Unknown"}, "actual-member-selection-and-return": {"const": "Unknown"}, "actual-magic-selection-and-target": {"const": "Unknown"}, "actual-detox-status-outcome": {"const": "Unknown"}, "actual-egress-map-and-event-outcome": {"const": "Unknown"}, "actual-item-submenu-choice": {"const": "Unknown"}, "actual-item-use-selection-target-and-result": {"const": "Unknown"}, "actual-map-item-event-consumption": {"const": "Unknown"}, "actual-item-give-or-exchange": {"const": "Unknown"}, "actual-item-equip-result": {"const": "Unknown"}, "actual-item-drop-confirmation-and-result": {"const": "Unknown"}, "actual-search-area-result": {"const": "Unknown"}, "input-repeat-cancel-and-cadence": {"const": "Unknown"}, "window-cursor-portrait-text-sound-presentation": {"const": "Unknown"}, "persistence-across-map-save-story": {"const": "Unknown"}, "caller-return-state-and-vint-reactivation": {"const": "Unknown"}
      }
