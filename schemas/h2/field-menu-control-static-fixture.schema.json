    "itemAction": {
      "type": "object", "additionalProperties": false, "required": ["menuConstant", "selectorMapping", "cancel", "use", "give", "equip", "drop"],
      "properties": {"menuConstant": {"const": "MENU_ITEM"}, "selectorMapping": {"$ref": "#/$defs/itemSelectorMapping"}, "cancel": {"const": -1}, "use": {"$ref": "#/$defs/itemUse"}, "give": {"$ref": "#/$defs/itemGive"}, "equip": {"$ref": "#/$defs/itemEquip"}, "drop": {"$ref": "#/$defs/itemDrop"}}
