{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sf2-research.example/schemas/h2/map-events-fixture-index.schema.json",
  "title": "Map events semantic fixture index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "upstreamCommit",
    "romSha256",
    "function",
    "fieldOrder",
    "shards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "sf2-map-events-static-v1"
    },
    "upstreamCommit": {
      "type": "string",
      "minLength": 1
    },
    "romSha256": {
      "type": "string",
      "minLength": 1
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RunMapSetupEntityEvent",
        "RunMapSetupZoneEvent",
        "RunMapSetupItemEvent"
      ],
      "properties": {
        "RunMapSetupEntityEvent": {
          "type": "integer",
          "minimum": 0
        },
        "RunMapSetupZoneEvent": {
          "type": "integer",
          "minimum": 0
        },
        "RunMapSetupItemEvent": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fieldOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shards": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "path",
          "fields"
        ],
        "properties": {
          "section": {
            "enum": [
              "routing-setup",
              "entity-programs",
              "zone-programs",
              "item-programs",
              "operation-vocabulary",
              "direct-flags",
              "script-invocation",
              "textbox",
              "sound-commands"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^tests/fixtures/h2/map-events/[a-z0-9-]+\\.json$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
