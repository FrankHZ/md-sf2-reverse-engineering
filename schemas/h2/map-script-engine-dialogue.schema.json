{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sf2-research.example/schemas/h2/map-script-engine-dialogue.schema.json",
  "title": "Map-script engine dialogue structural definitions",
  "definitions": {
    "cursorHandlerFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro",
        "handler",
        "address",
        "opcode",
        "cursorWrite"
      ],
      "properties": {
        "macro": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "address": {
          "type": "integer",
          "minimum": 0
        },
        "opcode": {
          "type": "integer",
          "minimum": 0
        },
        "cursorWrite": {
          "type": "string"
        }
      }
    },
    "dialogueCommandFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macros",
        "sourceInputSummary",
        "sourceSiteReferences",
        "programTotals",
        "operandFacts",
        "handlers",
        "portraitHelper",
        "callerBreakdown",
        "entityDialogueConsumer",
        "textLineDomain",
        "spriteDialogueTable",
        "runtimeQuestions"
      ],
      "properties": {
        "macros": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dialogueMacro"
          }
        },
        "sourceInputSummary": {
          "$ref": "#/definitions/dialogueSourceInputSummary"
        },
        "sourceSiteReferences": {
          "type": "array",
          "items": {
            "$ref": "https://sf2-research.example/schemas/h2/map-script-engine-core.schema.json#/definitions/sourceSiteReference"
          }
        },
        "programTotals": {
          "type": "array",
          "items": {
            "$ref": "https://sf2-research.example/schemas/h2/map-script-engine-core.schema.json#/definitions/programTotal"
          }
        },
        "operandFacts": {
          "$ref": "https://sf2-research.example/schemas/h2/map-script-engine-core.schema.json#/definitions/operandFacts"
        },
        "handlers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/displayHandlerFact"
              },
              {
                "$ref": "#/definitions/cursorHandlerFact"
              },
              {
                "$ref": "#/definitions/hideHandlerFact"
              }
            ]
          }
        },
        "portraitHelper": {
          "$ref": "#/definitions/portraitHelper"
        },
        "callerBreakdown": {
          "$ref": "https://sf2-research.example/schemas/h2/map-script-engine-core.schema.json#/definitions/callerBreakdown"
        },
        "entityDialogueConsumer": {
          "$ref": "#/definitions/entityDialogueConsumer"
        },
        "textLineDomain": {
          "$ref": "#/definitions/textLineDomain"
        },
        "spriteDialogueTable": {
          "$ref": "#/definitions/spriteDialogueTable"
        },
        "runtimeQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dialogueConstants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "COMBATANT_MASK_ALL",
        "ENTITY_NONE"
      ],
      "properties": {
        "COMBATANT_MASK_ALL": {
          "type": "integer",
          "minimum": 0
        },
        "ENTITY_NONE": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dialogueMacro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "opcode",
        "encodedBytes",
        "operandBytes",
        "operandLayout",
        "parameterOrdinals",
        "handler",
        "handlerAddress",
        "sourceCommandCount"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "opcode": {
          "type": "integer",
          "minimum": 0
        },
        "encodedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "operandBytes": {
          "type": "integer",
          "minimum": 0
        },
        "operandLayout": {
          "type": "array",
          "items": {
            "$ref": "https://sf2-research.example/schemas/h2/map-script-engine-core.schema.json#/definitions/emissionRow"
          }
        },
        "parameterOrdinals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "handler": {
          "type": "string"
        },
        "handlerAddress": {
          "type": "integer",
          "minimum": 0
        },
        "sourceCommandCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dialogueMacroCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nextSingleText",
        "nextSingleTextVar",
        "nextText",
        "nextTextVar",
        "textCursor",
        "hideText"
      ],
      "properties": {
        "nextSingleText": {
          "type": "integer",
          "minimum": 0
        },
        "nextSingleTextVar": {
          "type": "integer",
          "minimum": 0
        },
        "nextText": {
          "type": "integer",
          "minimum": 0
        },
        "nextTextVar": {
          "type": "integer",
          "minimum": 0
        },
        "textCursor": {
          "type": "integer",
          "minimum": 0
        },
        "hideText": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dialogueSourceInputSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "sha256"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        }
      }
    },
    "displayHandlerFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro",
        "handler",
        "address",
        "opcode",
        "skipGuard",
        "modifierEntityWordSentinel",
        "nameWordDestinationCount",
        "displayThenIndexIncrement",
        "singleCloseSleepSequence"
      ],
      "properties": {
        "macro": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "address": {
          "type": "integer",
          "minimum": 0
        },
        "opcode": {
          "type": "integer",
          "minimum": 0
        },
        "skipGuard": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/skipGuard"
            }
          ]
        },
        "modifierEntityWordSentinel": {
          "$ref": "#/definitions/modifierEntityWordSentinel"
        },
        "nameWordDestinationCount": {
          "type": "integer",
          "minimum": 0
        },
        "displayThenIndexIncrement": {
          "type": "boolean"
        },
        "singleCloseSleepSequence": {
          "type": "boolean"
        }
      }
    },
    "entityDialogueConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "address",
        "sourcePath",
        "lowDomainMask",
        "mapSpriteLoad"
      ],
      "properties": {
        "function": {
          "type": "string"
        },
        "address": {
          "type": "integer",
          "minimum": 0
        },
        "sourcePath": {
          "type": "string"
        },
        "lowDomainMask": {
          "$ref": "#/definitions/lowDomainMask"
        },
        "mapSpriteLoad": {
          "type": "string"
        }
      }
    },
    "hideHandlerFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro",
        "handler",
        "address",
        "opcode",
        "closeThenClear"
      ],
      "properties": {
        "macro": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "address": {
          "type": "integer",
          "minimum": 0
        },
        "opcode": {
          "type": "integer",
          "minimum": 0
        },
        "closeThenClear": {
          "type": "boolean"
        }
      }
    },
    "lowDomainMask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constant",
        "value"
      ],
      "properties": {
        "constant": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "modifierBitTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bit",
        "destination"
      ],
      "properties": {
        "bit": {
          "type": "integer",
          "minimum": 0
        },
        "destination": {
          "type": "string"
        }
      }
    },
    "modifierEntityWordSentinel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unsignedValue",
        "signedValue",
        "branch"
      ],
      "properties": {
        "unsignedValue": {
          "type": "integer",
          "minimum": 0
        },
        "signedValue": {
          "type": "integer"
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "modifierSourceLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modifierByteValue",
        "sourceLabel",
        "handlerWordBit"
      ],
      "properties": {
        "modifierByteValue": {
          "type": "integer",
          "minimum": 0
        },
        "sourceLabel": {
          "type": "string"
        },
        "handlerWordBit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "portraitHelper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handler",
        "address",
        "sourcePath",
        "modifierEntityWordRead",
        "handlerTestedModifierByteMask",
        "modifierBitTests"
      ],
      "properties": {
        "handler": {
          "type": "string"
        },
        "address": {
          "type": "integer",
          "minimum": 0
        },
        "sourcePath": {
          "type": "string"
        },
        "modifierEntityWordRead": {
          "type": "string"
        },
        "modifierBitTests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/modifierBitTest"
          }
        },
        "handlerTestedModifierByteMask": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skipGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate",
        "branch"
      ],
      "properties": {
        "predicate": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "spriteDialogueTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "upstreamCommit",
        "romSha256",
        "tableAddress",
        "consumerAddress",
        "rowCount",
        "recordByteCount",
        "tableByteCount",
        "sourcePath"
      ],
      "properties": {
        "contractId": {
          "type": "string"
        },
        "upstreamCommit": {
          "type": "string"
        },
        "romSha256": {
          "type": "string"
        },
        "tableAddress": {
          "type": "integer",
          "minimum": 0
        },
        "consumerAddress": {
          "type": "integer",
          "minimum": 0
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "recordByteCount": {
          "type": "integer",
          "minimum": 0
        },
        "tableByteCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourcePath": {
          "type": "string"
        }
      }
    },
    "textCursorValueBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum",
        "domainMinimum",
        "domainMaximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        },
        "domainMinimum": {
          "type": "integer",
          "minimum": 0
        },
        "domainMaximum": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "textLineDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "upstreamCommit",
        "romSha256",
        "sourcePath",
        "lineIdCount",
        "firstLineId",
        "lastLineId",
        "idsAreContiguous"
      ],
      "properties": {
        "contractId": {
          "type": "string"
        },
        "upstreamCommit": {
          "type": "string"
        },
        "romSha256": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        },
        "lineIdCount": {
          "type": "integer",
          "minimum": 0
        },
        "firstLineId": {
          "type": "integer",
          "minimum": 0
        },
        "lastLineId": {
          "type": "integer",
          "minimum": 0
        },
        "idsAreContiguous": {
          "type": "boolean"
        }
      }
    }
  }
}
