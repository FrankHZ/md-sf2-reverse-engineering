{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SF2 EXP command boundary fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "battleId", "observationBoundary", "function", "ram", "harness", "actor", "target", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-exp-command-boundaries-v1" },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "core"],
      "properties": { "name": { "const": "BizHawk" }, "version": { "type": "string" }, "core": { "const": "Genesis Plus GX" } }
    },
    "battleId": { "type": "integer", "minimum": 0 },
    "observationBoundary": { "type": "string", "minLength": 1 },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["giveExpEntryAddress", "giveExpAppliedAddress", "giveExpReturnAddress", "levelUpEntryAddress", "levelUpReturnAddress"],
      "properties": {
        "giveExpEntryAddress": { "type": "integer", "minimum": 0 },
        "giveExpAppliedAddress": { "type": "integer", "minimum": 0 },
        "giveExpReturnAddress": { "type": "integer", "minimum": 0 },
        "levelUpEntryAddress": { "type": "integer", "minimum": 0 },
        "levelUpReturnAddress": { "type": "integer", "minimum": 0 }
      }
    },
    "ram": {
      "type": "object", "additionalProperties": false,
      "required": ["combatantDataAddress", "combatantEntrySize", "levelUpArgumentsAddress", "seedAddress"],
      "properties": {
        "combatantDataAddress": { "type": "integer", "minimum": 0 },
        "combatantEntrySize": { "type": "integer", "minimum": 1 },
        "levelUpArgumentsAddress": { "type": "integer", "minimum": 0 },
        "seedAddress": { "type": "integer", "minimum": 0 }
      }
    },
    "harness": {
      "type": "object", "additionalProperties": false,
      "required": ["function", "ram"],
      "properties": {
        "function": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 0 } },
        "ram": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "actor": { "type": "integer", "minimum": 0, "maximum": 255 },
    "target": { "type": "integer", "minimum": 0, "maximum": 255 },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "classCode", "class", "level", "initialExp", "commandExp", "expAfterIncrease", "levelUpCalls", "finalLevel", "finalExp"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classCode": { "type": "string", "minLength": 1 },
          "class": { "type": "integer", "minimum": 0, "maximum": 255 },
          "level": { "type": "integer", "minimum": 0, "maximum": 255 },
          "initialExp": { "type": "integer", "minimum": 0, "maximum": 255 },
          "commandExp": { "type": "integer", "minimum": 0, "maximum": 32767 },
          "expAfterIncrease": { "type": "integer", "minimum": 0, "maximum": 255 },
          "levelUpCalls": { "type": "integer", "minimum": 0, "maximum": 1 },
          "levelUpResult": { "type": "integer", "minimum": 0, "maximum": 255 },
          "finalLevel": { "type": "integer", "minimum": 0, "maximum": 255 },
          "finalExp": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    }
  }
}
