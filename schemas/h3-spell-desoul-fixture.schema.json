{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/h3-spell-desoul-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "battleId", "observationBoundary", "sharedHarnessFixture", "sharedStatusFixture", "function", "ram", "case", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-desoul-instant-death-v1" },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "core"],
      "properties": { "name": { "const": "BizHawk" }, "version": { "const": "2.11.1" }, "core": { "const": "Genesis Plus GX" } }
    },
    "battleId": { "const": 1 },
    "observationBoundary": { "type": "string", "minLength": 1 },
    "sharedHarnessFixture": { "const": "tests/fixtures/h3/spell-damage-resistance-v1.json" },
    "sharedStatusFixture": { "const": "tests/fixtures/h3/spell-status-sleep-v1.json" },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["desoulEffectEntryAddress", "effectivenessEntryAddress", "effectivenessRollAddress", "effectivenessFailureAddress", "effectivenessSuccessAddress", "killExpGoldAppliedAddress", "targetDiesAppliedAddress"],
      "properties": {
        "desoulEffectEntryAddress": { "const": 46358 },
        "effectivenessEntryAddress": { "const": 47768 },
        "effectivenessRollAddress": { "const": 47784 },
        "effectivenessFailureAddress": { "const": 47820 },
        "effectivenessSuccessAddress": { "const": 47826 },
        "killExpGoldAppliedAddress": { "const": 43322 },
        "targetDiesAppliedAddress": { "const": 46460 }
      }
    },
    "ram": {
      "type": "object", "additionalProperties": false,
      "required": ["battleSceneGoldAddress", "currentGoldAddress"],
      "properties": { "battleSceneGoldAddress": { "const": 16758314 }, "currentGoldAddress": { "const": 16774656 } }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "actor", "actorClass", "actorLevel", "initialMp", "actorInitialExp", "actionType", "actionSpell", "spellMpCost", "baseThreshold", "seed", "targets"],
      "properties": {
        "id": { "const": "bowie-desoul1-four-status-resistance-settings" },
        "actor": { "const": 0 }, "actorClass": { "const": 0 }, "actorLevel": { "const": 1 },
        "initialMp": { "const": 20 }, "actorInitialExp": { "const": 0 },
        "actionType": { "const": 1 }, "actionSpell": { "const": 8 }, "spellMpCost": { "const": 8 },
        "baseThreshold": { "const": 5 }, "seed": { "const": 4660 },
        "targets": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": { "$ref": "#/definitions/target" }
        }
      }
    },
    "expected": { "$ref": "#/definitions/expected" }
  },
  "definitions": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["combatant", "level", "maxHp", "initialHp", "resistanceWord", "setting", "enemyIndex", "gold"],
      "properties": {
        "combatant": { "type": "integer", "minimum": 128, "maximum": 131 },
        "level": { "const": 1 }, "maxHp": { "const": 100 }, "initialHp": { "const": 100 },
        "resistanceWord": { "type": "integer", "minimum": 0, "maximum": 49152 },
        "setting": { "type": "integer", "minimum": 0, "maximum": 3 },
        "enemyIndex": { "const": 0 }, "gold": { "const": 10 }
      }
    },
    "constructionRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["combatant", "setting", "threshold", "roll", "success", "reactionEmitted", "accumulatedExp", "accumulatedGold", "targetDiesFlag", "targetHp"],
      "properties": {
        "combatant": { "type": "integer" }, "setting": { "type": "integer" }, "threshold": { "type": "integer" },
        "roll": { "const": 7 }, "success": { "type": "boolean" }, "reactionEmitted": { "type": "boolean" },
        "accumulatedExp": { "type": "integer" }, "accumulatedGold": { "type": "integer" },
        "targetDiesFlag": { "type": "integer" }, "targetHp": { "const": 100 }
      }
    },
    "allyReaction": {
      "type": "object", "additionalProperties": false,
      "required": ["combatant", "mpChange", "mpBefore", "mpAfter"],
      "properties": { "combatant": { "const": 0 }, "mpChange": { "const": -8 }, "mpBefore": { "const": 20 }, "mpAfter": { "const": 12 } }
    },
    "enemyReaction": {
      "type": "object", "additionalProperties": false,
      "required": ["combatant", "hpChange", "hpBefore", "hpAfter"],
      "properties": { "combatant": { "type": "integer" }, "hpChange": { "const": -32768 }, "hpBefore": { "const": 100 }, "hpAfter": { "const": 0 } }
    },
    "award": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "halved", "firstRoll", "secondRoll", "commandExp", "commandGold"],
      "properties": { "seed": { "const": 60587 }, "halved": { "const": 24 }, "firstRoll": { "const": 0 }, "secondRoll": { "const": 3 }, "commandExp": { "const": 25 }, "commandGold": { "const": 30 } }
    },
    "expReaction": {
      "type": "object", "additionalProperties": false,
      "required": ["commandExp", "expBefore", "expAfter"],
      "properties": { "commandExp": { "const": 25 }, "expBefore": { "const": 0 }, "expAfter": { "const": 25 } }
    },
    "goldReaction": {
      "type": "object", "additionalProperties": false,
      "required": ["commandGold", "goldBefore", "goldAfter"],
      "properties": { "commandGold": { "const": 30 }, "goldBefore": { "const": 0 }, "goldAfter": { "const": 30 } }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["construction", "replay"],
      "properties": {
        "construction": {
          "type": "object", "additionalProperties": false,
          "required": ["records", "accumulatedExp", "accumulatedGold", "actorMp", "award"],
          "properties": {
            "records": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/definitions/constructionRecord" } },
            "accumulatedExp": { "const": 49 }, "accumulatedGold": { "const": 30 }, "actorMp": { "const": 20 }, "award": { "$ref": "#/definitions/award" }
          }
        },
        "replay": {
          "type": "object", "additionalProperties": false,
          "required": ["reactionOrder", "allyReaction", "enemyReactions", "expReaction", "goldReaction", "finalActorMp", "finalActorExp", "finalTargetHp", "finalGold"],
          "properties": {
            "reactionOrder": { "const": ["ally:-8", "enemy:-32768", "enemy:-32768", "enemy:-32768"] },
            "allyReaction": { "$ref": "#/definitions/allyReaction" },
            "enemyReactions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/definitions/enemyReaction" } },
            "expReaction": { "$ref": "#/definitions/expReaction" }, "goldReaction": { "$ref": "#/definitions/goldReaction" },
            "finalActorMp": { "const": 12 }, "finalActorExp": { "const": 25 }, "finalTargetHp": { "const": [0, 0, 0, 100] }, "finalGold": { "const": 30 }
          }
        }
      }
    }
  }
}
