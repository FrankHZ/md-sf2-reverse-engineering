{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/variable-width-font-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "table", "summary", "font", "pointer", "asciiMap", "storedWidthHistogram", "glyphs", "consumerFacts", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-variable-width-font-static-v1" },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": { "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "table": { "type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "summary": { "type": "object", "minProperties": 22, "maxProperties": 22, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "font": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "sourcePath", "ownerPath", "formatNotePath", "address", "byteCount", "sha256", "formatNoteSha256"],
      "properties": {
        "symbol": { "const": "font_VariableWidth" }, "sourcePath": { "type": "string" },
        "ownerPath": { "type": "string" }, "formatNotePath": { "type": "string" },
        "address": { "type": "integer", "minimum": 0 }, "byteCount": { "const": 2560 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "formatNoteSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "pointer": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "sourcePath", "address", "targetSymbol", "targetAddress", "byteCount", "sha256"],
      "properties": {
        "symbol": { "const": "p_font_VariableWidth" }, "sourcePath": { "type": "string" },
        "address": { "type": "integer", "minimum": 0 }, "targetSymbol": { "const": "font_VariableWidth" },
        "targetAddress": { "type": "integer", "minimum": 0 }, "byteCount": { "const": 4 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "asciiMap": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "sourcePath", "address", "entryCount", "uniqueGlyphCount", "defaultGlyphId", "defaultGlyphCount", "missingGlyphIds", "sha256"],
      "properties": {
        "symbol": { "const": "table_AsciiToTextSymbolMap" }, "sourcePath": { "type": "string" },
        "address": { "type": "integer", "minimum": 0 }, "entryCount": { "const": 256 },
        "uniqueGlyphCount": { "type": "integer", "minimum": 1, "maximum": 80 },
        "defaultGlyphId": { "const": 1 }, "defaultGlyphCount": { "type": "integer", "minimum": 1 },
        "missingGlyphIds": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 80 } },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "storedWidthHistogram": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 1 } },
    "glyphs": {
      "type": "array", "minItems": 80, "maxItems": 80,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["symbolId", "address", "storedWidth", "advancePixels", "setPixelCount", "rowsWithPixels", "hasAdvanceOverhang", "sha256"],
        "properties": {
          "symbolId": { "type": "integer", "minimum": 1, "maximum": 80 },
          "address": { "type": "integer", "minimum": 0 }, "storedWidth": { "type": "integer", "minimum": 0, "maximum": 15 },
          "advancePixels": { "type": "integer", "minimum": 0, "maximum": 16 }, "setPixelCount": { "type": "integer", "minimum": 0, "maximum": 180 },
          "rowsWithPixels": { "type": "integer", "minimum": 0, "maximum": 15 }, "hasAdvanceOverhang": { "type": "boolean" },
          "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
        }
      }
    },
    "consumerFacts": { "type": "object", "minProperties": 10, "maxProperties": 10 },
    "runtimeQuestions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
  }
}
