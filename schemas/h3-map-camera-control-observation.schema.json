        "handlerReturned": {
          "const": true
        },
        "setCameraDestinationCallObserved": {
          "const": true
        },
        "setViewDestinationCallObserved": {
          "const": true
        },
        "waitForViewScrollEndCallObserved": {
          "const": true
        },
        "waitCompletedBeforeHandlerReturn": {
          "const": true
        },
        "callbackOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "speedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "handlerAddress",
        "operandWord",
        "viewScrollingSpeedWordAfter",
        "handlerReturned",
        "callbackOrder"
