      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "handlerAddress",
        "setCameraDestinationCallSiteAddress",
        "waitForViewScrollEndCallSiteAddress",
        "setCameraDestinationServiceAddress",
        "setViewDestinationAddress",
        "setViewDestinationCallSiteAddress",
        "inputWords",
        "setViewDestinationD0Word",
        "setViewDestinationD1Word",
        "viewTargetEntityByteAfter",
        "handlerReturned",
        "setCameraDestinationCallObserved",
        "setViewDestinationCallObserved",
        "waitForViewScrollEndCallObserved",
