        },
        "setViewDestinationD0Word": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "setViewDestinationD1Word": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "viewTargetEntityByteAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
