        },
        {
          "$ref": "#/$defs/speedRecord"
        }
      ]
    },
    "targetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "targetMode",
        "handlerAddress",
        "operandWord",
        "targetEntityLookupAddress",
        "entityIndexListLookupIndex",
        "viewTargetEntityByteAfter",
        "handlerReturned",
        "entityIndexListLookupExecuted",
        "callbackOrder"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "target"
        },
        "targetMode": {
          "enum": [
            "negative-direct",
            "ally-index",
            "enemy-index"
          ]
        },
        "handlerAddress": {
          "type": "integer",
          "minimum": 0
        },
        "operandWord": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "targetEntityLookupAddress": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "entityIndexListLookupIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "viewTargetEntityByteAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "handlerReturned": {
          "const": true
        },
        "entityIndexListLookupExecuted": {
          "type": "boolean"
        },
        "callbackOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "destinationRecord": {
