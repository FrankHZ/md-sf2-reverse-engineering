          "type": "integer",
          "minimum": 0
        },
        "waitForViewScrollEndCallSiteAddress": {
          "type": "integer",
          "minimum": 0
        },
        "setCameraDestinationServiceAddress": {
          "type": "integer",
          "minimum": 0
        },
        "setViewDestinationAddress": {
          "type": "integer",
          "minimum": 0
        },
        "setViewDestinationCallSiteAddress": {
          "type": "integer",
          "minimum": 0
        },
        "inputWords": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
