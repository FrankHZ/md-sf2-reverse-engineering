{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sf2:h3:church-save-lifecycle-fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "romSha256", "system", "caseOrder", "cases", "sourceContext", "acceptedObservation"],
  "properties": {
    "id": {"$ref": "#/definitions/nonEmptyString"},
    "romSha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "system": {"$ref": "#/definitions/nonEmptyString"},
    "caseOrder": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/nonEmptyString"}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/case"}},
    "sourceContext": {"$ref": "#/definitions/sourceContext"},
    "acceptedObservation": {"$ref": "urn:sf2:h3:church-save-lifecycle-observation"}
  },
  "definitions": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "pc": {"type": "integer", "minimum": 0, "maximum": 16777215},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "action", "selector", "currentMap", "flag399InitiallySet", "promptResults", "terminal"],
      "properties": {
        "caseId": {"$ref": "#/definitions/nonEmptyString"},
        "action": {"type": "integer", "minimum": -32768, "maximum": 65535},
        "selector": {"type": "integer", "minimum": -32768, "maximum": 65535},
        "currentMap": {"type": "integer", "minimum": 0, "maximum": 255},
        "flag399InitiallySet": {"type": "boolean"},
        "promptResults": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": -32768, "maximum": 65535}},
        "terminal": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["churchMenuEntryAddress"],
      "properties": {"churchMenuEntryAddress": {"$ref": "#/definitions/pc"}}
    }
  }
}
