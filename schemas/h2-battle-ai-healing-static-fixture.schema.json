        "determineSpellLevelEntryAddress": { "const": 52584 },
        "healTargetPriorityEntryAddress": { "const": 52714 },
        "halfHpEntryAddress": { "const": 53910 },
        "movetypePriorityTableAddress": { "const": 55540 }
      }
