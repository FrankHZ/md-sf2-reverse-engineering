{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/enemy-map-sprites-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "table", "summary", "romRange", "definitionRows", "tailRows", "tailFacts", "normalSourceDomain", "consumerRules", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-enemy-map-sprites-static-v1" },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "table": { "type": "object", "minProperties": 2, "maxProperties": 2, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "summary": { "type": "object", "minProperties": 14, "maxProperties": 14, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "romRange": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "start", "endExclusive", "sha256"],
      "properties": {
        "sourcePath": { "const": "data/stats/enemies/enemymapsprites.asm" },
        "start": { "type": "integer", "minimum": 0 },
        "endExclusive": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "definitionRows": { "type": "array", "minItems": 103, "maxItems": 103, "items": { "$ref": "#/$defs/definitionRow" } },
    "tailRows": { "type": "array", "minItems": 63, "maxItems": 63, "items": { "$ref": "#/$defs/tailRow" } },
    "tailFacts": { "type": "object", "minProperties": 7, "maxProperties": 7 },
    "normalSourceDomain": {
      "type": "object", "additionalProperties": false,
      "required": ["enemyDefinitionIndexRange", "battleSpritesetMissingEnemyIndexes", "upgradeRanges", "onlyNamedSetterCaller"],
      "properties": {
        "enemyDefinitionIndexRange": { "type": "object", "minProperties": 2, "maxProperties": 2 },
        "battleSpritesetMissingEnemyIndexes": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "integer" } },
        "upgradeRanges": { "type": "array", "minItems": 5, "maxItems": 5 },
        "onlyNamedSetterCaller": { "type": "string" }
      }
    },
    "consumerRules": { "type": "object", "minProperties": 4, "maxProperties": 4 },
    "runtimeQuestions": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string" } }
  },
  "$defs": {
    "namedValue": {
      "type": "object", "additionalProperties": false, "required": ["code", "value"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "value": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "definitionRow": {
      "type": "object", "additionalProperties": false,
      "required": ["enemyIndex", "enemyCode", "mapSprite"],
      "properties": {
        "enemyIndex": { "type": "integer", "minimum": 0, "maximum": 102 },
        "enemyCode": { "type": "string", "minLength": 1 },
        "mapSprite": { "$ref": "#/$defs/namedValue" }
      }
    },
    "tailRow": {
      "type": "object", "additionalProperties": false,
      "required": ["tableIndex", "mapSprite"],
      "properties": {
        "tableIndex": { "type": "integer", "minimum": 103, "maximum": 165 },
        "mapSprite": { "$ref": "#/$defs/namedValue" }
      }
    }
  }
}
