{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/special-screen-graphics-decode.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "function", "table", "summary", "transferBoundaries", "resources", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-special-screen-graphics-decode-v1" },
    "upstream": { "type": "object", "required": ["repository", "commit"] },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "function": { "$ref": "#/$defs/counts" },
    "table": { "$ref": "#/$defs/counts" },
    "summary": { "$ref": "#/$defs/counts" },
    "transferBoundaries": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": { "$ref": "#/$defs/transfer" }
    },
    "resources": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["symbol", "sourcePath", "definitionPath", "sourceAddress", "compressedBytes", "inputBitsConsumed", "trailingBits", "decodedBytes", "sourceSha256", "decodedSha256", "commandGroupCount", "literalWordCount", "copyCommandCount", "copiedWordCount", "maximumCopyOffsetWords", "maximumCopyLengthWords", "consumerPath", "consumerSymbol", "pointerSymbol", "pointerAddress", "transferMethod", "transferBytes", "transferPaddingBytes"],
        "properties": {
          "symbol": { "type": "string" }, "sourcePath": { "type": "string" },
          "definitionPath": { "type": "string" }, "sourceAddress": { "type": "integer", "minimum": 0 },
          "compressedBytes": { "type": "integer", "minimum": 1 },
          "inputBitsConsumed": { "type": "integer", "minimum": 1 },
          "trailingBits": { "type": "integer", "minimum": 0 },
          "decodedBytes": { "type": "integer", "minimum": 1 },
          "sourceSha256": { "$ref": "#/$defs/hash" }, "decodedSha256": { "$ref": "#/$defs/hash" },
          "commandGroupCount": { "type": "integer", "minimum": 1 },
          "literalWordCount": { "type": "integer", "minimum": 0 },
          "copyCommandCount": { "type": "integer", "minimum": 0 },
          "copiedWordCount": { "type": "integer", "minimum": 0 },
          "maximumCopyOffsetWords": { "type": "integer", "minimum": 0 },
          "maximumCopyLengthWords": { "type": "integer", "minimum": 0 },
          "consumerPath": { "type": "string" }, "consumerSymbol": { "type": "string" },
          "pointerSymbol": { "type": ["string", "null"] },
          "pointerAddress": { "type": ["integer", "null"], "minimum": 0 },
          "transferMethod": { "type": "string" },
          "transferBytes": { "type": ["integer", "null"], "minimum": 0 },
          "transferPaddingBytes": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "runtimeQuestions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "transfer": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "decodedBytes", "transferMethod", "transferBytes", "transferPaddingBytes"],
      "properties": {
        "symbol": { "type": "string" }, "decodedBytes": { "type": "integer", "minimum": 1 },
        "transferMethod": { "type": "string" },
        "transferBytes": { "type": ["integer", "null"], "minimum": 0 },
        "transferPaddingBytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
