{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/h3-double-validation-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "battleId", "scenario", "function", "setup", "cases", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-double-validation-gates-v1" },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "core"],
      "properties": { "name": { "const": "BizHawk" }, "version": { "const": "2.11.1" }, "core": { "const": "Genesis Plus GX" } }
    },
    "battleId": { "const": 1 },
    "scenario": { "const": "double-validation" },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["calculateDamageEntryAddress", "validateDoubleEntryAddress", "validateDoubleClearAddress", "validateDoubleReturnAddress"],
      "properties": {
        "calculateDamageEntryAddress": { "const": 43966 },
        "validateDoubleEntryAddress": { "const": 42078 },
        "validateDoubleClearAddress": { "const": 42118 },
        "validateDoubleReturnAddress": { "const": 42140 }
      }
    },
    "setup": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "target", "targetLandEffect", "dodgeSeed", "forcedValidationToggles"],
      "properties": {
        "actor": { "$ref": "#/definitions/actor" },
        "target": { "$ref": "#/definitions/target" },
        "targetLandEffect": { "const": 2 },
        "dodgeSeed": { "const": 65535 },
        "forcedValidationToggles": {
          "type": "object", "additionalProperties": false, "required": ["double", "counter"],
          "properties": { "double": { "const": true }, "counter": { "const": false } }
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "muddled", "sameSide"],
        "properties": {
          "name": { "enum": ["muddled-actor", "same-side"] },
          "muddled": { "type": "boolean" },
          "sameSide": { "type": "boolean" }
        }
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["firstDamage", "targetDies", "naturalMuddled", "naturalSameSide", "doubleBefore", "doubleAfter", "damageCalls", "targetHp"],
      "properties": {
        "firstDamage": { "const": 18 },
        "targetDies": { "const": false },
        "naturalMuddled": { "const": false },
        "naturalSameSide": { "const": false },
        "doubleBefore": { "const": true },
        "doubleAfter": { "const": false },
        "damageCalls": { "const": 1 },
        "targetHp": { "const": 182 }
      }
    }
  },
  "definitions": {
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["combatant", "hp", "attack", "defense", "movetype", "prowess"],
      "properties": { "combatant": { "const": 0 }, "hp": { "const": 200 }, "attack": { "const": 50 }, "defense": { "const": 30 }, "movetype": { "const": 0 }, "prowess": { "const": 56 } }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["combatant", "hp", "attack", "defense", "movetype", "prowess"],
      "properties": { "combatant": { "const": 128 }, "hp": { "const": 200 }, "attack": { "const": 40 }, "defense": { "const": 20 }, "movetype": { "const": 6 }, "prowess": { "const": 200 } }
    }
  }
}
