{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shining Force II common stats static inventory",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "scope", "summary", "indexedRecordIds", "indexedSourcePaths", "internalDirectCallTargets", "externalDirectCallTargets", "statsFacts", "alternateSources", "files"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "sf2-common-stats-static-v1" },
    "upstream": { "type": "object" }, "scope": { "const": "code/common/stats" },
    "summary": { "type": "object", "required": ["fileCount", "sourceLineCount", "statementCount", "globalLabelCount", "localLabelCount", "directCallSiteCount", "indirectCallSiteCount", "uniqueDirectTargetCount", "internalDirectTargetCount", "externalDirectTargetCount", "indexedRecordCount", "indexedFileCount", "excludedAlternateFileCount"], "properties": { "fileCount": { "const": 20 }, "indexedRecordCount": { "const": 21 }, "indexedFileCount": { "const": 17 }, "excludedAlternateFileCount": { "const": 3 } } },
    "indexedRecordIds": { "type": "array", "minItems": 21, "maxItems": 21, "uniqueItems": true },
    "indexedSourcePaths": { "type": "array", "minItems": 17, "maxItems": 17, "uniqueItems": true },
    "internalDirectCallTargets": { "type": "array", "uniqueItems": true },
    "externalDirectCallTargets": { "type": "array", "uniqueItems": true },
    "statsFacts": { "type": "object", "minProperties": 7, "maxProperties": 7 },
    "alternateSources": { "type": "array", "minItems": 3, "maxItems": 3 },
    "files": { "type": "array", "minItems": 20, "maxItems": 20 }
  }
}
