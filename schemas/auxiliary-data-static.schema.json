{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shining Force II auxiliary graphics, scripting, and technical data inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "upstream", "scope", "summary", "inventoryPaths",
    "layoutOwnedPaths", "excludedPaths", "exclusions", "indexedRecordIds",
    "indexedSourcePaths", "indexedRecordsBySourcePath", "representativeSymbols",
    "representativeAddresses", "facts", "runtimeQuestions", "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-auxiliary-data-static-v1" },
    "upstream": { "$ref": "#/definitions/upstream" },
    "scope": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^data/" }
    },
    "summary": { "$ref": "#/definitions/summary" },
    "inventoryPaths": {
      "type": "array", "minItems": 65, "maxItems": 65, "uniqueItems": true,
      "items": { "$ref": "#/definitions/sourcePath" }
    },
    "layoutOwnedPaths": {
      "type": "array", "minItems": 63, "maxItems": 63, "uniqueItems": true,
      "items": { "$ref": "#/definitions/sourcePath" }
    },
    "excludedPaths": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": { "$ref": "#/definitions/sourcePath" }
    },
    "exclusions": {
      "type": "object", "minProperties": 2, "maxProperties": 2,
      "patternProperties": {
        "^data/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.asm$": {
          "type": "string", "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "indexedRecordIds": {
      "type": "array", "minItems": 80, "maxItems": 80, "uniqueItems": true,
      "items": { "$ref": "#/definitions/recordId" }
    },
    "indexedSourcePaths": {
      "type": "array", "minItems": 63, "maxItems": 63, "uniqueItems": true,
      "items": { "$ref": "#/definitions/sourcePath" }
    },
    "indexedRecordsBySourcePath": {
      "type": "array", "minItems": 63, "maxItems": 63,
      "items": { "$ref": "#/definitions/indexedRecordsBySourcePath" }
    },
    "representativeSymbols": {
      "type": "object", "minProperties": 63, "maxProperties": 63,
      "patternProperties": {
        "^data/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.asm$": {
          "type": "string", "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "representativeAddresses": {
      "type": "object", "minProperties": 63, "maxProperties": 63,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "facts": { "$ref": "#/definitions/facts" },
    "runtimeQuestions": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "files": {
      "type": "array", "minItems": 65, "maxItems": 65,
      "items": { "$ref": "#/definitions/sourceFile" }
    }
  },
  "definitions": {
    "recordId": {
      "type": "string", "pattern": "^[a-z0-9.-]+$"
    },
    "sourcePath": {
      "type": "string", "pattern": "^data/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.asm$"
    },
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "fileCount", "sourceLineCount", "statementCount", "globalLabelCount",
        "layoutOwnedFileCount", "alternateFileCount", "representativeAddressCount",
        "indexedRecordCount", "indexedFileCount"
      ],
      "properties": {
        "fileCount": { "const": 65 },
        "sourceLineCount": { "type": "integer", "minimum": 1 },
        "statementCount": { "type": "integer", "minimum": 1 },
        "globalLabelCount": { "type": "integer", "minimum": 1 },
        "layoutOwnedFileCount": { "const": 63 },
        "alternateFileCount": { "const": 2 },
        "representativeAddressCount": { "const": 63 },
        "indexedRecordCount": { "type": "integer", "minimum": 0 },
        "indexedFileCount": { "type": "integer", "minimum": 0 }
      }
    },
    "indexedRecordsBySourcePath": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "recordIds"],
      "properties": {
        "sourcePath": { "$ref": "#/definitions/sourcePath" },
        "recordIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/definitions/recordId" }
        }
      }
    },
    "facts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "categoryFileCounts", "privateIncbinReferenceCount",
        "uniquePrivateIncbinTargetCount", "spriteDialoguePropertyRows",
        "spriteDialogueDirectiveCounts", "graphicsPayloadsParsed",
        "scriptContentParsed"
      ],
      "properties": {
        "categoryFileCounts": {
          "type": "object", "additionalProperties": false,
          "required": ["graphics", "scripting", "tech", "root"],
          "properties": {
            "graphics": { "type": "integer", "minimum": 0 },
            "scripting": { "type": "integer", "minimum": 0 },
            "tech": { "type": "integer", "minimum": 0 },
            "root": { "type": "integer", "minimum": 0 }
          }
        },
        "privateIncbinReferenceCount": { "type": "integer", "minimum": 0 },
        "uniquePrivateIncbinTargetCount": { "type": "integer", "minimum": 0 },
        "spriteDialoguePropertyRows": { "type": "integer", "minimum": 0 },
        "spriteDialogueDirectiveCounts": {
          "type": "object", "additionalProperties": false,
          "required": ["mapsprite", "portrait", "speechSfx"],
          "properties": {
            "mapsprite": { "type": "integer", "minimum": 0 },
            "portrait": { "type": "integer", "minimum": 0 },
            "speechSfx": { "type": "integer", "minimum": 0 }
          }
        },
        "graphicsPayloadsParsed": { "type": "boolean" },
        "scriptContentParsed": { "type": "boolean" }
      }
    },
    "sourceFile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "sha256", "sourceLineCount", "statementCount", "globalLabels",
        "localLabelCount", "directCalls", "indirectCallSiteCount"
      ],
      "properties": {
        "path": { "$ref": "#/definitions/sourcePath" },
        "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "sourceLineCount": { "type": "integer", "minimum": 1 },
        "statementCount": { "type": "integer", "minimum": 0 },
        "globalLabels": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "localLabelCount": { "type": "integer", "minimum": 0 },
        "directCalls": {
          "type": "array", "items": { "$ref": "#/definitions/directCall" }
        },
        "indirectCallSiteCount": { "type": "integer", "minimum": 0 }
      }
    },
    "directCall": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "siteCount"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "siteCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
