{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/h3-level-up-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "function", "ram", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-level-up-tort-boundary-v1" },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "core"],
      "properties": { "name": { "const": "BizHawk" }, "version": { "type": "string" }, "core": { "const": "Genesis Plus GX" } }
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["initializeEntryAddress", "initializeExtraLevelAddress", "initializeStatsScanAddress", "levelUpEntryAddress", "levelUpExtraLevelAddress", "levelUpSpellScanAddress", "levelUpReturnAddress"],
      "properties": {
        "initializeEntryAddress": { "const": 38342 },
        "initializeExtraLevelAddress": { "const": 38440 },
        "initializeStatsScanAddress": { "const": 38444 },
        "levelUpEntryAddress": { "const": 38020 },
        "levelUpExtraLevelAddress": { "const": 38266 },
        "levelUpSpellScanAddress": { "const": 38270 },
        "levelUpReturnAddress": { "const": 38340 }
      }
    },
    "ram": {
      "type": "object", "additionalProperties": false,
      "required": ["combatantDataAddress", "combatantEntrySize", "levelUpArgumentsAddress", "seedAddress"],
      "properties": {
        "combatantDataAddress": { "const": 16771072 },
        "combatantEntrySize": { "const": 56 },
        "levelUpArgumentsAddress": { "const": 16756610 },
        "seedAddress": { "const": 16768676 }
      }
    },
    "cases": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "ally", "allyCode", "classCode", "seed", "initialization", "before", "after", "levelUpExtraBranch", "levelBeforeExtra", "effectiveLevel", "expectedSeed", "arguments"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "ally": { "type": "integer", "minimum": 0, "maximum": 29 },
          "allyCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "classCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "seed": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "initialization": { "$ref": "#/$defs/initialization" },
          "before": { "$ref": "#/$defs/stats" },
          "after": { "$ref": "#/$defs/stats" },
          "levelUpExtraBranch": { "type": "boolean" },
          "levelBeforeExtra": { "type": "integer", "minimum": -1, "maximum": 255 },
          "effectiveLevel": { "type": "integer", "minimum": 1, "maximum": 255 },
          "expectedSeed": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "arguments": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
        }
      }
    }
  },
  "$defs": {
    "initialization": {
      "type": "object", "additionalProperties": false,
      "required": ["startLevel", "extraLevelBranch", "levelBeforeExtra", "effectiveLevel"],
      "properties": {
        "startLevel": { "type": "integer", "minimum": 1, "maximum": 255 },
        "extraLevelBranch": { "type": "boolean" },
        "levelBeforeExtra": { "type": "integer", "minimum": -1, "maximum": 255 },
        "effectiveLevel": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "stats": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "level", "hp", "mp", "attack", "defense", "agility", "exp"],
      "properties": {
        "class": { "type": "integer", "minimum": 0, "maximum": 255 },
        "level": { "type": "integer", "minimum": 1, "maximum": 255 },
        "hp": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "mp": { "type": "integer", "minimum": 0, "maximum": 255 },
        "attack": { "type": "integer", "minimum": 0, "maximum": 255 },
        "defense": { "type": "integer", "minimum": 0, "maximum": 255 },
        "agility": { "type": "integer", "minimum": 0, "maximum": 255 },
        "exp": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    }
  }
}
