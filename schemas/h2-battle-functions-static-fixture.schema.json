{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SF2 shared battle functions static fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "upstreamCommit", "function", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-battle-functions-static-v1" },
    "romSha256": { "const": "9ADF662D09881F58EC37D174AB01E87A7FCFB24700B5F84B26C0CD4F351509E9" },
    "upstreamCommit": { "const": "c834c652b6862bc5679fd7f69a38a7093206efc6" },
    "function": { "$ref": "#/definitions/functionAddresses" },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": [
        "indexedRecordIds", "indexedSourcePaths", "indexedRecordsBySourcePath",
        "representativeSymbols", "functionFacts", "playerControlSummary",
        "playerControlFacts", "playerControlInputBits", "playerControlBattleActions",
        "playerControlMenus", "playerControlSelectedCallEdges"
      ],
      "properties": {
        "indexedRecordIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/definitions/recordId" }
        },
        "indexedSourcePaths": {
          "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
          "items": { "$ref": "#/definitions/sourcePath" }
        },
        "indexedRecordsBySourcePath": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": { "$ref": "#/definitions/indexedRecordsBySourcePath" }
        },
        "representativeSymbols": { "$ref": "#/definitions/representativeSymbols" },
        "functionFacts": { "$ref": "#/definitions/functionFacts" },
        "playerControlSummary": { "$ref": "#/definitions/playerControlSummary" },
        "playerControlFacts": { "$ref": "#/definitions/playerControlFacts" },
        "playerControlInputBits": { "$ref": "#/definitions/symbolArray" },
        "playerControlBattleActions": { "$ref": "#/definitions/symbolArray" },
        "playerControlMenus": { "$ref": "#/definitions/symbolArray" },
        "playerControlSelectedCallEdges": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/definitions/directCall" }
        }
      }
    }
  },
  "definitions": {
    "recordId": {
      "type": "string", "pattern": "^[a-z0-9.-]+$"
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^code/gameflow/battle/battlefunctions/[A-Za-z0-9_][A-Za-z0-9_.-]*\\.asm$"
    },
    "symbol": {
      "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "address": { "type": "integer", "minimum": 0 },
    "functionAddresses": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pulsatingGridAddress", "angelWingAddress", "updateTargetsAddress",
        "relativeMoveTableAddress", "executeTurnAddress", "loadBattleAddress",
        "setMoveSfxAddress", "controlCursorAddress", "chooseTargetAddress",
        "setCursorTargetAddress", "processPlayerInputAddress", "battlefieldMenuAddress",
        "aiTargetVisualAddress", "equipInBattleAddress", "checkGoldChestAddress"
      ],
      "properties": {
        "pulsatingGridAddress": { "$ref": "#/definitions/address" },
        "angelWingAddress": { "$ref": "#/definitions/address" },
        "updateTargetsAddress": { "$ref": "#/definitions/address" },
        "relativeMoveTableAddress": { "$ref": "#/definitions/address" },
        "executeTurnAddress": { "$ref": "#/definitions/address" },
        "loadBattleAddress": { "$ref": "#/definitions/address" },
        "setMoveSfxAddress": { "$ref": "#/definitions/address" },
        "controlCursorAddress": { "$ref": "#/definitions/address" },
        "chooseTargetAddress": { "$ref": "#/definitions/address" },
        "setCursorTargetAddress": { "$ref": "#/definitions/address" },
        "processPlayerInputAddress": { "$ref": "#/definitions/address" },
        "battlefieldMenuAddress": { "$ref": "#/definitions/address" },
        "aiTargetVisualAddress": { "$ref": "#/definitions/address" },
        "equipInBattleAddress": { "$ref": "#/definitions/address" },
        "checkGoldChestAddress": { "$ref": "#/definitions/address" }
      }
    },
    "indexedRecordsBySourcePath": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "recordIds"],
      "properties": {
        "sourcePath": { "$ref": "#/definitions/sourcePath" },
        "recordIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/definitions/recordId" }
        }
      }
    },
    "representativeSymbols": {
      "type": "object", "additionalProperties": false,
      "required": [
        "battlefunctions_0.asm", "battlefunctions_1.asm", "battlefunctions_2.asm",
        "battlefunctions_3.asm", "executeindividualturn.asm", "loadBattle.asm", "setmovesfx.asm"
      ],
      "properties": {
        "battlefunctions_0.asm": { "$ref": "#/definitions/symbol" },
        "battlefunctions_1.asm": { "$ref": "#/definitions/symbol" },
        "battlefunctions_2.asm": { "$ref": "#/definitions/symbol" },
        "battlefunctions_3.asm": { "$ref": "#/definitions/symbol" },
        "executeindividualturn.asm": { "$ref": "#/definitions/symbol" },
        "loadBattle.asm": { "$ref": "#/definitions/symbol" },
        "setmovesfx.asm": { "$ref": "#/definitions/symbol" }
      }
    },
    "functionFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["turnControl", "kiwiFlameBreath", "egress", "loadBattle", "moveSfx", "largeHelperBoundary"],
      "properties": {
        "turnControl": {
          "type": "object", "additionalProperties": false,
          "required": ["deadActorSkipsTurn", "aiCauses", "playerControlledEnemyRequiresToggle", "sleepAndStunSkipAction", "staySkipsAction", "egressAndAngelWingExitBeforeBattlescene", "ordinaryActionWritesAndExecutesBattlesceneThenReloadsBattle"],
          "properties": {
            "deadActorSkipsTurn": { "type": "boolean" },
            "aiCauses": { "$ref": "#/definitions/stringArray" },
            "playerControlledEnemyRequiresToggle": { "type": "boolean" },
            "sleepAndStunSkipAction": { "type": "boolean" },
            "staySkipsAction": { "type": "boolean" },
            "egressAndAngelWingExitBeforeBattlescene": { "type": "boolean" },
            "ordinaryActionWritesAndExecutesBattlesceneThenReloadsBattle": { "type": "boolean" }
          }
        },
        "kiwiFlameBreath": {
          "type": "object", "additionalProperties": false,
          "required": ["class", "requiresPhysicalAttack", "rngUpperBound", "rngSuccessValue", "upgradeLevels", "spellLevels"],
          "properties": {
            "class": { "type": "integer", "minimum": 0 },
            "requiresPhysicalAttack": { "type": "boolean" },
            "rngUpperBound": { "type": "integer", "minimum": 0 },
            "rngSuccessValue": { "type": "integer", "minimum": 0 },
            "upgradeLevels": { "$ref": "#/definitions/integerArray" },
            "spellLevels": { "$ref": "#/definitions/integerArray" }
          }
        },
        "egress": {
          "type": "object", "additionalProperties": false,
          "required": ["angelWingConsumesItemFirst", "spellConsumesDefinitionMp", "bothCloseBattlefieldWindows", "bothUpdateUnlockedFlag", "bothReturnEgressPosition", "returnCode"],
          "properties": {
            "angelWingConsumesItemFirst": { "type": "boolean" },
            "spellConsumesDefinitionMp": { "type": "boolean" },
            "bothCloseBattlefieldWindows": { "type": "boolean" },
            "bothUpdateUnlockedFlag": { "type": "boolean" },
            "bothReturnEgressPosition": { "type": "boolean" },
            "returnCode": { "type": "integer" }
          }
        },
        "loadBattle": {
          "type": "object", "additionalProperties": false,
          "required": ["order", "fairyWoodsOpensTimer"],
          "properties": {
            "order": { "$ref": "#/definitions/stringArray" },
            "fairyWoodsOpensTimer": { "type": "boolean" }
          }
        },
        "moveSfx": {
          "type": "object", "additionalProperties": false,
          "required": ["outsideBattle", "battleDefault", "chirrupSandalsOverride", "equipmentOverrideAlsoAppliesOutsideBattle"],
          "properties": {
            "outsideBattle": { "type": "integer", "minimum": 0 },
            "battleDefault": { "type": "string", "minLength": 1 },
            "chirrupSandalsOverride": { "type": "string", "minLength": 1 },
            "equipmentOverrideAlsoAppliesOutsideBattle": { "type": "boolean" }
          }
        },
        "largeHelperBoundary": {
          "type": "object", "additionalProperties": false,
          "required": ["cursorEntityAndGridFileInventoried", "targetingAndPlayerInputFileInventoried", "relativeMovementTableFileInventoried", "deeperBranchSemanticsRemainQueued"],
          "properties": {
            "cursorEntityAndGridFileInventoried": { "type": "boolean" },
            "targetingAndPlayerInputFileInventoried": { "type": "boolean" },
            "relativeMovementTableFileInventoried": { "type": "boolean" },
            "deeperBranchSemanticsRemainQueued": { "type": "boolean" }
          }
        }
      }
    },
    "playerControlSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["functionCount", "sourceRangeCount", "statementCount", "branchSiteCount", "directCallSiteCount", "uniqueDirectCallTargetCount", "selectedFunctionCallEdgeCount", "globalStateCount", "inputBitCount", "battleActionConstantCount", "menuConstantCount"],
      "properties": {
        "functionCount": { "type": "integer", "minimum": 0 },
        "sourceRangeCount": { "type": "integer", "minimum": 0 },
        "statementCount": { "type": "integer", "minimum": 0 },
        "branchSiteCount": { "type": "integer", "minimum": 0 },
        "directCallSiteCount": { "type": "integer", "minimum": 0 },
        "uniqueDirectCallTargetCount": { "type": "integer", "minimum": 0 },
        "selectedFunctionCallEdgeCount": { "type": "integer", "minimum": 0 },
        "globalStateCount": { "type": "integer", "minimum": 0 },
        "inputBitCount": { "type": "integer", "minimum": 0 },
        "battleActionConstantCount": { "type": "integer", "minimum": 0 },
        "menuConstantCount": { "type": "integer", "minimum": 0 }
      }
    },
    "playerControlFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["cursorControl", "targetSelection", "battleActionMenu", "battlefieldMenu", "equipmentAndItems", "chestSearch"],
      "properties": {
        "cursorControl": {
          "type": "object", "additionalProperties": false,
          "required": ["confirmInputBits", "storesDestinationAsChosenTile", "hidesCursorAfterSelection"],
          "properties": {
            "confirmInputBits": { "$ref": "#/definitions/stringArray" },
            "storesDestinationAsChosenTile": { "type": "boolean" },
            "hidesCursorAfterSelection": { "type": "boolean" }
          }
        },
        "targetSelection": {
          "type": "object", "additionalProperties": false,
          "required": ["emptyListReturn", "cancelInput", "confirmInputs", "directionInputsWrap", "returnValueOnConfirm"],
          "properties": {
            "emptyListReturn": { "type": "integer" },
            "cancelInput": { "type": "string", "minLength": 1 },
            "confirmInputs": { "$ref": "#/definitions/stringArray" },
            "directionInputsWrap": { "$ref": "#/definitions/stringArray" },
            "returnValueOnConfirm": { "type": "string", "minLength": 1 }
          }
        },
        "battleActionMenu": {
          "type": "object", "additionalProperties": false,
          "required": ["choiceOrder", "cancelRestoresOriginalPosition", "movementCancelAction", "itemChoiceOrder", "committedActions"],
          "properties": {
            "choiceOrder": { "$ref": "#/definitions/stringArray" },
            "cancelRestoresOriginalPosition": { "type": "boolean" },
            "movementCancelAction": { "type": "integer" },
            "itemChoiceOrder": { "$ref": "#/definitions/stringArray" },
            "committedActions": { "$ref": "#/definitions/stringArray" }
          }
        },
        "battlefieldMenu": {
          "type": "object", "additionalProperties": false,
          "required": ["choiceOrder", "battleZeroRejectsSuspend", "suspendCopiesSecondsAndSetsFlag88", "debugStartReturnsToMenuAfterSave", "normalSuspendTransfersToWitchSuspend"],
          "properties": {
            "choiceOrder": { "$ref": "#/definitions/stringArray" },
            "battleZeroRejectsSuspend": { "type": "boolean" },
            "suspendCopiesSecondsAndSetsFlag88": { "type": "boolean" },
            "debugStartReturnsToMenuAfterSave": { "type": "boolean" },
            "normalSuspendTransfersToWitchSuspend": { "type": "boolean" }
          }
        },
        "equipmentAndItems": {
          "type": "object", "additionalProperties": false,
          "required": ["curseBlocksEquipmentExchange", "newCursedEquipmentShowsCurseDialogue", "equippedCursedItemCannotBeGivenOrDropped", "giveToFullInventoryTradesItems", "transferredItemsClearEquippedBit", "giveCommitsStayAction", "dropRequiresConfirmation", "droppedRareItemMovesToDeals"],
          "properties": {
            "curseBlocksEquipmentExchange": { "type": "boolean" },
            "newCursedEquipmentShowsCurseDialogue": { "type": "boolean" },
            "equippedCursedItemCannotBeGivenOrDropped": { "type": "boolean" },
            "giveToFullInventoryTradesItems": { "type": "boolean" },
            "transferredItemsClearEquippedBit": { "type": "boolean" },
            "giveCommitsStayAction": { "type": "boolean" },
            "dropRequiresConfirmation": { "type": "boolean" },
            "droppedRareItemMovesToDeals": { "type": "boolean" }
          }
        },
        "chestSearch": {
          "type": "object", "additionalProperties": false,
          "required": ["noChestContentsCommitsStay", "emptyChestCommitsStay", "trapCommitsTrappedChestActionAndSpawnsEnemy", "goldChestUsesThresholdAndIncreaseGold", "itemChestAddsToActor", "fullInventoryClosesChestAndReturnsToMenu", "resolvedNonTrapChestCommitsStay"],
          "properties": {
            "noChestContentsCommitsStay": { "type": "boolean" },
            "emptyChestCommitsStay": { "type": "boolean" },
            "trapCommitsTrappedChestActionAndSpawnsEnemy": { "type": "boolean" },
            "goldChestUsesThresholdAndIncreaseGold": { "type": "boolean" },
            "itemChestAddsToActor": { "type": "boolean" },
            "fullInventoryClosesChestAndReturnsToMenu": { "type": "boolean" },
            "resolvedNonTrapChestCommitsStay": { "type": "boolean" }
          }
        }
      }
    },
    "directCall": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "siteCount"],
      "properties": {
        "target": { "$ref": "#/definitions/symbol" },
        "siteCount": { "type": "integer", "minimum": 1 }
      }
    },
    "integerArray": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "stringArray": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "symbolArray": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/definitions/symbol" }
    }
  }
}
