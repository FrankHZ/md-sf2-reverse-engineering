{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/battle-background-decode.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "function", "table", "summary", "aliases", "payloads", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-battle-background-decode-v1" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "function": { "$ref": "#/$defs/counts" },
    "table": { "$ref": "#/$defs/counts" },
    "summary": { "$ref": "#/$defs/counts" },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["background", "payloadOwnerBackground"],
        "properties": {
          "background": { "type": "integer", "minimum": 0, "maximum": 29 },
          "payloadOwnerBackground": { "type": "integer", "minimum": 0, "maximum": 28 }
        }
      }
    },
    "payloads": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["background", "symbol", "sourcePath", "sourceAddress", "payloadBytes", "paletteOffset", "paletteSha256", "tileset1Offset", "tileset2Offset", "tilesets"],
        "properties": {
          "background": { "type": "integer", "minimum": 0, "maximum": 28 },
          "symbol": { "type": "string", "pattern": "^Background[0-9]{2}$" },
          "sourcePath": { "type": "string" },
          "sourceAddress": { "type": "integer", "minimum": 0 },
          "payloadBytes": { "type": "integer", "minimum": 39 },
          "paletteOffset": { "const": 6 },
          "paletteSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
          "tileset1Offset": { "const": 38 },
          "tileset2Offset": { "type": "integer", "minimum": 39 },
          "tilesets": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/tileset" }
          }
        }
      }
    },
    "runtimeQuestions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "tileset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compressedBytes", "inputBitsConsumed", "trailingBits", "decodedBytes", "decodedSha256", "commandGroupCount", "literalWordCount", "copyCommandCount", "copiedWordCount", "maximumCopyOffsetWords", "maximumCopyLengthWords"],
      "properties": {
        "compressedBytes": { "type": "integer", "minimum": 1 },
        "inputBitsConsumed": { "type": "integer", "minimum": 1 },
        "trailingBits": { "type": "integer", "minimum": 0 },
        "decodedBytes": { "const": 6144 },
        "decodedSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "commandGroupCount": { "type": "integer", "minimum": 1 },
        "literalWordCount": { "type": "integer", "minimum": 0 },
        "copyCommandCount": { "type": "integer", "minimum": 0 },
        "copiedWordCount": { "type": "integer", "minimum": 0 },
        "maximumCopyOffsetWords": { "type": "integer", "minimum": 0 },
        "maximumCopyLengthWords": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
