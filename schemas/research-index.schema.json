{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/research-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "upstream", "rom", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "sourceRoot", "listingPath"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceRoot": { "type": "string", "minLength": 1 },
        "listingPath": { "type": "string", "minLength": 1 }
      }
    },
    "rom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "sha256"],
      "properties": {
        "release": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subsystem", "status", "symbol", "sourcePath", "addresses", "evidence", "documents"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "subsystem": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "status": { "enum": ["confirmed", "inferred", "unknown"] },
          "listingDomain": { "enum": ["h1-68000", "z80-music-bank"] },
          "symbol": { "type": "string", "pattern": "^[A-Za-z_@][A-Za-z0-9_@.]*$" },
          "sourcePath": { "type": "string", "pattern": "^(?:code|data|layout)/.+\\.asm$" },
          "addresses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "space", "kind", "value"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "space": { "enum": ["rom", "ram"] },
                "kind": { "enum": ["symbol", "observation", "state"] },
                "value": { "type": "integer", "minimum": 0, "maximum": 16777215 },
                "symbol": { "type": "string", "pattern": "^[A-Za-z_@][A-Za-z0-9_@.]*$" },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "fixture", "fixtureId", "verifier", "bindings"],
              "properties": {
                "level": { "enum": ["H2", "H3", "H4"] },
                "fixture": { "type": "string", "pattern": "^tests/fixtures/.+\\.json$" },
                "fixtureId": { "type": "string", "minLength": 1 },
                "verifier": { "type": "string", "pattern": "^(?:scripts/.+\\.ps1|src/sf2tool/.+\\.py)$" },
                "bindings": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["addressId", "fixtureField"],
                    "properties": {
                      "addressId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                      "fixtureField": {
                        "type": "string",
                        "anyOf": [
                          { "pattern": "^(?!sourceContext\\.(?:actionCompletionSpine|turnFinalizationSpine|fieldMenuSpine|fieldItemEffects|fieldSearchSpine|eventDirectState|eventDirectControl)\\.)(function|ram|table|instrumentation|sourceContext|turnOrderConsumer|controlDispatch|battle01ControlInputs|aiConstructionHandoff|commonActionConstruction|actionEffectSpine|fieldMenuSpine|fieldItemEffects|fieldSearchSpine|eventDirectState|eventDirectControl)(?:\\.[A-Za-z][A-Za-z0-9_]*)+$" },
                          { "enum": [
                            "actionCompletionSpine.functionAddresses.WriteBattlesceneScript",
                            "actionCompletionSpine.startResumes.primaryTargetLoop",
                            "actionCompletionSpine.startResumes.secondAttack",
                            "actionCompletionSpine.startResumes.counterAttack",
                            "actionCompletionSpine.endSequence.returnAddress",
                            "actionCompletionSpine.endSequence.determineTargetsEntry",
                            "actionCompletionSpine.functionAddresses.battlesceneScript_BreakUsedItem",
                            "actionCompletionSpine.functionAddresses.battlesceneScript_PerformAnimation",
                            "actionCompletionSpine.functionAddresses.battlesceneScript_DisplayActionMessage",
                            "actionCompletionSpine.functionAddresses.battlesceneScript_SwitchTargets",
                            "actionCompletionSpine.functionAddresses.battlesceneScript_MakeActorIdle",
                            "actionCompletionSpine.functionAddresses.battlesceneScript_ValidateDoubleAttack",
                            "actionCompletionSpine.followupBranches.doubleAttack.validatorRangeEndExclusive",
                            "actionCompletionSpine.functionAddresses.battlesceneScript_ValidateCounterAttack",
                            "actionCompletionSpine.followupBranches.counterAttack.validatorReturnAddress",
                            "actionCompletionSpine.functionAddresses.battlesceneScript_End",
                            "actionCompletionSpine.endSequence.currentHpReplayEndAddress",
                            "actionCompletionSpine.functionAddresses.battlesceneScript_GiveExpAndGold",
                            "actionCompletionSpine.executeIndividualTurnHandoff.callAddress",
                            "actionCompletionSpine.executeIndividualTurnHandoff.resumeAddress"
                          ] },
                          { "enum": [
                            "turnFinalizationSpine.replayContinuation.resumeAddress",
                            "turnFinalizationSpine.replayContinuation.initializeBattlesceneCallAddress",
                            "turnFinalizationSpine.replayContinuation.executeBattlesceneCallAddress",
                            "turnFinalizationSpine.replayContinuation.executeBattlesceneScriptEndAddress",
                            "turnFinalizationSpine.replayContinuation.endBattlesceneCallAddress",
                            "turnFinalizationSpine.replayContinuation.leaderDeathPositionsCallAddress",
                            "turnFinalizationSpine.replayContinuation.loadBattleCallAddress",
                            "turnFinalizationSpine.replayContinuation.returnAddress",
                            "turnFinalizationSpine.functionAddresses.InitializeBattlescene",
                            "turnFinalizationSpine.functionAddresses.ExecuteBattlesceneScript",
                            "turnFinalizationSpine.functionAddresses.EndBattlescene",
                            "turnFinalizationSpine.functionAddresses.ApplyPositionsAfterEnemyLeaderDies",
                            "turnFinalizationSpine.functionAddresses.LoadBattle",
                            "turnFinalizationSpine.functionAddresses.BattleLoop",
                            "turnFinalizationSpine.outerLoop.executeTurnResumeAddress",
                            "turnFinalizationSpine.outerLoop.defeatedCutsceneCallAddress",
                            "turnFinalizationSpine.outerLoop.processKilledFirstCallAddress",
                            "turnFinalizationSpine.outerLoop.countFirstCallAddress",
                            "turnFinalizationSpine.outerLoop.afterTurnCallAddress",
                            "turnFinalizationSpine.outerLoop.afterTurnResumeAddress",
                            "turnFinalizationSpine.outerLoop.countSecondCallAddress",
                            "turnFinalizationSpine.outerLoop.nextTurnDispatchAddress",
                            "turnFinalizationSpine.functionAddresses.ExecuteBattleCutscene_Defeated",
                            "turnFinalizationSpine.functionAddresses.ProcessKilledCombatants",
                            "turnFinalizationSpine.functionAddresses.CountRemainingCombatants",
                            "turnFinalizationSpine.functionAddresses.ProcessAfterTurnEffects",
                            "turnFinalizationSpine.functionAddresses.BattleLoop_Victory",
                            "turnFinalizationSpine.outcomeBoundaries.defeatAddress"
                          ] },
                          { "enum": [
                            "victoryReturnSpine.victoryBody.entryAddress",
                            "victoryReturnSpine.victoryBody.afterBattleCallAddress",
                            "victoryReturnSpine.victoryBody.clearUnlockedFlagCallAddress",
                            "victoryReturnSpine.victoryBody.setCompletedFlagCallAddress",
                            "victoryReturnSpine.victoryBody.resultAddress",
                            "victoryReturnSpine.victoryBody.returnAddress",
                            "victoryReturnSpine.functionAddresses.HealLivingAndImmortalAllies",
                            "victoryReturnSpine.afterBattleRouting.entryAddress",
                            "victoryReturnSpine.afterBattleRouting.completionCheckAddress",
                            "victoryReturnSpine.afterBattleRouting.routeLoadAddress",
                            "victoryReturnSpine.afterBattleRouting.executeScriptCallAddress",
                            "victoryReturnSpine.afterBattleRouting.executeScriptResumeAddress",
                            "victoryReturnSpine.functionAddresses.ExecuteMapScript",
                            "victoryReturnSpine.afterBattleRouting.tableAddress",
                            "victoryReturnSpine.afterBattleRouting.battle01RowAddress",
                            "victoryReturnSpine.battle01AfterBattleProgram.entryAddress",
                            "victoryReturnSpine.battle01AfterBattleProgram.programEndAddress",
                            "victoryReturnSpine.battle01AfterBattleProgram.entityTableAddress",
                            "victoryReturnSpine.afterBattleJoin.entryAddress",
                            "victoryReturnSpine.afterBattleJoin.joinCallAddress",
                            "victoryReturnSpine.afterBattleJoin.returnAddress",
                            "victoryReturnSpine.afterBattleJoin.tableAddress",
                            "victoryReturnSpine.afterBattleJoin.battle01RowAddress",
                            "victoryReturnSpine.mainLoopReturn.mainLoopEntryAddress",
                            "victoryReturnSpine.mainLoopReturn.battleLoopCallAddress",
                            "victoryReturnSpine.mainLoopReturn.postBattleResumeAddress",
                            "victoryReturnSpine.mainLoopReturn.explorationCallAddress",
                            "victoryReturnSpine.functionAddresses.SwitchMap",
                            "victoryReturnSpine.functionAddresses.ExplorationLoop"
                          ] }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^docs/.+\\.md$" }
          },
          "designContracts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^docs/design/.+\\.md$" }
          }
        }
      }
    }
  }
}
