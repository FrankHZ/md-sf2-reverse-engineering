    "finalTarget": { "type": "object", "additionalProperties": false, "required": ["combatant", "status", "currentDef", "currentAgi"], "properties": { "combatant": { "type": "integer" }, "status": { "const": 12288 }, "currentDef": { "type": "integer" }, "currentAgi": { "type": "integer" } } },
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["construction", "replay"],
      "properties": {
        "construction": { "type": "object", "additionalProperties": false, "required": ["actorMp", "records", "targetSameSide", "award"], "properties": { "actorMp": { "const": 20 }, "records": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/record" } }, "targetSameSide": { "const": true }, "award": { "$ref": "#/definitions/award" } } },
        "replay": { "type": "object", "additionalProperties": false, "required": ["reactionOrder", "allyReactions", "expReaction", "finalActorMp", "finalActorExp", "finalTargets"], "properties": { "reactionOrder": { "const": ["ally:-2:0", "ally:0:12288"] }, "allyReactions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/allyReaction" } }, "expReaction": { "$ref": "#/definitions/expReaction" }, "finalActorMp": { "const": 18 }, "finalActorExp": { "const": 6 }, "finalTargets": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/finalTarget" } } } }
      }
