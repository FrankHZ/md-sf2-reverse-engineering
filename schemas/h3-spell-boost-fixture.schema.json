      "required": ["combatant", "baseDef", "baseAgi", "initialStatus", "initialCurrentDef", "initialCurrentAgi"],
      "properties": { "combatant": { "type": "integer", "minimum": 0, "maximum": 1 }, "baseDef": { "type": "integer", "minimum": 0, "maximum": 255 }, "baseAgi": { "type": "integer", "minimum": 0, "maximum": 255 }, "initialStatus": { "type": "integer", "minimum": 0, "maximum": 65535 }, "initialCurrentDef": { "type": "integer", "minimum": 0, "maximum": 255 }, "initialCurrentAgi": { "type": "integer", "minimum": 0, "maximum": 255 } }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "actor", "actorClass", "actorInitialMp", "actorInitialExp", "actionType", "actionSpell", "spellMpCost", "seed", "statusMask", "statusCounterUnit", "recastThreshold", "targetSameSide", "schedulingTarget", "targets"],
      "properties": {
        "id": { "const": "bowie-boost1-fresh-and-one-counter-allies" }, "actor": { "const": 0 }, "actorClass": { "const": 0 }, "actorInitialMp": { "const": 20 }, "actorInitialExp": { "const": 0 }, "actionType": { "const": 1 }, "actionSpell": { "const": 3 }, "spellMpCost": { "const": 2 }, "seed": { "const": 4660 }, "statusMask": { "const": 12288 }, "statusCounterUnit": { "const": 4096 }, "recastThreshold": { "const": 8 }, "targetSameSide": { "const": true }, "schedulingTarget": { "const": 128 },
        "targets": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/target" } }
      }
    },
    "award": { "type": "object", "additionalProperties": false, "required": ["seed", "halved", "firstRoll", "secondRoll", "commandExp"], "properties": { "seed": { "const": 60587 }, "halved": { "const": 5 }, "firstRoll": { "const": 0 }, "secondRoll": { "const": 3 }, "commandExp": { "const": 6 } } },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["combatant", "initialStatus", "setStatus", "reapplication", "threshold", "roll", "success", "reactionStatus", "accumulatedExp", "agiBonus", "defBonus", "statusAfterConstruction", "currentDefAfterConstruction", "currentAgiAfterConstruction"],
      "properties": { "combatant": { "type": "integer" }, "initialStatus": { "type": "integer" }, "setStatus": { "type": "integer" }, "reapplication": { "type": "boolean" }, "threshold": { "type": "integer" }, "roll": { "type": "integer" }, "success": { "type": "boolean" }, "reactionStatus": { "type": "integer" }, "accumulatedExp": { "type": "integer" }, "agiBonus": { "type": "integer" }, "defBonus": { "type": "integer" }, "statusAfterConstruction": { "type": "integer" }, "currentDefAfterConstruction": { "type": "integer" }, "currentAgiAfterConstruction": { "type": "integer" } }
    },
    "allyReaction": {
      "type": "object", "additionalProperties": false,
      "required": ["combatant", "mpChange", "statusCommand", "mpBefore", "mpAfter", "statusBefore", "statusAfter", "defBefore", "defAfter", "agiBefore", "agiAfter"],
      "properties": { "combatant": { "type": "integer" }, "mpChange": { "type": "integer" }, "statusCommand": { "type": "integer" }, "mpBefore": { "type": "integer" }, "mpAfter": { "type": "integer" }, "statusBefore": { "type": "integer" }, "statusAfter": { "type": "integer" }, "defBefore": { "type": "integer" }, "defAfter": { "type": "integer" }, "agiBefore": { "type": "integer" }, "agiAfter": { "type": "integer" } }
