      "required": ["boostEffectEntryAddress", "boostStatusSetAddress", "boostReactionAddress", "boostAgiBonusAddress", "boostDefBonusAddress", "boostEffectReturnAddress", "allyStatsAppliedAddress"],
      "properties": { "boostEffectEntryAddress": { "const": 45692 }, "boostStatusSetAddress": { "const": 45712 }, "boostReactionAddress": { "const": 45730 }, "boostAgiBonusAddress": { "const": 45784 }, "boostDefBonusAddress": { "const": 45816 }, "boostEffectReturnAddress": { "const": 45836 }, "allyStatsAppliedAddress": { "const": 101898 } }
    },
