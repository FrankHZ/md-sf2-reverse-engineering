{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/h3-spell-boost-fixture.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "battleId", "observationBoundary", "sharedHarnessFixture", "sharedStatusFixture", "sharedHealingFixture", "function", "case", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "sf2-boost1-fresh-and-recast-v1" },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": { "type": "object", "additionalProperties": false, "required": ["name", "version", "core"], "properties": { "name": { "const": "BizHawk" }, "version": { "const": "2.11.1" }, "core": { "const": "Genesis Plus GX" } } },
    "battleId": { "const": 1 }, "observationBoundary": { "type": "string", "minLength": 1 },
    "sharedHarnessFixture": { "const": "tests/fixtures/h3/spell-damage-resistance-v1.json" },
    "sharedStatusFixture": { "const": "tests/fixtures/h3/spell-status-sleep-v1.json" },
    "sharedHealingFixture": { "const": "tests/fixtures/h3/spell-healing-v1.json" },
    "function": { "$ref": "#/definitions/function" },
    "case": { "$ref": "#/definitions/case" },
    "expected": { "$ref": "#/definitions/expected" }
