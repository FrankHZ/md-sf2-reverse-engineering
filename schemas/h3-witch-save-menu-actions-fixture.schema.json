{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sf2-research.example/schemas/h3-witch-save-menu-actions-fixture.schema.json",
  "title": "H3 Witch Load Copy Delete action fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "evidenceDate", "provenance", "instrumentation", "observationBoundary", "caseOrder", "cases", "expectedObservation", "runtimeQuestions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"const": "sf2-witch-save-menu-actions-runtime-v1"},
    "romSha256": {"const": "9ADF662D09881F58EC37D174AB01E87A7FCFB24700B5F84B26C0CD4F351509E9"},
    "emulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "core"],
      "properties": {"name": {"const": "BizHawk"}, "version": {"const": "2.11.1"}, "core": {"const": "Genesis Plus GX"}}
    },
    "evidenceDate": {"const": "2026-08-13"},
    "provenance": {"$ref": "#/definitions/provenance"},
    "instrumentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedActionEntries"],
      "properties": {
        "observedActionEntries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["load", "copy", "delete"],
          "properties": {
            "load": {"$ref": "https://sf2-research.example/schemas/h3-witch-save-menu-actions-observation.schema.json#/definitions/pc"},
            "copy": {"$ref": "https://sf2-research.example/schemas/h3-witch-save-menu-actions-observation.schema.json#/definitions/pc"},
            "delete": {"$ref": "https://sf2-research.example/schemas/h3-witch-save-menu-actions-observation.schema.json#/definitions/pc"}
          }
        }
      }
    },
    "observationBoundary": {"type": "string", "minLength": 1},
    "caseOrder": {"$ref": "https://sf2-research.example/schemas/h3-witch-save-menu-actions-observation.schema.json#/definitions/caseIdArray"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/case"}},
    "expectedObservation": {"$ref": "https://sf2-research.example/schemas/h3-witch-save-menu-actions-observation.schema.json"},
    "runtimeQuestions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "definitions": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstreamRepository", "upstreamBranch", "upstreamCommit", "sourcePaths", "listingPath", "runtimeCommand"],
      "properties": {
        "upstreamRepository": {"const": "https://github.com/ShiningForceCentral/SF2DISASM.git"},
        "upstreamBranch": {"const": "master"},
        "upstreamCommit": {"const": "c834c652b6862bc5679fd7f69a38a7093206efc6"},
        "sourcePaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "listingPath": {"const": "build/sf2build-h1.lst"},
        "runtimeCommand": {"const": "uv run sf2 h3 witch-save-menu-actions --timeout-seconds 180"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "saveFlags", "menuResult", "promptResult", "flag88Set"],
      "properties": {
        "id": {"$ref": "https://sf2-research.example/schemas/h3-witch-save-menu-actions-observation.schema.json#/definitions/caseId"},
        "action": {"$ref": "https://sf2-research.example/schemas/h3-witch-save-menu-actions-observation.schema.json#/definitions/action"},
        "saveFlags": {"enum": [1, 2]},
        "menuResult": {"enum": [-1, 1, 2, null]},
        "promptResult": {"enum": [0, 1, null]},
        "flag88Set": {"type": "boolean"}
      }
    }
  }
}
