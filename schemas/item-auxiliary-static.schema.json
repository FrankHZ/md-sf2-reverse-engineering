{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/item-auxiliary-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "upstream", "romSha256", "summary", "romRanges", "shops",
    "debugShop", "chestGold", "breakMessages", "mithril", "specialCaravanDescriptions",
    "fieldUsableItems", "weaponGraphics", "consumerRules", "runtimeQuestions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-item-auxiliary-static-v1" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "summary": {
      "type": "object",
      "minProperties": 19,
      "maxProperties": 19,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "romRanges": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/romRange" }
    },
    "shops": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "kind", "items"],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 29 },
          "kind": { "enum": ["weapon", "item"] },
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/namedValue" } }
        }
      }
    },
    "debugShop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaredCount", "itemIds"],
      "properties": {
        "declaredCount": { "const": 128 },
        "itemIds": {
          "type": "array", "minItems": 128, "maxItems": 128,
          "items": { "type": "integer", "minimum": 0, "maximum": 127 },
          "uniqueItems": true
        }
      }
    },
    "chestGold": {
      "type": "array", "minItems": 13, "maxItems": 13,
      "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
    },
    "breakMessages": {
      "type": "array", "minItems": 25, "maxItems": 25,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item", "messageOffset"],
        "properties": {
          "item": { "$ref": "#/$defs/namedValue" },
          "messageOffset": { "$ref": "#/$defs/namedValue" }
        }
      }
    },
    "mithril": {
      "type": "object", "additionalProperties": false,
      "required": ["classGroups", "weaponRows", "specialClassGroup"],
      "properties": {
        "classGroups": { "type": "array", "minItems": 9, "maxItems": 9 },
        "weaponRows": { "type": "array", "minItems": 8, "maxItems": 8 },
        "specialClassGroup": { "type": "object", "minProperties": 4, "maxProperties": 4 }
      }
    },
    "specialCaravanDescriptions": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": { "type": "object", "minProperties": 3, "maxProperties": 3 }
    },
    "fieldUsableItems": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": { "$ref": "#/$defs/namedValue" }, "uniqueItems": true
    },
    "weaponGraphics": {
      "type": "array", "minItems": 84, "maxItems": 84,
      "items": { "type": "object", "minProperties": 3, "maxProperties": 3 }
    },
    "consumerRules": { "type": "object", "minProperties": 8, "maxProperties": 8 },
    "runtimeQuestions": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "namedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "value"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "value": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "romRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "sourcePath", "address", "endExclusive", "byteCount", "sha256"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "pattern": "^data/stats/items/.+\\.asm$" },
        "address": { "type": "integer", "minimum": 0 },
        "endExclusive": { "type": "integer", "minimum": 1 },
        "byteCount": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    }
  }
}
