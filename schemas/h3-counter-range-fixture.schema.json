{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/h3-counter-range-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "battleId", "scenario", "function", "setup", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-counter-range-validation-v1" },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "core"],
      "properties": { "name": { "const": "BizHawk" }, "version": { "const": "2.11.1" }, "core": { "const": "Genesis Plus GX" } }
    },
    "battleId": { "const": 1 },
    "scenario": { "const": "counter-range" },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["calculateDamageEntryAddress", "validateDoubleEntryAddress", "validateCounterEntryAddress", "validateCounterReturnAddress"],
      "properties": {
        "calculateDamageEntryAddress": { "const": 43966 },
        "validateDoubleEntryAddress": { "const": 42078 },
        "validateCounterEntryAddress": { "const": 42140 },
        "validateCounterReturnAddress": { "const": 42316 }
      }
    },
    "setup": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "target", "targetLandEffect", "dodgeSeed", "forcedValidationToggles", "validationPositions"],
      "properties": {
        "actor": { "$ref": "#/definitions/actor" },
        "target": { "$ref": "#/definitions/target" },
