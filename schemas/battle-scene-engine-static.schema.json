{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shining Force II battle scene engine static inventory",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "scope", "summary", "indexedRecordIds", "indexedSourcePaths", "internalDirectCallTargets", "externalDirectCallTargets", "sceneFacts", "files"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "sf2-battle-scene-engine-static-v1" },
    "upstream": { "type": "object" }, "scope": { "const": "code/gameflow/battle/battlescenes" },
    "summary": { "type": "object", "required": ["fileCount", "sourceLineCount", "statementCount", "globalLabelCount", "localLabelCount", "directCallSiteCount", "indirectCallSiteCount", "uniqueDirectTargetCount", "internalDirectTargetCount", "externalDirectTargetCount", "indexedRecordCount", "indexedFileCount"], "properties": { "fileCount": { "const": 12 }, "indexedRecordCount": { "const": 16 }, "indexedFileCount": { "const": 12 } } },
    "indexedRecordIds": { "type": "array", "minItems": 16, "maxItems": 16, "uniqueItems": true },
    "indexedSourcePaths": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true },
    "internalDirectCallTargets": { "type": "array", "uniqueItems": true },
    "externalDirectCallTargets": { "type": "array", "uniqueItems": true },
    "sceneFacts": { "type": "object", "minProperties": 5, "maxProperties": 5 },
    "files": { "type": "array", "minItems": 12, "maxItems": 12 }
  }
}
