{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/rom-static-data.schema.json",
  "title": "Shining Force II ROM-decoded static records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provenance", "layoutId", "tables"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["romManifestId", "romSha256"],
      "properties": {
        "romManifestId": { "type": "string", "minLength": 1 },
        "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "layoutId": { "type": "string", "minLength": 1 },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allyStartDefinitions", "classDefinitions", "itemDefinitions", "spellDefinitions"],
      "properties": {
        "allyStartDefinitions": { "$ref": "#/$defs/records" },
        "classDefinitions": { "$ref": "#/$defs/records" },
        "itemDefinitions": { "$ref": "#/$defs/records" },
        "spellDefinitions": { "$ref": "#/$defs/records" }
      }
    }
  },
  "$defs": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "offset", "rawHex", "decoded"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "offset": { "type": "integer", "minimum": 0 },
          "rawHex": { "type": "string", "pattern": "^[0-9A-F]+$" },
          "decoded": { "type": "object" }
        }
      }
    }
  }
}
