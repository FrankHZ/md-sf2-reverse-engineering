  "definitions": {
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructionTargetObserved",
        "effectiveTargetObserved",
        "callSiteAddressObserved",
        "targetEntryAddressObserved",
        "returnAddressObserved"
      ],
      "properties": {
        "instructionTargetObserved": {
          "type": "string"
        },
        "effectiveTargetObserved": {
          "type": "string"
        },
        "callSiteAddressObserved": {
          "type": "integer"
        },
        "targetEntryAddressObserved": {
          "type": "integer"
        },
        "returnAddressObserved": {
          "type": "integer"
        }
      }
    },
    "effectiveTargetCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "csc1D_showPortrait",
        "GetEntityPortaitAndSpeechSfx",
        "WaitForViewScrollEnd",
        "DisplayText",
        "ClosePortraitWindow",
        "Sleep"
      ],
      "properties": {
        "csc1D_showPortrait": {
          "type": "integer",
          "minimum": 0
        },
        "GetEntityPortaitAndSpeechSfx": {
          "type": "integer",
          "minimum": 0
        },
        "WaitForViewScrollEnd": {
          "type": "integer",
          "minimum": 0
        },
        "DisplayText": {
          "type": "integer",
          "minimum": 0
        },
        "ClosePortraitWindow": {
          "type": "integer",
          "minimum": 0
        },
        "Sleep": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "registerWords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "stateWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kindObserved",
        "resumeAddressObserved",
        "wordValueObserved"
      ],
      "properties": {
        "kindObserved": {
          "type": "string"
        },
        "resumeAddressObserved": {
          "type": "integer"
        },
        "wordValueObserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handlerEntryPcObserved",
        "handlerReturnPcObserved",
        "handlerReturned",
        "scriptCursorRamOffsetAfterObserved",
        "stackPointerDeltaBytesObserved",
        "skipFlagBranchTakenObserved",
        "directCallsObserved",
        "effectiveTargetCountsObserved",
        "directCallRegisterWordsObserved",
        "stateWritesObserved"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "handlerEntryPcObserved": {
          "type": "integer"
        },
        "handlerReturnPcObserved": {
          "type": "integer"
        },
        "handlerReturned": {
          "type": "boolean"
        },
        "scriptCursorRamOffsetAfterObserved": {
          "type": "integer"
        },
        "stackPointerDeltaBytesObserved": {
          "type": "integer"
        },
        "skipFlagBranchTakenObserved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "directCallsObserved": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/call"
          }
        },
        "effectiveTargetCountsObserved": {
          "$ref": "#/definitions/effectiveTargetCounts"
        },
        "directCallRegisterWordsObserved": {
