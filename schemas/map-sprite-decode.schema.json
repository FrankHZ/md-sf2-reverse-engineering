{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/map-sprite-decode.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "function", "table", "summary", "sentinel", "aliases", "payloads", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-map-sprite-decode-v1" },
    "upstream": { "type": "object", "required": ["repository", "commit"] },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "function": { "$ref": "#/$defs/counts" },
    "table": { "$ref": "#/$defs/counts" },
    "summary": { "$ref": "#/$defs/counts" },
    "sentinel": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "bytesHex", "pointerSlots"],
      "properties": {
        "symbol": { "const": "Mapsprite237_0" },
        "bytesHex": { "const": "FFFF" },
        "pointerSlots": {
          "type": "array", "minItems": 9, "maxItems": 9,
          "items": { "type": "integer", "minimum": 711, "maximum": 719 },
          "uniqueItems": true
        }
      }
    },
    "aliases": {
      "type": "array", "minItems": 50, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slot", "mapsprite", "direction", "payloadSymbol", "payloadOwnerMapsprite", "payloadOwnerDirection"],
        "properties": {
          "slot": { "type": "integer", "minimum": 0, "maximum": 719 },
          "mapsprite": { "type": "integer", "minimum": 0, "maximum": 239 },
          "direction": { "type": "integer", "minimum": 0, "maximum": 2 },
          "payloadSymbol": { "type": "string", "pattern": "^Mapsprite[0-9]{3}_[012]$" },
          "payloadOwnerMapsprite": { "type": "integer", "minimum": 0, "maximum": 237 },
          "payloadOwnerDirection": { "type": "integer", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "payloads": {
      "type": "array", "minItems": 670, "maxItems": 670,
      "items": {
        "type": "object",
        "required": ["mapsprite", "direction", "symbol", "sourcePath", "sourceAddress", "compressedBytes", "sentinel"],
        "properties": {
          "mapsprite": { "type": "integer", "minimum": 0, "maximum": 237 },
          "direction": { "type": "integer", "minimum": 0, "maximum": 2 },
          "symbol": { "type": "string", "pattern": "^Mapsprite[0-9]{3}_[012]$" },
          "sourcePath": { "type": "string" },
          "sourceAddress": { "type": "integer", "minimum": 0 },
          "compressedBytes": { "type": "integer", "minimum": 1 },
          "sentinel": { "type": "boolean" },
          "sourceSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
          "decodedBytes": { "const": 576 },
          "decodedSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
          "commandWordCount": { "type": "integer", "minimum": 1 },
          "literalWordCount": { "type": "integer", "minimum": 0 },
          "copyCommandCount": { "type": "integer", "minimum": 0 },
          "copiedWordCount": { "type": "integer", "minimum": 0 },
          "repeatLastWordCommandCount": { "type": "integer", "minimum": 0 },
          "maximumCopyOffsetWords": { "type": "integer", "minimum": 0 },
          "maximumCopyLengthWords": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "runtimeQuestions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
  }
}
