{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/battle-sprite-animation-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "function", "table", "constants", "summary", "selectorRules", "sides", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-battle-sprite-animation-static-v1" },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": { "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "function": { "type": "object", "minProperties": 2, "maxProperties": 2, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "table": { "type": "object", "minProperties": 4, "maxProperties": 4, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "constants": { "type": "object", "minProperties": 5, "maxProperties": 5, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "summary": { "$ref": "#/$defs/summary" },
    "selectorRules": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "string" } },
    "sides": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["side", "tableSymbol", "tableAddress", "summary", "animations"],
        "properties": {
          "side": { "enum": ["ally", "enemy"] }, "tableSymbol": { "type": "string" },
          "tableAddress": { "type": "integer", "minimum": 0 }, "summary": { "$ref": "#/$defs/sideSummary" },
          "animations": {
            "type": "array", "minItems": 87, "maxItems": 121,
            "items": { "$ref": "#/$defs/animation" }
          }
        }
      }
    },
    "runtimeQuestions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
  },
  "$defs": {
    "sideSummary": {
      "type": "object", "minProperties": 15, "maxProperties": 15,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "combinedSummary": {
      "type": "object", "minProperties": 10, "maxProperties": 10,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["combined", "ally", "enemy"],
      "properties": {
        "combined": { "$ref": "#/$defs/combinedSummary" },
        "ally": { "$ref": "#/$defs/sideSummary" },
        "enemy": { "$ref": "#/$defs/sideSummary" }
      }
    },
    "weapon": {
      "type": "object", "additionalProperties": false, "required": ["frame", "zIndex", "xOffset", "yOffset"],
      "properties": {
        "frame": { "type": "integer", "minimum": 0, "maximum": 255 },
        "zIndex": { "enum": [1, 2] }, "xOffset": { "type": "integer", "minimum": -128, "maximum": 127 },
        "yOffset": { "type": "integer", "minimum": -128, "maximum": 127 }
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["frameIndex", "battleSpriteFrame", "holdPreviousFrame", "displayFrames", "xOffset", "yOffset", "weapon"],
      "properties": {
        "frameIndex": { "type": "integer", "minimum": 0 },
        "battleSpriteFrame": { "type": "integer", "minimum": 0, "maximum": 15 },
        "holdPreviousFrame": { "type": "boolean" }, "displayFrames": { "type": "integer", "minimum": 1, "maximum": 255 },
        "xOffset": { "type": "integer", "minimum": -128, "maximum": 127 },
        "yOffset": { "type": "integer", "minimum": -128, "maximum": 127 },
        "weapon": { "oneOf": [{ "$ref": "#/$defs/weapon" }, { "type": "null" }] }
      }
    },
    "animation": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "symbol", "sourcePath", "sourceAddress", "byteCount", "frameCount", "spellTriggerFrame", "spellAnimation", "terminateSpellAnimation", "idleWeapon", "playedAttackFrameCount", "sha256", "frames"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 }, "symbol": { "type": "string" },
        "sourcePath": { "type": "string" }, "sourceAddress": { "type": "integer", "minimum": 0 },
        "byteCount": { "type": "integer", "minimum": 8 }, "frameCount": { "type": "integer", "minimum": 1 },
        "spellTriggerFrame": { "type": "integer", "minimum": 0, "maximum": 255 },
        "spellAnimation": { "type": ["integer", "null"], "minimum": 0, "maximum": 254 },
        "terminateSpellAnimation": { "type": "boolean" },
        "idleWeapon": { "oneOf": [{ "$ref": "#/$defs/weapon" }, { "type": "null" }] },
        "playedAttackFrameCount": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/frame" } }
      }
    }
  }
}
