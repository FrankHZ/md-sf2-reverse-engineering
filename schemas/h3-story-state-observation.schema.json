    "use291896": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "use"}, "h1Address": {"const": 291896}, "instructionTarget": {"const": null}, "effectiveTarget": {"const": null}}}]},
    "use291900": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "use"}, "h1Address": {"const": 291900}, "instructionTarget": {"const": null}, "effectiveTarget": {"const": null}}}]},
    "use291962": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "use"}, "h1Address": {"const": 291962}, "instructionTarget": {"const": null}, "effectiveTarget": {"const": null}}}]},
    "use291964": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "use"}, "h1Address": {"const": 291964}, "instructionTarget": {"const": null}, "effectiveTarget": {"const": null}}}]},
    "use292064": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "use"}, "h1Address": {"const": 292064}, "instructionTarget": {"const": null}, "effectiveTarget": {"const": null}}}]},
    "call291866": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "call"}, "h1Address": {"const": 291866}, "instructionTarget": {"const": "j_CheckFlag"}, "effectiveTarget": {"const": "CheckFlag"}}}]},
    "call291886": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "call"}, "h1Address": {"const": 291886}, "instructionTarget": {"const": "j_CheckFlag"}, "effectiveTarget": {"const": "CheckFlag"}}}]},
    "call291968": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "call"}, "h1Address": {"const": 291968}, "instructionTarget": {"const": "j_ClearFlag"}, "effectiveTarget": {"const": "ClearFlag"}}}]},
    "call291976": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "call"}, "h1Address": {"const": 291976}, "instructionTarget": {"const": "j_SetFlag"}, "effectiveTarget": {"const": "SetFlag"}}}]},
    "call291986": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "call"}, "h1Address": {"const": 291986}, "instructionTarget": {"const": "j_YesNoPrompt"}, "effectiveTarget": {"const": "YesNoPrompt"}}}]},
    "call292000": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "call"}, "h1Address": {"const": 292000}, "instructionTarget": {"const": "j_SetFlag"}, "effectiveTarget": {"const": "SetFlag"}}}]},
    "call292008": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "call"}, "h1Address": {"const": 292008}, "instructionTarget": {"const": "j_ClearFlag"}, "effectiveTarget": {"const": "ClearFlag"}}}]},
    "call292016": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "call"}, "h1Address": {"const": 292016}, "instructionTarget": {"const": "Sleep"}, "effectiveTarget": {"const": "Sleep"}}}]},
    "call292070": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "call"}, "h1Address": {"const": 292070}, "instructionTarget": {"const": "j_SetFlag"}, "effectiveTarget": {"const": "SetFlag"}}}]},
    "jumpSetZeroChronology": {"type": "array", "minItems": 3, "maxItems": 3, "items": [{"$ref": "#/$defs/use291864"}, {"$ref": "#/$defs/call291866"}, {"$ref": "#/$defs/use291880"}], "additionalItems": false},
    "jumpSetTargetChronology": {"type": "array", "minItems": 3, "maxItems": 3, "items": [{"$ref": "#/$defs/use291864"}, {"$ref": "#/$defs/call291866"}, {"$ref": "#/$defs/use291876"}], "additionalItems": false},
    "jumpClearTargetChronology": {"type": "array", "minItems": 3, "maxItems": 3, "items": [{"$ref": "#/$defs/use291884"}, {"$ref": "#/$defs/call291886"}, {"$ref": "#/$defs/use291896"}], "additionalItems": false},
    "jumpClearSkipChronology": {"type": "array", "minItems": 3, "maxItems": 3, "items": [{"$ref": "#/$defs/use291884"}, {"$ref": "#/$defs/call291886"}, {"$ref": "#/$defs/use291900"}], "additionalItems": false},
    "setFChronology": {"type": "array", "minItems": 3, "maxItems": 3, "items": [{"$ref": "#/$defs/use291962"}, {"$ref": "#/$defs/use291964"}, {"$ref": "#/$defs/call291976"}], "additionalItems": false},
    "clearFChronology": {"type": "array", "minItems": 3, "maxItems": 3, "items": [{"$ref": "#/$defs/use291962"}, {"$ref": "#/$defs/use291964"}, {"$ref": "#/$defs/call291968"}], "additionalItems": false},
    "yesNoSetChronology": {"type": "array", "minItems": 3, "maxItems": 3, "items": [{"$ref": "#/$defs/call291986"}, {"$ref": "#/$defs/call292000"}, {"$ref": "#/$defs/call292016"}], "additionalItems": false},
    "yesNoClearChronology": {"type": "array", "minItems": 3, "maxItems": 3, "items": [{"$ref": "#/$defs/call291986"}, {"$ref": "#/$defs/call292008"}, {"$ref": "#/$defs/call292016"}], "additionalItems": false},
    "storyBaseChronology": {"type": "array", "minItems": 2, "maxItems": 2, "items": [{"$ref": "#/$defs/use292064"}, {"$ref": "#/$defs/call292070"}], "additionalItems": false},
    "recordJumpSetZero": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "jump-if-flag-set-zero-skip"}, "handlerAddress": {"const": 291864}, "chronology": {"$ref": "#/$defs/jumpSetZeroChronology"}}}]},
    "recordJumpSetTarget": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "jump-if-flag-set-nonzero-target"}, "handlerAddress": {"const": 291864}, "chronology": {"$ref": "#/$defs/jumpSetTargetChronology"}}}]},
    "recordJumpClearTarget": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "jump-if-flag-clear-zero-target"}, "handlerAddress": {"const": 291884}, "chronology": {"$ref": "#/$defs/jumpClearTargetChronology"}}}]},
    "recordJumpClearSkip": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "jump-if-flag-clear-nonzero-skip"}, "handlerAddress": {"const": 291884}, "chronology": {"$ref": "#/$defs/jumpClearSkipChronology"}}}]},
    "recordSetF": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "set-f-nonzero-selector"}, "handlerAddress": {"const": 291962}, "chronology": {"$ref": "#/$defs/setFChronology"}}}]},
    "recordClearF": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "clear-f-zero-selector"}, "handlerAddress": {"const": 291962}, "chronology": {"$ref": "#/$defs/clearFChronology"}}}]},
    "recordYesNoSet": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "yes-no-zero-set"}, "handlerAddress": {"const": 291984}, "chronology": {"$ref": "#/$defs/yesNoSetChronology"}}}]},
    "recordYesNoClear": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "yes-no-nonzero-clear"}, "handlerAddress": {"const": 291984}, "chronology": {"$ref": "#/$defs/yesNoClearChronology"}}}]},
    "recordStoryBase": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "set-story-flag-base"}, "handlerAddress": {"const": 292064}, "chronology": {"$ref": "#/$defs/storyBaseChronology"}}}]},
    "recordStoryWrap": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"id": {"const": "set-story-flag-word-wrap-boundary"}, "handlerAddress": {"const": 292064}, "chronology": {"$ref": "#/$defs/storyBaseChronology"}}}]},
    "records": {"type": "array", "minItems": 10, "maxItems": 10, "items": [{"$ref": "#/$defs/recordJumpSetZero"}, {"$ref": "#/$defs/recordJumpSetTarget"}, {"$ref": "#/$defs/recordJumpClearTarget"}, {"$ref": "#/$defs/recordJumpClearSkip"}, {"$ref": "#/$defs/recordSetF"}, {"$ref": "#/$defs/recordClearF"}, {"$ref": "#/$defs/recordYesNoSet"}, {"$ref": "#/$defs/recordYesNoClear"}, {"$ref": "#/$defs/recordStoryBase"}, {"$ref": "#/$defs/recordStoryWrap"}], "additionalItems": false}
  }
}
