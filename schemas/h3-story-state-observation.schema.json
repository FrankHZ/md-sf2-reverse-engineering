{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "core", "id", "mapTest", "records"],
  "properties": {
    "system": {"const": "GEN"},
    "core": {"const": "Genesis Plus GX"},
    "id": {"const": "sf2-story-state-runtime-v1"},
    "mapTest": {"const": 0},
    "records": {"$ref": "#/$defs/records"}
  },
  "$defs": {
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "handlerAddress", "a6Output", "flagByteAfter", "finalFlagSet", "chronology"],
      "properties": {
        "id": {"type": "string"}, "handlerAddress": {"type": "integer", "minimum": 0},
        "a6Output": {"type": "integer", "minimum": 0}, "flagByteAfter": {"type": "integer", "minimum": 0, "maximum": 255},
        "finalFlagSet": {"type": "boolean"}, "chronology": {"type": "array"}
      }
    },
    "chronologyRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "h1Address", "instructionTarget", "effectiveTarget", "d0Word", "d1Word", "a6"],
      "properties": {
        "kind": {"enum": ["use", "call"]}, "h1Address": {"type": "integer", "minimum": 0},
        "instructionTarget": {"type": ["string", "null"]}, "effectiveTarget": {"type": ["string", "null"]},
        "d0Word": {"type": "integer", "minimum": 0, "maximum": 65535}, "d1Word": {"type": "integer", "minimum": 0, "maximum": 65535},
        "a6": {"type": "integer", "minimum": 0}
      }
    },
    "use291864": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "use"}, "h1Address": {"const": 291864}, "instructionTarget": {"const": null}, "effectiveTarget": {"const": null}}}]},
    "use291876": {"allOf": [{"$ref": "#/$defs/chronologyRecord"}, {"properties": {"kind": {"const": "use"}, "h1Address": {"const": 291876}, "instructionTarget": {"const": null}, "effectiveTarget": {"const": null}}}]},
