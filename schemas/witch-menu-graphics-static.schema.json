{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/witch-menu-graphics-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "table", "summary", "resources", "pointers", "paletteFacts", "animationFacts", "frames", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "sf2-witch-menu-graphics-static-v1" },
    "upstream": { "type": "object", "additionalProperties": false, "required": ["repository", "commit"], "properties": { "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" } } },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "table": { "type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "summary": { "type": "object", "minProperties": 24, "maxProperties": 24, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "resources": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "object", "additionalProperties": false, "required": ["symbol", "sourcePath", "ownerPath", "address", "byteCount", "sha256"], "properties": { "symbol": { "type": "string" }, "sourcePath": { "type": "string" }, "ownerPath": { "type": "string" }, "address": { "type": "integer", "minimum": 0 }, "byteCount": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" } } }
    },
    "pointers": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "object", "additionalProperties": false, "required": ["symbol", "address", "targetSymbol", "targetAddress", "sha256"], "properties": { "symbol": { "type": "string" }, "address": { "type": "integer", "minimum": 0 }, "targetSymbol": { "type": "string" }, "targetAddress": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" } } }
    },
    "paletteFacts": { "type": "object", "minProperties": 7, "maxProperties": 7 },
    "animationFacts": { "type": "object", "minProperties": 10, "maxProperties": 10 },
    "frames": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": { "type": "object", "additionalProperties": false, "required": ["optionIndex", "frameIndex", "sourceOffset", "byteCount", "wordCount", "sha256"], "properties": { "optionIndex": { "type": "integer", "minimum": 0, "maximum": 3 }, "frameIndex": { "type": "integer", "minimum": 0, "maximum": 2 }, "sourceOffset": { "type": "integer", "minimum": 0 }, "byteCount": { "const": 80 }, "wordCount": { "const": 40 }, "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" } } }
    },
    "runtimeQuestions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
  }
}
