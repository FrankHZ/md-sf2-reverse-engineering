    "trailingBitHistogram": { "type": "object", "minProperties": 8, "maxProperties": 8, "additionalProperties": { "type": "integer", "minimum": 1 } },
    "controlSymbolHistogram": { "type": "object", "minProperties": 17, "maxProperties": 17, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "decodedSymbolHistogram": { "type": "object", "minProperties": 86, "maxProperties": 86, "additionalProperties": { "type": "integer", "minimum": 1 } },
    "banks": { "type": "array", "minItems": 17, "maxItems": 17, "items": { "type": "object", "minProperties": 12, "maxProperties": 12 } },
    "copyrightBoundary": { "type": "object", "minProperties": 3, "maxProperties": 3 },
