{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/md-sf2/schemas/h3-spell-damage-resistance-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "romSha256", "emulator", "battleId", "observationBoundary", "function", "ram", "harness", "case", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-spell-damage-resistance-v1" },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "emulator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "core"],
      "properties": { "name": { "const": "BizHawk" }, "version": { "const": "2.11.1" }, "core": { "const": "Genesis Plus GX" } }
    },
    "battleId": { "const": 1 },
    "observationBoundary": { "type": "string", "minLength": 1 },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["writeBattleSceneScriptAddress", "initializePropertiesAddress", "getResistanceAddress", "calculateSpellDamageAddress", "adjustedPowerAddress", "postResistanceAddress", "preVarianceAddress", "varianceFirstRollAddress", "varianceSecondRollAddress", "damageAppliedAddress", "battleSceneEndReturnAddress"],
      "properties": {
        "writeBattleSceneScriptAddress": { "const": 39826 }, "initializePropertiesAddress": { "const": 40744 },
        "getResistanceAddress": { "const": 49706 }, "calculateSpellDamageAddress": { "const": 47874 },
        "adjustedPowerAddress": { "const": 47894 }, "postResistanceAddress": { "const": 47922 },
        "preVarianceAddress": { "const": 47942 }, "varianceFirstRollAddress": { "const": 44362 },
        "varianceSecondRollAddress": { "const": 44370 }, "damageAppliedAddress": { "const": 44434 },
        "battleSceneEndReturnAddress": { "const": 40398 }
      }
    },
    "ram": {
      "type": "object", "additionalProperties": false,
      "required": ["combatantDataAddress", "combatantEntrySize", "currentBattleActionAddress", "battleSceneSpellIndexAddress", "targetsListLengthAddress", "targetsListAddress", "seedAddress"],
      "properties": {
        "combatantDataAddress": { "const": 16771072 }, "combatantEntrySize": { "const": 56 },
        "currentBattleActionAddress": { "const": 16758318 }, "battleSceneSpellIndexAddress": { "const": 16758328 },
        "targetsListLengthAddress": { "const": 16758334 }, "targetsListAddress": { "const": 16758354 },
        "seedAddress": { "const": 16768676 }
      }
    },
    "harness": {
      "type": "object", "additionalProperties": false, "required": ["function", "ram"],
      "properties": {
        "function": {
          "type": "object", "additionalProperties": false,
          "required": ["battleTestAddress", "numberPromptAddress", "flagPromptAddress", "turnOrderEntryAddress"],
          "properties": { "battleTestAddress": { "const": 30364 }, "numberPromptAddress": { "const": 90754 }, "flagPromptAddress": { "const": 91068 }, "turnOrderEntryAddress": { "const": 152900 } }
        },
        "ram": {
          "type": "object", "additionalProperties": false,
          "required": ["currentBattleAddress", "terrainDataAddress", "cheatPointerAddress", "debugModeAddress"],
          "properties": { "currentBattleAddress": { "const": 16774930 }, "terrainDataAddress": { "const": 16736000 }, "cheatPointerAddress": { "const": 16757152 }, "debugModeAddress": { "const": 16756905 } }
        }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "actor", "actorClass", "initialMp", "actionType", "actionSpell", "baseSpell", "spellPower", "spellMpCost", "criticalRange", "seed", "targets"],
      "properties": {
        "id": { "const": "bowie-blaze2-four-fire-resistance-settings" }, "actor": { "const": 0 },
        "actorClass": { "const": 0 }, "initialMp": { "const": 20 }, "actionType": { "const": 1 },
        "actionSpell": { "const": 75 }, "baseSpell": { "const": 11 }, "spellPower": { "const": 10 },
        "spellMpCost": { "const": 6 }, "criticalRange": { "const": 32 }, "seed": { "const": 4660 },
        "targets": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/definitions/target" } }
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["resistanceCalls", "actorMpAfterConstruction", "records"],
      "properties": {
        "resistanceCalls": { "const": 4 }, "actorMpAfterConstruction": { "const": 20 },
        "records": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/definitions/record" } }
      }
    }
  },
  "definitions": {
    "target": {
      "type": "object", "additionalProperties": false, "required": ["combatant", "resistanceWord", "setting"],
      "properties": { "combatant": { "type": "integer", "minimum": 128, "maximum": 159 }, "resistanceWord": { "type": "integer", "minimum": 0, "maximum": 65535 }, "setting": { "type": "integer", "minimum": 0, "maximum": 3 } }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["combatant", "setting", "adjustedPower", "quarterPower", "postResistance", "criticalRoll", "preVariance", "varianceRange", "varianceRolls", "finalDamage", "temporaryHp", "restoredHp"],
      "properties": {
        "combatant": { "type": "integer" }, "setting": { "type": "integer" }, "adjustedPower": { "type": "integer" },
        "quarterPower": { "type": "integer" }, "postResistance": { "type": "integer" }, "criticalRoll": { "type": "integer" },
        "preVariance": { "type": "integer" }, "varianceRange": { "type": "integer" },
        "varianceRolls": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
        "finalDamage": { "type": "integer" }, "temporaryHp": { "type": "integer" }, "restoredHp": { "type": "integer" }
      }
    }
  }
}
