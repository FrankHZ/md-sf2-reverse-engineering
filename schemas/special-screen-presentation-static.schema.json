{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/special-screen-presentation-static.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "table", "summary", "resources", "titleLayoutFacts", "copyrightBoundary", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "sf2-special-screen-presentation-static-v1" },
    "upstream": { "type": "object", "additionalProperties": false, "required": ["repository", "commit"], "properties": { "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" } } },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "table": { "type": "object", "minProperties": 12, "maxProperties": 12, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "summary": { "type": "object", "minProperties": 15, "maxProperties": 15, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "resources": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["symbol", "kind", "sourcePath", "ownerPath", "address", "byteCount", "wordCount", "uniqueWordCount", "sha256"], "properties": { "symbol": { "type": "string" }, "kind": { "enum": ["palette", "layout"] }, "sourcePath": { "type": "string" }, "ownerPath": { "type": "string" }, "address": { "type": "integer", "minimum": 0 }, "byteCount": { "type": "integer", "minimum": 2 }, "wordCount": { "type": "integer", "minimum": 1 }, "uniqueWordCount": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" } } } },
    "titleLayoutFacts": { "type": "object", "minProperties": 5, "maxProperties": 5 },
    "copyrightBoundary": { "type": "object", "minProperties": 3, "maxProperties": 3 },
    "runtimeQuestions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
  }
}
