{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/battle-effect-graphics-decode.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "romSha256", "function", "table", "summary", "spellGraphics", "invocationContainers", "invocationStreams", "statusAnimation", "transitionGraphics", "runtimeQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-battle-effect-graphics-decode-v1" },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": { "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "romSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "function": { "type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "table": { "type": "object", "minProperties": 8, "maxProperties": 8, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "summary": { "type": "object", "minProperties": 22, "maxProperties": 22, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "spellGraphics": { "type": "array", "minItems": 23, "maxItems": 23, "items": { "$ref": "#/$defs/stream" } },
    "invocationContainers": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "symbol", "sourcePath", "sourceAddress", "containerBytes", "frameCount", "streamCount", "paletteOffset", "paletteSha256"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 }, "symbol": { "type": "string" },
          "sourcePath": { "type": "string" }, "sourceAddress": { "type": "integer", "minimum": 0 },
          "containerBytes": { "type": "integer", "minimum": 1 }, "frameCount": { "type": "integer", "minimum": 1 },
          "streamCount": { "type": "integer", "minimum": 2 }, "paletteOffset": { "type": "integer", "minimum": 8 },
          "paletteSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
        }
      }
    },
    "invocationStreams": { "type": "array", "minItems": 30, "maxItems": 30, "items": { "$ref": "#/$defs/stream" } },
    "statusAnimation": { "$ref": "#/$defs/stream" },
    "transitionGraphics": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/stream" } },
    "runtimeQuestions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
  },
  "$defs": {
    "stream": {
      "type": "object",
      "required": ["compressedBytes", "decodedBytes", "sourceSha256", "decodedSha256", "inputBitsConsumed", "trailingBits", "commandGroupCount", "literalWordCount", "copyCommandCount", "copiedWordCount", "maximumCopyOffsetWords", "maximumCopyLengthWords"],
      "properties": {
        "compressedBytes": { "type": "integer", "minimum": 1 }, "decodedBytes": { "type": "integer", "minimum": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }, "decodedSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "inputBitsConsumed": { "type": "integer", "minimum": 1 }, "trailingBits": { "type": "integer", "minimum": 0 },
        "commandGroupCount": { "type": "integer", "minimum": 1 }, "literalWordCount": { "type": "integer", "minimum": 0 },
        "copyCommandCount": { "type": "integer", "minimum": 0 }, "copiedWordCount": { "type": "integer", "minimum": 0 },
        "maximumCopyOffsetWords": { "type": "integer", "minimum": 0 }, "maximumCopyLengthWords": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
