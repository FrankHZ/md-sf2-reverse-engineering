{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sf2/map-content-static.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "upstream",
    "romSha256",
    "sources",
    "table",
    "summary",
    "sectionCounts",
    "recordCounts",
    "sourceFacts",
    "mapEntries",
    "sourceSections",
    "binaryPayloads",
    "runtimeQuestions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "sf2-map-content-static-v1" },
    "upstream": { "$ref": "#/$defs/upstream" },
    "romSha256": { "$ref": "#/$defs/sha256" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "macros", "enums", "mapLoader", "animations", "exploration", "entityScript", "baseVIntFunctions", "vIntEngine"],
      "properties": {
        "entries": { "type": "string" },
        "macros": { "type": "string" },
        "enums": { "type": "string" },
        "mapLoader": { "type": "string" },
        "animations": { "type": "string" },
        "exploration": { "type": "string" },
        "entityScript": { "type": "string" },
        "baseVIntFunctions": { "type": "string" },
        "vIntEngine": { "type": "string" }
      }
    },
    "table": { "$ref": "#/$defs/integerMap" },
    "summary": { "$ref": "#/$defs/integerMap" },
    "sectionCounts": { "$ref": "#/$defs/integerMap" },
    "recordCounts": { "$ref": "#/$defs/integerMap" },
    "sourceFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryBytes",
        "tilesetBytes",
        "pointerLayout",
        "recordBytes",
        "flagEventsAppliedDuringLayoutLoad",
        "layoutConstructionOrder",
        "flagEventScanPolicy",
        "flagEventOverlapPolicy",
        "loadMapLayoutPolicyByPath",
        "currentMapReloadSkipsBlockAndLayoutDecode",
        "explicitResetWorkingLayoutBytes",
        "roofOnLoadScanPolicy",
        "stepEventScanPolicy",
        "warpEventScanPolicy",
        "warpNegativeCoordinateByteIsWildcard",
        "eventConsumerPhases",
        "controlledMovementTargetCheckOrder",
        "movementMarkerMask",
        "movementMarkerValues",
        "movementMarkersMutuallyExclusiveBeforeDoorMutation",
        "areaSelectionSkipsRemaining22Bytes",
        "animationRunsFromVInt",
        "animationHeaderFields",
        "animationEntryFields",
        "animationInitialCounter",
        "animationCachedBytesPerTile",
        "animationDmaLengthWordsPerTile",
        "animationCounterPolicy",
        "animationTerminatorPolicy",
        "baseVIntCallbackOrder",
        "animationDmaQueuedAfterCurrentVIntDmaPass",
        "animationDmaEarliestProcessing",
        "declaredLayoutOffset",
        "actualLayoutPointerOffset",
        "declaredLayoutOffsetReferenceCount"
      ],
      "properties": {
        "entryBytes": { "type": "integer", "minimum": 0 },
        "tilesetBytes": { "type": "integer", "minimum": 0 },
        "pointerLayout": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "offset"],
            "properties": {
              "name": { "type": "string" },
              "offset": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "recordBytes": { "$ref": "#/$defs/integerMap" },
        "flagEventsAppliedDuringLayoutLoad": { "type": "boolean" },
        "layoutConstructionOrder": { "type": "array", "items": { "type": "string" } },
        "flagEventScanPolicy": { "type": "string" },
        "flagEventOverlapPolicy": { "type": "string" },
        "loadMapLayoutPolicyByPath": { "type": "object", "additionalProperties": { "type": "string" } },
        "currentMapReloadSkipsBlockAndLayoutDecode": { "type": "boolean" },
        "explicitResetWorkingLayoutBytes": { "type": "integer", "minimum": 0 },
        "roofOnLoadScanPolicy": { "type": "string" },
        "stepEventScanPolicy": { "type": "string" },
        "warpEventScanPolicy": { "type": "string" },
        "warpNegativeCoordinateByteIsWildcard": { "type": "boolean" },
        "eventConsumerPhases": { "type": "object", "additionalProperties": { "type": "string" } },
        "controlledMovementTargetCheckOrder": { "type": "array", "items": { "type": "string" } },
        "movementMarkerMask": { "type": "integer", "minimum": 0 },
        "movementMarkerValues": { "$ref": "#/$defs/integerMap" },
        "movementMarkersMutuallyExclusiveBeforeDoorMutation": { "type": "boolean" },
        "areaSelectionSkipsRemaining22Bytes": { "type": "boolean" },
        "animationRunsFromVInt": { "type": "boolean" },
        "animationHeaderFields": { "type": "array", "items": { "type": "string" } },
        "animationEntryFields": { "type": "array", "items": { "type": "string" } },
        "animationInitialCounter": { "type": "integer", "minimum": 0 },
        "animationCachedBytesPerTile": { "type": "integer", "minimum": 0 },
        "animationDmaLengthWordsPerTile": { "type": "integer", "minimum": 0 },
        "animationCounterPolicy": { "type": "string" },
        "animationTerminatorPolicy": { "type": "string" },
        "baseVIntCallbackOrder": { "type": "array", "items": { "type": "string" } },
        "animationDmaQueuedAfterCurrentVIntDmaPass": { "type": "boolean" },
        "animationDmaEarliestProcessing": { "type": "string" },
        "declaredLayoutOffset": { "type": "integer", "minimum": 0 },
        "actualLayoutPointerOffset": { "type": "integer", "minimum": 0 },
        "declaredLayoutOffsetReferenceCount": { "type": "integer", "minimum": 0 }
      }
    },
    "mapEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["map", "symbol", "address", "tilesets", "pointers"],
        "properties": {
          "map": { "type": "integer", "minimum": 0 },
          "symbol": { "type": "string" },
          "address": { "type": "integer", "minimum": 0 },
          "tilesets": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "pointers": {
            "type": "object",
            "minProperties": 10,
            "maxProperties": 10,
            "additionalProperties": { "$ref": "#/$defs/pointer" }
          }
        }
      }
    },
    "sourceSections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "map",
          "kind",
          "path",
          "symbol",
          "address",
          "byteCount",
          "recordCount",
          "trailingRts",
          "romParity"
        ],
        "properties": {
          "map": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "symbol": { "type": "string" },
          "address": { "type": "integer", "minimum": 0 },
          "byteCount": { "type": "integer", "minimum": 0 },
          "recordCount": { "type": "integer", "minimum": 0 },
          "trailingRts": { "type": "boolean" },
          "romParity": { "type": "boolean" }
        }
      }
    },
    "binaryPayloads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["map", "kind", "path", "symbol", "address", "byteCount", "sha256", "romParity"],
        "properties": {
          "map": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["blocks", "layout"] },
          "path": { "type": "string" },
          "symbol": { "type": "string" },
          "address": { "type": "integer", "minimum": 0 },
          "byteCount": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "romParity": { "type": "boolean" }
        }
      }
    },
    "runtimeQuestions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "integerMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "address"],
      "properties": {
        "symbol": { "type": ["string", "null"] },
        "address": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
